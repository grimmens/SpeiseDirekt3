@page "/Account/AccessDenied"
@inject IStringLocalizer<AccountText> T
@inject IStringLocalizer<CommonText> C
@attribute [AuthPage]
@layout AuthLayout

<PageTitle>@C["PageTitle", T["AccessDenied_Title"]]</PageTitle>

<AuthCard Title="@T["AccessDenied_Title"]" Icon="lock" Tone="danger">
    <ChildContent>
        <p class="au-text" role="alert">@T["AccessDenied_Text"]</p>
        <div class="au-actions">
            <a class="au-button au-button--primary" href="/dashboard" data-testid="access-denied-dashboard">@T["Auth_ToDashboard"]</a>
        </div>
    </ChildContent>
</AuthCard>
