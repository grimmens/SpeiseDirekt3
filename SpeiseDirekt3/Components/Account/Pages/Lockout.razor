@page "/Account/Lockout"
@inject IStringLocalizer<AccountText> T
@inject IStringLocalizer<CommonText> C
@attribute [AuthPage]
@layout AuthLayout

<PageTitle>@C["PageTitle", T["Lockout_Title"]]</PageTitle>

<AuthCard Title="@T["Lockout_Title"]" Icon="alert" Tone="danger">
    <ChildContent>
        <p class="au-text" role="alert">@T["Lockout_Text"]</p>
    </ChildContent>
    <Links>
        <li><a href="/Account/ForgotPassword" class="au-link">@T["Login_ForgotPassword"]</a></li>
    </Links>
</AuthCard>
