@page "/Account/ForgotPasswordConfirmation"
@inject IStringLocalizer<AccountText> T
@inject IStringLocalizer<CommonText> C
@attribute [AuthPage]
@layout AuthLayout

<PageTitle>@C["PageTitle", T["ForgotConfirm_Title"]]</PageTitle>

<AuthCard Title="@T["ForgotConfirm_Title"]" Icon="mail" Tone="success">
    <ChildContent>
        <p class="au-text" role="status">@T["ForgotConfirm_Text"]</p>
    </ChildContent>
    <Links>
        <li><a href="/Account/Login" class="au-link">@T["Forgot_BackToLogin"]</a></li>
    </Links>
</AuthCard>
