@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor
@inject IStringLocalizer<AccountText> T
@inject IStringLocalizer<CommonText> C

<PageTitle>@T["PersonalData_Title"]</PageTitle>

<StatusMessage />
<h3>@T["PersonalData_Title"]</h3>

<div class="row">
    <div class="col-md-6">
        <p>@T["PersonalData_Text"]</p>
        <p>
            <strong>@T["PersonalData_DeleteWarning"]</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">@T["PersonalData_Download"]</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">@C["Delete"]</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
