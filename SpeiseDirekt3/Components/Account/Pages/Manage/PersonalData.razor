@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor
@inject IStringLocalizer<AccountText> T
@inject IStringLocalizer<CommonText> C

<PageTitle>@C["PageTitle", T["PersonalData_Title"]]</PageTitle>

<ManageHeader Title="@T["PersonalData_Title"]" Description="@T["PersonalData_Text"]" />
<div class="sd-manage-body">
    <StatusMessage />
    <div class="sd-notice sd-notice--warning">
        <p><strong>@T["PersonalData_DeleteWarning"]</strong></p>
    </div>
    <div class="sd-actions">
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="sd-btn sd-btn--secondary" type="submit">@T["PersonalData_Download"]</button>
        </form>
        <a href="Account/Manage/DeletePersonalData" class="sd-btn sd-btn--danger">@C["Delete"]</a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
