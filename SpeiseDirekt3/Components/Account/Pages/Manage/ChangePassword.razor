@page "/Account/Manage/ChangePassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using SpeiseDirekt.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger
@inject IStringLocalizer<AccountText> T
@inject IStringLocalizer<CommonText> C

<PageTitle>@C["PageTitle", T["ChangePassword_Title"]]</PageTitle>

<!-- Change Password -->
<div class="space-y-6">
    <!-- Header -->
    <div class="border-b border-gray-200 pb-6">
        <h3 class="text-2xl font-bold text-gray-900 font-display">@T["ChangePassword_Title"]</h3>
        <p class="mt-2 text-gray-600">@T["ChangePassword_Subtitle"]</p>
    </div>

    <!-- Status Message -->
    <StatusMessage Message="@message" IsError="true" />

    <!-- Password Change Form -->
    <div class="bg-gray-50 rounded-xl p-6">
        <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post" class="space-y-6">
            <DataAnnotationsValidator />
            <ValidationSummary class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm" role="alert" />

            <!-- Current Password -->
            <div>
                <label for="Input.OldPassword" class="block text-sm font-medium text-gray-700 mb-2">@T["Field_CurrentPassword"]</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                        </svg>
                    </div>
                    <InputText type="password" @bind-Value="Input.OldPassword" id="Input.OldPassword"
                               class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors duration-200"
                               autocomplete="current-password" aria-required="true" placeholder="@T["Placeholder_CurrentPassword"]" />
                </div>
                <ValidationMessage For="() => Input.OldPassword" class="mt-1 text-sm text-red-600" />
            </div>

            <!-- New Password -->
            <div>
                <label for="Input.NewPassword" class="block text-sm font-medium text-gray-700 mb-2">@T["Field_NewPassword"]</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                        </svg>
                    </div>
                    <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword"
                               class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors duration-200"
                               autocomplete="new-password" aria-required="true" placeholder="@T["Placeholder_NewPassword"]" aria-describedby="password-rules" />
                </div>
                <ValidationMessage For="() => Input.NewPassword" class="mt-1 text-sm text-red-600" />
                <p class="mt-1 text-xs text-gray-500" id="password-rules">@T["PasswordRules"]</p>
            </div>

            <!-- Confirm New Password -->
            <div>
                <label for="Input.ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-2">@T["Field_ConfirmNewPassword"]</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword"
                               class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors duration-200"
                               autocomplete="new-password" aria-required="true" placeholder="@T["Placeholder_RepeatNewPassword"]" />
                </div>
                <ValidationMessage For="() => Input.ConfirmPassword" class="mt-1 text-sm text-red-600" />
            </div>

            <!-- Update Button -->
            <div class="flex justify-end pt-4">
                <button type="submit"
                        class="inline-flex items-center px-6 py-3 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-brand-600 hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500 transition-colors duration-200">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                    @T["ChangePassword_Submit"]
                </button>
            </div>
        </EditForm>
    </div>

    <!-- Security Tips -->
    <div class="bg-yellow-50 rounded-xl p-6">
        <div class="flex items-start">
            <div class="flex-shrink-0">
                <svg class="h-6 w-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                </svg>
            </div>
            <div class="ml-3">
                <h3 class="text-sm font-medium text-yellow-900">@T["ChangePassword_TipsTitle"]</h3>
                <div class="mt-2 text-sm text-yellow-800">
                    <ul class="list-disc list-inside space-y-1">
                        <li>@T["ChangePassword_Tip1"]</li>
                        <li>@T["ChangePassword_Tip2"]</li>
                        <li>@T["ChangePassword_Tip3"]</li>
                        <li>@T["ChangePassword_Tip4"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? message;
    private ApplicationUser user = default!;
    private bool hasPassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        hasPassword = await UserManager.HasPasswordAsync(user);
        if (!hasPassword)
        {
            RedirectManager.RedirectTo("Account/Manage/SetPassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        var changePasswordResult = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!changePasswordResult.Succeeded)
        {
            message = string.Join(" ", changePasswordResult.Errors.Select(error => error.Description));
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("User changed their password successfully.");

        RedirectManager.RedirectToCurrentPageWithStatus(T["Status_PasswordChanged"], HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(AccountText), ErrorMessageResourceName = nameof(AccountText.Valid_CurrentPasswordRequired))]
        [DataType(DataType.Password)]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessageResourceType = typeof(AccountText), ErrorMessageResourceName = nameof(AccountText.Valid_NewPasswordRequired))]
        [StringLength(100, MinimumLength = 6, ErrorMessageResourceType = typeof(AccountText), ErrorMessageResourceName = nameof(AccountText.Valid_PasswordLength))]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("NewPassword", ErrorMessageResourceType = typeof(AccountText), ErrorMessageResourceName = nameof(AccountText.Valid_NewPasswordsDoNotMatch))]
        public string ConfirmPassword { get; set; } = "";
    }
}
