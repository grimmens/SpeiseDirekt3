@page "/Account/ResetPasswordConfirmation"
@inject IStringLocalizer<AccountText> T
@inject IStringLocalizer<CommonText> C
@attribute [AuthPage]
@layout AuthLayout

<PageTitle>@C["PageTitle", T["ResetConfirm_Title"]]</PageTitle>

<AuthCard Title="@T["ResetConfirm_Title"]" Icon="check" Tone="success">
    <ChildContent>
        <p class="au-text" role="status">@T["ResetConfirm_Text"]</p>
        <div class="au-actions">
            <a class="au-button au-button--primary" href="/Account/Login">@T["ResetConfirm_Login"]</a>
        </div>
    </ChildContent>
</AuthCard>
