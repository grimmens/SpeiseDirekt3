@page "/Account/InvalidPasswordReset"
@inject IStringLocalizer<AccountText> T
@inject IStringLocalizer<CommonText> C
@attribute [AuthPage]
@layout AuthLayout

<PageTitle>@C["PageTitle", T["InvalidReset_Title"]]</PageTitle>

<AuthCard Title="@T["InvalidReset_Title"]" Icon="alert" Tone="danger">
    <ChildContent>
        <p class="au-text" role="alert">@T["InvalidReset_Text"]</p>
        <div class="au-actions">
            <a class="au-button au-button--primary" href="/Account/ForgotPassword">@T["Login_ForgotPassword"]</a>
        </div>
    </ChildContent>
</AuthCard>
