@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using SpeiseDirekt.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<AccountText> T

@* The external login providers (Google, …) inside the login and registration cards (css/auth.css): a divider with
   Heading, one button per provider. Renders nothing while no provider is configured (today: none) — the scaffold's
   developer note about setting up providers is not for visitors. *@
@if (externalLogins.Length > 0)
{
    <div data-testid="external-logins">
        <p class="au-divider">@Heading</p>
        <form action="/Account/PerformExternalLogin" method="post" class="au-form">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            @foreach (var provider in externalLogins)
            {
                <button type="submit" class="au-button au-button--secondary" name="provider" value="@provider.Name" title="@T["External_ButtonTitle", provider.DisplayName ?? provider.Name]">@provider.DisplayName</button>
            }
        </form>
    </div>
}

@code {
    private AuthenticationScheme[] externalLogins = [];

    /// <summary>The card's heading ("Or continue with" / "Or register with").</summary>
    [Parameter, EditorRequired] public string Heading { get; set; } = "";

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
    }
}
