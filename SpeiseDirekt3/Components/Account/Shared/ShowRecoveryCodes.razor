@inject IStringLocalizer<AccountText> T
<ManageHeader Title="@T["RecoveryCodes_Heading"]" />
<div class="sd-manage-body">
    <StatusMessage Message="@StatusMessage" />
    <div class="sd-notice sd-notice--warning" role="alert">
        <p><strong>@T["RecoveryCodes_SafePlace"]</strong></p>
        <p>@T["RecoveryCodes_Warning"]</p>
    </div>
    <ul class="sd-codes" data-testid="recovery-codes">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <li><code class="recovery-code">@recoveryCode</code></li>
        }
    </ul>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
