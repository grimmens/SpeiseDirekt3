@inherits LayoutComponentBase
@layout SpeiseDirekt3.Components.Layout.MainLayout
@inject IStringLocalizer<AccountText> T

@* Account settings (Account/Manage): the back office's page header, the section navigation and the page in a card.
   The pages bring their own h2 (ManageHeader). *@
<PageHeader Title="@T["Manage_Heading"]" Icon="PageIcons.Account" Class="mb-6">
    <Description>@T["Manage_Subtitle"]</Description>
</PageHeader>

<!-- Content Section -->
<div class="lg:grid lg:grid-cols-12 lg:gap-8">
    <!-- Navigation Sidebar -->
    <div class="lg:col-span-3">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="p-[1rem] sm:p-6 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-900 m-0">@T["Manage_NavHeading"]</h2>
                <p class="mt-1 text-sm text-gray-600">@T["Manage_NavSubtitle"]</p>
            </div>
            <div class="p-2">
                <ManageNavMenu />
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="lg:col-span-9 mt-8 lg:mt-0">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200">
            <div class="p-[1rem] sm:p-6">
                @Body
            </div>
        </div>
    </div>
</div>
