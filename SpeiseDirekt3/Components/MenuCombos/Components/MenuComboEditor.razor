@using Microsoft.EntityFrameworkCore
@using SpeiseDirekt.Infrastructure
@using SpeiseDirekt.Model
@using SpeiseDirekt3.Components.Shared
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IStringLocalizer<CombosText> T
@inject IStringLocalizer<CommonText> C

@* The combo editor: a quiet side panel (native <dialog>, js/modal-dialog.js) — from the right from 1024 px, a bottom
   sheet on phones, centred in between. White, neutral title, no dark band. Escape, the backdrop, "×" and "Cancel"
   close it without saving (the page then drops the unsaved values, MenuCombosPage.HandleCancel). *@
<dialog @ref="dialog" class="sd-dialog sd-dialog--panel" aria-labelledby="combo-editor-title" data-testid="combo-editor">
    @if (isVisible)
    {
        <EditForm EditContext="editContext" OnSubmit="OnSubmit" class="sd-dialog-form">
            <DataAnnotationsValidator />
            <div class="sd-dialog-head">
                <div class="flex items-start gap-3 min-w-0">
                    <span class="sd-tile sd-tile--sm sd-tile--accent" aria-hidden="true">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="@PageIcons.Combos.Path" /></svg>
                    </span>
                    <div class="min-w-0">
                        <h2 id="combo-editor-title" class="sd-dialog-title">@(Input.Id == Guid.Empty ? T["Editor_TitleNew"] : T["Editor_TitleEdit"])</h2>
                        <p class="m-0 mt-0.5 text-sm text-gray-600">@T["Editor_Intro"]</p>
                    </div>
                </div>
                <button type="button" class="sd-row-action sd-dialog-close" aria-label="@C["Close"]" @onclick="Cancel">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="sd-dialog-body space-y-5 text-gray-900">
                <!-- Name -->
                <div>
                    <label for="ComboName" class="block text-sm font-semibold text-gray-800 mb-1">@T["Editor_Name"] <span class="text-red-700" aria-hidden="true">*</span></label>
                    <InputText @bind-Value="Input.Name" id="ComboName" class="sd-input" placeholder="@T["Editor_NamePlaceholder"]" autofocus />
                    <ValidationMessage For="() => Input.Name" class="sd-field-error" />
                </div>

                <!-- Description -->
                <div>
                    <label for="ComboDesc" class="block text-sm font-semibold text-gray-800 mb-1">@T["Editor_Description"] <span class="font-normal text-gray-500">@C["OptionalSuffix"]</span></label>
                    <InputText @bind-Value="Input.Description" id="ComboDesc" class="sd-input" placeholder="@T["Editor_DescriptionPlaceholder"]" />
                </div>

                <!-- Combo Price -->
                <div class="max-w-[14rem]">
                    <label for="ComboPrice" class="block text-sm font-semibold text-gray-800 mb-1">@T["Editor_Price"] <span class="text-red-700" aria-hidden="true">*</span></label>
                    <PriceInput @bind-Value="Input.ComboPrice" id="ComboPrice" class="sd-input tabular-nums" />
                    <ValidationMessage For="() => Input.ComboPrice" class="sd-field-error" />
                </div>

                <!-- Trigger Menu Item -->
                <div>
                    <label for="TriggerItem" class="block text-sm font-semibold text-gray-800 mb-1">@T["TriggerItem"] <span class="text-red-700" aria-hidden="true">*</span></label>
                    <p class="mt-0 mb-1.5 text-xs text-gray-600">@T["Editor_TriggerHelp"]</p>
                    <InputSelect @bind-Value="Input.TriggerMenuItemId" id="TriggerItem" class="sd-input">
                        <option value="@Guid.Empty">@T["Editor_TriggerChoose"]</option>
                        @foreach (var item in AvailableMenuItems)
                        {
                            <option value="@item.Id">@T["Editor_ItemOption", item.Name, UiFormat.Price(item.Price)]</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Input.TriggerMenuItemId" class="sd-field-error" />
                </div>

                <!-- Included Items -->
                <div>
                    <label class="block text-sm font-semibold text-gray-800 mb-1">@T["Editor_Included"] <span class="text-red-700" aria-hidden="true">*</span></label>
                    <p class="mt-0 mb-1.5 text-xs text-gray-600">@T["Editor_IncludedHelp"]</p>
                    <MultiSelectComboBox TItem="MenuItem"
                                         Items="AvailableMenuItems"
                                         SelectedItems="selectedMenuItems"
                                         SelectedItemsChanged="OnSelectedItemsChanged"
                                         SearchSelector="item => item.Name"
                                         Placeholder="@T["Editor_SearchPlaceholder"]">
                        <ItemTemplate Context="mi">
                            @mi.Name
                        </ItemTemplate>
                        <SuggestionTemplate Context="mi">
                            <div class="flex justify-between items-center w-full">
                                <span>@mi.Name</span>
                                <span class="text-xs text-gray-500 ml-2">@UiFormat.Price(mi.Price)</span>
                            </div>
                        </SuggestionTemplate>
                    </MultiSelectComboBox>
                    @if (showItemsError)
                    {
                        <p class="sd-field-error">@T["Editor_IncludedRequired"]</p>
                    }
                </div>
            </div>

            <div class="sd-dialog-actions">
                <button type="button" class="sd-btn sd-btn--secondary" @onclick="Cancel">@C["Cancel"]</button>
                <button type="submit" class="sd-btn sd-btn--primary">
                    @(Input.Id == Guid.Empty ? T["Editor_Create"] : T["Editor_SaveChanges"])
                </button>
            </div>
        </EditForm>
    }
</dialog>

@code {
    [Parameter] public MenuCombo Input { get; set; } = new();
    [Parameter] public EventCallback<(MenuCombo Combo, List<Guid> ItemIds)> OnOk { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public List<MenuItem> AvailableMenuItems { get; set; } = new();

    private EditContext editContext = default!;
    private bool isVisible;
    private bool openPending;
    private List<MenuItem> selectedMenuItems = new();
    private bool showItemsError;
    private ElementReference dialog;
    private IJSObjectReference? module;
    private IJSObjectReference? handle;
    private DotNetObjectReference<MenuComboEditor>? selfRef;

    protected override void OnInitialized()
    {
        editContext = new EditContext(Input);
    }

    public void ShowModal()
    {
        // Two decimals in the field ("29.90"; SQLite does not keep the scale — equal value, nothing counts as changed)
        Input.ComboPrice = decimal.Round(Input.ComboPrice, 2) + 0.00m;
        editContext = new EditContext(Input);
        // Resolve selected items from existing combo items
        var existingIds = Input.Items?.Select(i => i.MenuItemId).ToHashSet() ?? new();
        selectedMenuItems = AvailableMenuItems.Where(mi => existingIds.Contains(mi.Id)).ToList();
        showItemsError = false;
        isVisible = true;
        openPending = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!openPending)
            return;
        openPending = false;
        try
        {
            if (handle is null)
            {
                selfRef ??= DotNetObjectReference.Create(this);
                module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/modal-dialog.js");
                handle = await module.InvokeAsync<IJSObjectReference>("attach", dialog, selfRef, null, new { enterApplies = false });
            }
            await handle.InvokeVoidAsync("open");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
        }
    }

    private void OnSelectedItemsChanged(List<MenuItem> items)
    {
        selectedMenuItems = items;
        showItemsError = false;
    }

    private async Task OnSubmit()
    {
        if (!editContext.Validate())
            return;

        if (Input.TriggerMenuItemId == Guid.Empty)
        {
            var messages = new ValidationMessageStore(editContext);
            messages.Add(() => Input.TriggerMenuItemId, T["Editor_TriggerRequired"]);
            editContext.NotifyValidationStateChanged();
            return;
        }

        if (!selectedMenuItems.Any())
        {
            showItemsError = true;
            return;
        }

        await CloseAsync();
        await OnOk.InvokeAsync((Input, selectedMenuItems.Select(mi => mi.Id).ToList()));
    }

    private async Task Cancel()
    {
        await CloseAsync();
        await OnCancel.InvokeAsync();
    }

    private async Task CloseAsync()
    {
        isVisible = false;
        try
        {
            if (handle is not null)
                await handle.InvokeVoidAsync("close");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
        }
    }

    /// <summary>Escape, a backdrop click or close(): the browser closed the dialog.</summary>
    [JSInvokable]
    public async Task OnDialogClosedJs()
    {
        if (!isVisible)
            return;
        isVisible = false;
        StateHasChanged();
        await OnCancel.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (handle is not null)
            {
                await handle.InvokeVoidAsync("dispose");
                await handle.DisposeAsync();
            }
            if (module is not null)
                await module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
        }
        selfRef?.Dispose();
    }
}
