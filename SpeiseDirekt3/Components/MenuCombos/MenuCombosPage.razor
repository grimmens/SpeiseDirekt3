@page "/combos/{MenuId:guid}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SpeiseDirekt3.Components.MenuCombos.Components
@using SpeiseDirekt.Infrastructure
@using SpeiseDirekt.Model
@using SpeiseDirekt.ServiceInterface
@inject ApplicationDbContext Context
@inject INotificationService NotificationService
@inject NavigationManager NavManager
@inject IPermissionService PermissionService
@attribute [Authorize]

<PageTitle>Combos - @menu?.Name</PageTitle>

@* "Menus › menu" is in the menu context bar (Layout/MenuContextBar) *@
<PageHeader Title="Combos" Icon="PageIcons.Combos" Tone="TileTone.Accent">
    <Description>Create combo offers that customers see when ordering specific items.</Description>
    <Actions>
        @if (canCreate)
        {
            <button type="button" class="sd-btn sd-btn--primary" @onclick="CreateCombo">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                New Combo
            </button>
        }
    </Actions>
</PageHeader>

<!-- Content -->
<div>
    @if (combos == null)
    {
        <div class="flex items-center justify-center py-12">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-brand-600"></div>
            <span class="ml-3 text-gray-600">Loading...</span>
        </div>
    }
    else if (!combos.Any())
    {
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm">
            <div class="sd-empty">
                <span class="sd-empty-icon" aria-hidden="true">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="@PageIcons.Combos.Path" /></svg>
                </span>
                <h3 class="sd-empty-title">No combos yet</h3>
                <p class="sd-empty-text">Create a combo to offer customers bundled deals when they order specific items.</p>
                @if (canCreate)
                {
                    <div class="mt-4">
                        <button type="button" class="sd-btn sd-btn--primary" @onclick="CreateCombo">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                            New Combo
                        </button>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- Combos Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var combo in combos)
            {
                <article class="bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col" data-testid="combo-card">
                    <div class="sd-card-head">
                        <div class="min-w-0">
                            <h3 class="sd-card-title break-words">@combo.Name</h3>
                            @if (!string.IsNullOrEmpty(combo.Description))
                            {
                                <p class="text-sm text-gray-600 mt-0.5 mb-0">@combo.Description</p>
                            }
                        </div>
                        <span class="inline-flex items-center flex-shrink-0 whitespace-nowrap px-2.5 py-0.5 rounded-full text-sm font-bold bg-green-100 text-green-800 tabular-nums">
                            @PriceFormat.Euro(combo.ComboPrice)
                        </span>
                    </div>

                    <div class="p-[1rem] sm:p-5 flex-1">
                        <!-- Trigger Item -->
                        <div class="mb-3">
                            <p class="text-xs font-bold text-gray-600 uppercase tracking-wide mb-1">Trigger Item</p>
                            <div class="flex items-center gap-2">
                                <span class="inline-flex p-1 bg-accent-100 text-accent-800 rounded" aria-hidden="true">
                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                    </svg>
                                </span>
                                <span class="text-sm font-medium text-gray-900">@combo.TriggerMenuItem?.Name</span>
                            </div>
                        </div>

                        <!-- Included Items -->
                        <div>
                            <p class="text-xs font-bold text-gray-600 uppercase tracking-wide mb-1">Includes (@combo.Items.Count items)</p>
                            <div class="flex flex-wrap gap-1">
                                @foreach (var comboItem in combo.Items)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-brand-50 text-brand-800 border border-brand-200">
                                        @comboItem.MenuItem?.Name
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    @if (canEdit || canDelete)
                    {
                        <div class="flex gap-2 px-[1rem] sm:px-5 py-3 border-t border-gray-100">
                            @if (canEdit)
                            {
                                <button type="button" class="sd-btn sd-btn--secondary sd-btn--small flex-1" @onclick="() => EditCombo(combo)">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                    </svg>
                                    Edit
                                </button>
                            }
                            @if (canDelete)
                            {
                                <button type="button" class="sd-row-action sd-row-action--danger" title="Delete" aria-label="@($"Delete combo {combo.Name}")"
                                        @onclick="() => DeleteCombo(combo)">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            }
                        </div>
                    }
                </article>
            }
        </div>
    }
</div>

<!-- Editor Modal -->
<MenuComboEditor @ref="comboEditor" OnOk="HandleOk" OnCancel="HandleCancel" AvailableMenuItems="availableMenuItems" />

@code {
    [Parameter] public Guid MenuId { get; set; }

    private Menu? menu;
    private List<MenuCombo>? combos;
    private List<MenuItem> availableMenuItems = new();
    private MenuComboEditor comboEditor = default!;
    private bool canCreate, canEdit, canDelete;

    protected override async Task OnInitializedAsync()
    {
        canCreate = await PermissionService.HasPermissionAsync(Permission.MenuCombosCreate);
        canEdit = await PermissionService.HasPermissionAsync(Permission.MenuCombosEdit);
        canDelete = await PermissionService.HasPermissionAsync(Permission.MenuCombosDelete);
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        menu = await Context.Menus.FirstOrDefaultAsync(m => m.Id == MenuId);
        combos = await Context.MenuCombos
            .Include(c => c.TriggerMenuItem)
            .Include(c => c.Items)
                .ThenInclude(i => i.MenuItem)
            .Where(c => c.MenuId == MenuId)
            .ToListAsync();

        availableMenuItems = await Context.MenuItems
            .Include(mi => mi.Category)
            .Where(mi => Context.Categories.Any(c => c.MenuId == MenuId && c.Id == mi.CategoryId))
            .OrderBy(mi => mi.Name)
            .ToListAsync();
    }

    private void CreateCombo()
    {
        comboEditor.Input = new MenuCombo { MenuId = MenuId };
        comboEditor.ShowModal();
    }

    private void EditCombo(MenuCombo combo)
    {
        comboEditor.Input = combo;
        comboEditor.ShowModal();
    }

    private async Task HandleOk((MenuCombo Combo, List<Guid> ItemIds) result)
    {
        var (combo, itemIds) = result;

        if (combo.Id == Guid.Empty)
        {
            combo.Items = itemIds.Select(id => new MenuComboItem { MenuItemId = id }).ToList();
            Context.MenuCombos.Add(combo);
        }
        else
        {
            // Remove old items, add new ones
            var existing = await Context.MenuComboItems
                .Where(i => i.MenuComboId == combo.Id)
                .ToListAsync();
            Context.MenuComboItems.RemoveRange(existing);

            foreach (var itemId in itemIds)
            {
                Context.MenuComboItems.Add(new MenuComboItem
                {
                    MenuComboId = combo.Id,
                    MenuItemId = itemId
                });
            }

            Context.MenuCombos.Update(combo);
        }

        await Context.SaveChangesAsync();
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The editor binds to the tracked combo: drop what was typed but not saved, so the cards show the stored values
    /// and a later save (e.g. deleting another combo) cannot write it.
    /// </summary>
    private async Task HandleCancel()
    {
        Context.ChangeTracker.Clear();
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteCombo(MenuCombo combo)
    {
        if (!canDelete) return;

        var confirm = await NotificationService.ShowConfirmation(("Delete", $"Delete combo \"{combo.Name}\"?"));
        if (confirm)
        {
            Context.MenuCombos.Remove(combo);
            await Context.SaveChangesAsync();
            await LoadDataAsync();
            await InvokeAsync(StateHasChanged);
        }
    }
}
