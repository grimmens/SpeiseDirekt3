@page "/analytics"
@using Microsoft.AspNetCore.Authorization
@using SpeiseDirekt.Model
@using SpeiseDirekt.ServiceInterface
@inject IAnalyticsService AnalyticsService
@inject IPermissionService PermissionService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager
@inherits PaidTenantComponentBase
@attribute [Authorize]

<PageTitle>Analytics - Speise-Direkt</PageTitle>

<!-- Header with time range -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-6">
    <div class="p-6 flex flex-col xl:flex-row xl:items-center xl:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 font-display">Analytics Dashboard</h1>
            <p class="mt-2 text-gray-600">Track your menu performance and guest engagement</p>
        </div>
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Time range">
            <button @onclick="() => SetTimeRange(TimeRange.Last24Hours)"
                    class="@GetTimeRangeButtonClass(TimeRange.Last24Hours)">
                Last 24 Hours
            </button>
            <button @onclick="() => SetTimeRange(TimeRange.Last7Days)"
                    class="@GetTimeRangeButtonClass(TimeRange.Last7Days)">
                Last 7 Days
            </button>
            <button @onclick="() => SetTimeRange(TimeRange.Last30Days)"
                    class="@GetTimeRangeButtonClass(TimeRange.Last30Days)">
                Last 30 Days
            </button>
            <button @onclick="RenderCharts"
                    class="px-4 py-2 text-sm font-medium rounded-lg whitespace-nowrap bg-green-600 text-white hover:bg-green-700">
                Refresh Charts
            </button>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="flex justify-center items-center py-12">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
    </div>
}
else
{
    <!-- Summary Stats -->
    <div class="grid grid-cols-3 gap-3 sm:gap-6 mb-6" data-testid="analytics-summary">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6" data-testid="summary-views">
            <div class="flex items-center">
                <div class="hidden sm:flex shrink-0 p-3 rounded-full bg-blue-100 text-blue-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                </div>
                <div class="min-w-0 sm:ml-4">
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Total Views</p>
                    <p class="text-xl sm:text-2xl font-bold text-gray-900" data-testid="summary-value">@totalViews</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6" data-testid="summary-clicks">
            <div class="flex items-center">
                <div class="hidden sm:flex shrink-0 p-3 rounded-full bg-green-100 text-green-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path>
                    </svg>
                </div>
                <div class="min-w-0 sm:ml-4">
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Total Clicks</p>
                    <p class="text-xl sm:text-2xl font-bold text-gray-900" data-testid="summary-value">@totalClicks</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6" data-testid="summary-sessions"
             title="A session is one guest device; guests stay anonymous.">
            <div class="flex items-center">
                <div class="hidden sm:flex shrink-0 p-3 rounded-full bg-purple-100 text-purple-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                </div>
                <div class="min-w-0 sm:ml-4">
                    <p class="text-xs sm:text-sm font-medium text-gray-600">Sessions</p>
                    <p class="text-xl sm:text-2xl font-bold text-gray-900" data-testid="summary-value">@userTrafficData.Count</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Grid -->
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6" data-testid="analytics-charts">
        <!-- Traffic per Menu Chart -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-4">
                <h3 class="text-lg font-semibold text-gray-900">Traffic per Menu</h3>
                <div class="text-sm text-gray-500">
                    @menuTrafficData.Count menus tracked
                </div>
            </div>
            <div class="h-80">
                <canvas id="menuTrafficChart" width="400" height="400"></canvas>
            </div>
        </div>

        <!-- Sessions Chart: guest devices active per hour/day (anonymous, so one series in total) -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-1">
                <h3 class="text-lg font-semibold text-gray-900">Sessions</h3>
                <div class="text-sm text-gray-500">
                    @userTrafficData.Count sessions
                </div>
            </div>
            <p class="text-sm text-gray-500 mb-4">Guest devices that opened a menu, per @(selectedTimeRange == TimeRange.Last24Hours ? "hour" : "day"). Guests stay anonymous.</p>
            <div class="h-72">
                <canvas id="userTrafficChart" width="400" height="400"></canvas>
            </div>
        </div>

        <!-- Traffic per Menu Item Chart -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6 xl:col-span-2">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-4">
                <h3 class="text-lg font-semibold text-gray-900">Traffic per Menu Item</h3>
                <div class="text-sm text-gray-500">
                    @menuItemTrafficData.Count items tracked
                </div>
            </div>
            <div class="h-80">
                <canvas id="menuItemTrafficChart" width="800" height="400"></canvas>
            </div>
        </div>
    </div>
}

@code {
    private TimeRange selectedTimeRange = TimeRange.Last7Days;
    private bool isLoading = true;
    private bool initialRenderComplete = false;

    private List<UserTrafficData> userTrafficData = new();
    private List<MenuTrafficData> menuTrafficData = new();
    private List<MenuItemTrafficData> menuItemTrafficData = new();
    // Sessions active per hour/day bucket, the one series of the "Sessions" chart
    private List<DataPoint> sessionsPerBucket = new();

    private int totalViews = 0;
    private int totalClicks = 0;

    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionService.HasPermissionAsync(Permission.AnalyticsView))
        {
            NavManager.NavigateTo("/");
            return;
        }
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !initialRenderComplete)
        {
            // Wait for initial data loading to complete
            while (isLoading)
            {
                await Task.Delay(100);
            }

            // Add a small delay to ensure DOM is ready
            await Task.Delay(200);
            await RenderCharts();
            initialRenderComplete = true;
        }
    }

    private async Task SetTimeRange(TimeRange timeRange)
    {
        selectedTimeRange = timeRange;
        await LoadData();
        await RenderCharts();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            userTrafficData = await AnalyticsService.GetTrafficPerUserAsync(selectedTimeRange);
            menuTrafficData = await AnalyticsService.GetTrafficPerMenuAsync(selectedTimeRange);
            menuItemTrafficData = await AnalyticsService.GetTrafficPerMenuItemAsync(selectedTimeRange);

            // The service returns at most one data point per session and bucket, so counting the points of a
            // bucket counts the sessions active in it (the per-session series themselves say nothing: anonymous)
            sessionsPerBucket = userTrafficData
                .SelectMany(u => u.Data)
                .GroupBy(d => d.Date)
                .Select(g => new DataPoint { Date = g.Key, Count = g.Count() })
                .OrderBy(d => d.Date)
                .ToList();

            totalViews = menuTrafficData.Sum(m => m.TotalViews);
            totalClicks = menuItemTrafficData.Sum(mi => mi.TotalClicks);
        }
        catch (Exception ex)
        {
            // Log error
            Console.WriteLine($"Error loading analytics data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();

            // Render charts after data is loaded and UI is updated
            await Task.Delay(500); // Give more time for DOM to update
            await RenderCharts();
        }
    }

    private async Task RenderCharts()
    {
        if (!isLoading)
        {
            Console.WriteLine($"RenderCharts called with {userTrafficData.Count} users, {menuTrafficData.Count} menus, {menuItemTrafficData.Count} items");

            // Debug: Print actual data
            if (menuItemTrafficData?.Any() == true)
            {
                Console.WriteLine("MenuItemTrafficData details:");
                foreach (var item in menuItemTrafficData.Take(2))
                {
                    Console.WriteLine($"  Item: {item.MenuItemName}, Data points: {item.Data?.Count ?? 0}");
                    if (item.Data?.Any() == true)
                    {
                        foreach (var dataPoint in item.Data.Take(3))
                        {
                            Console.WriteLine($"    Date: {dataPoint.Date}, Count: {dataPoint.Count}");
                        }
                    }
                }
            }

            try
            {
                await JSRuntime.InvokeVoidAsync("renderAnalyticsCharts",
                    sessionsPerBucket, menuTrafficData, menuItemTrafficData, selectedTimeRange.ToString());
                Console.WriteLine("JSRuntime.InvokeVoidAsync completed successfully");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error calling renderAnalyticsCharts: {ex.Message}");
            }
        }
    }

    private string GetTimeRangeButtonClass(TimeRange timeRange)
    {
        var baseClass = "px-4 py-2 text-sm font-medium rounded-lg whitespace-nowrap transition-colors duration-200";
        return selectedTimeRange == timeRange
            ? $"{baseClass} bg-blue-600 text-white"
            : $"{baseClass} bg-gray-100 text-gray-700 hover:bg-gray-200";
    }
}
