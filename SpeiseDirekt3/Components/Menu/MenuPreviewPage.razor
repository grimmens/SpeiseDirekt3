@page "/menu/preview/{id}"
@* Owner preview: the real guest page (static SSR) for logged-in users, own tenant only (query filters apply).
   Item clicks are not recorded. ?theme=<key> shows another design theme and ?lang=<code> (de, en, fr, …) another menu
   language — UI texts, price notation, lang — without saving: the menu editor's phone frame uses them for the unsaved
   theme and language (name and description arrive live by postMessage, js/guest-preview.js). Both only exist here; the
   public pages ignore them. The language links of the preview go to the other versions' previews. *@
@using SpeiseDirekt.Infrastructure
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@attribute [GuestPage]
@layout GuestLayout
@using Microsoft.AspNetCore.Authorization
@using SpeiseDirekt.ServiceInterface
@inject ApplicationDbContext Db
@inject IRestaurantProfileService Profiles
@inject IPermissionService PermissionService
@inject NavigationManager NavManager

@if (model is null)
{
    <GuestNotice Kind="GuestNotice.GuestNoticeKind.NotFound" Title="Menü nicht gefunden"
                 Message="Dieses Menü existiert nicht oder wurde gelöscht." ShowHomeLink="true" />
}
else
{
    <GuestMenuView Model="model" />
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "item")] public string? Item { get; set; }
    /// <summary>Design theme to preview instead of the saved one (case-insensitive name, e.g. <c>dark</c>).</summary>
    [SupplyParameterFromQuery(Name = "theme")] public string? Theme { get; set; }
    /// <summary>Menu language to preview instead of the saved one (ISO code, e.g. <c>en</c>).</summary>
    [SupplyParameterFromQuery(Name = "lang")] public string? Lang { get; set; }

    private GuestMenuModel? model;

    protected override async Task OnInitializedAsync()
    {
        // An inactive or removed team member sees nothing of the tenant (AP14)
        if (!await PermissionService.RequireAsync(Permission.MenusView, NavManager)) return;
        if (!Guid.TryParse(Id, out var menuId))
            return;

        var menu = await GuestMenuLoader.LoadMenuAsync(Db, menuId, publicAccess: false);
        if (menu is null)
            return;

        DesignTheme? theme = Enum.TryParse<DesignTheme>(Theme, ignoreCase: true, out var t) && Enum.IsDefined(t) ? t : null;
        var language = MenuLanguages.All.FirstOrDefault(l => string.Equals(l.Code, Lang, StringComparison.OrdinalIgnoreCase))?.Language;
        model = await GuestMenuLoader.BuildAsync(Db, Profiles, menu, $"/menu/preview/{menuId}", Item,
            trackClicks: false, isPreview: true, themeOverride: theme, languageOverride: language);
    }
}
