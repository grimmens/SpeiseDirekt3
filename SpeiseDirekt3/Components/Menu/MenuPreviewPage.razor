@page "/menu/preview/{id}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SpeiseDirekt.Data
@using SpeiseDirekt.Model
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager
@layout MenuLayout

<!-- Content wrapper with top padding to account for fixed banner -->
<div class="">

@if (loading)
    {
        <GuestNotice Kind="GuestNotice.GuestNoticeKind.Loading" Title="Menü wird geladen…" />
    }
    else if (menu == null)
    {
        <GuestNotice Kind="GuestNotice.GuestNoticeKind.NotFound" Title="Menü nicht gefunden"
                     Message="Dieses Menü existiert nicht oder wurde gelöscht." ShowHomeLink="true" />
    }
    else
    {
        <SpeiseDirekt3.Components.Menu.MenuDisplayComponent Menu="menu" />
    }

</div>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private Menu? menu;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (Guid.TryParse(Id, out var menuId))
        {
            menu = await DbContext.Menus
                .IgnoreQueryFilters()
                .Include(m => m.Categories)
                    .ThenInclude(c => c.MenuItems)
                        .ThenInclude(i => i.Allergens)
                .AsNoTracking()
                .Where(m => m.Id == menuId)
                .FirstOrDefaultAsync();
        }
            
        loading = false;
        await InvokeAsync(StateHasChanged);
    }
}