@page "/menu/edit/{Id:guid?}"
@using Microsoft.EntityFrameworkCore
@using SpeiseDirekt.Model
@using SpeiseDirekt.ServiceInterface
@using SpeiseDirekt.Infrastructure
@implements IAsyncDisposable
@inject ApplicationDbContext Context
@inject IMenuTranslationService Translations
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inject IPermissionService PermissionService

<PageTitle>@(IsNew ? "New Menu" : $"Edit {Menu.Name}") - Speise-Direkt</PageTitle>

<!-- Header -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-8">
    <div class="p-[1rem] sm:p-6">
        <div class="flex items-center text-sm text-gray-500 mb-3">
            <a href="menus" class="hover:text-blue-600 transition-colors">Menus</a>
            @if (!IsNew)
            {
                <svg class="mx-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <a href="@($"menudetail/{Id}")" class="hover:text-blue-600 transition-colors">@Menu.Name</a>
            }
            <svg class="mx-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span class="text-gray-900 font-medium">@(IsNew ? "New Menu" : "Settings")</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-3">
                <h1 class="text-3xl font-bold text-gray-900 font-display">@(IsNew ? "Create New Menu" : "Menu Settings")</h1>
            </div>
        </div>
    </div>
</div>

<!-- Content -->
<div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <div class="flex flex-col gap-8 min-w-0">
        <!-- Form Card (menu-preview-draft.js listens to its inputs and sends the draft to the preview) -->
        <div class="bg-white rounded-xl border border-gray-200 p-[1rem] sm:p-6" @ref="formCard">
            <h2 class="text-lg font-semibold text-gray-900 mb-6">Menu Details</h2>
            <EditForm EditContext="EditContext" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <!-- Menu Name -->
                <div class="mb-5">
                    <label for="menuName" class="block text-sm font-medium text-gray-700 mb-1">Menu Name</label>
                    <InputText @bind-Value="Menu.Name"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-gray-900 placeholder-gray-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-none transition-colors"
                               id="menuName" placeholder="Enter menu name" />
                    <ValidationMessage For="@(() => Menu.Name)" class="text-sm text-red-600 mt-1" />
                </div>

                <!-- Description -->
                <div class="mb-5">
                    <label for="menuDesc" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                    <InputText @bind-Value="Menu.Description"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-gray-900 placeholder-gray-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-none transition-colors"
                               id="menuDesc" placeholder="Enter description" />
                </div>

                <!-- Language -->
                <div class="mb-5">
                    <label for="languageSelect" class="flex items-center gap-1 text-sm font-medium text-gray-700 mb-1">
                        Language
                        <SpeiseDirekt3.Components.HelperComp.InfoPopoverComp>
                            <Content>
                                This setting defines the language in which your menu content is written, and will be automatically translated from.
                            </Content>
                        </SpeiseDirekt3.Components.HelperComp.InfoPopoverComp>
                    </label>
                    <InputSelect @bind-Value="Menu.Language" @bind-Value:after="OnLanguageChanged"
                                 class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-gray-900 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-none transition-colors"
                                 id="languageSelect">
                        @foreach (var language in Enum.GetValues<MenuLanguage>())
                        {
                            @* A language another version of this menu has is taken (one menu per language in a group) *@
                            var takenBy = versions.FirstOrDefault(v => v.Language == language && v.Id != Menu.Id);
                            <option value="@language" disabled="@(takenBy is not null)">@language@(takenBy is not null ? " (another version)" : "")</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => Menu.Language)" class="text-sm text-red-600 mt-1" />
                </div>

                <!-- Design Theme -->
                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Design Theme</label>
                    <p class="text-xs text-gray-500 mb-2">Colors and fonts of the guest view. The preview updates immediately.</p>
                    <div class="flex items-center gap-2">
                        <button type="button"
                                class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-gray-300 bg-white text-gray-600 hover:bg-gray-50 hover:border-gray-400 transition-colors"
                                @onclick="() => ChangeTheme(-1)">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                            </svg>
                        </button>

                        <InputSelect @bind-Value="Menu.Theme"
                                     class="flex-1 rounded-lg border border-gray-300 px-3 py-2.5 text-gray-900 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-none transition-colors"
                                     id="themeSelect">
                            @foreach (var theme in Enum.GetValues<DesignTheme>())
                            {
                                <option value="@theme">@theme</option>
                            }
                        </InputSelect>

                        <button type="button"
                                class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-gray-300 bg-white text-gray-600 hover:bg-gray-50 hover:border-gray-400 transition-colors"
                                @onclick="() => ChangeTheme(+1)">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between pt-4 border-t border-gray-200">
                    <button type="button"
                            class="inline-flex items-center justify-center whitespace-nowrap px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition-colors"
                            @onclick="Cancel">
                        Cancel
                    </button>
                    <button type="submit"
                            class="inline-flex items-center justify-center whitespace-nowrap px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        @(IsNew ? "Create Menu" : "Save Changes")
                    </button>
                </div>
            </EditForm>
        </div>

        @if (!IsNew && loaded)
        {
            <MenuLanguageVersions MenuId="Menu.Id" Versions="versions" CanCreate="canCreate" OnChanged="OnVersionsChangedAsync" />
        }
        </div>

        <!-- Preview Card: the guest menu in a phone-sized frame with its own scrollbar -->
        <div class="bg-white rounded-xl border border-gray-200 p-[1rem] sm:p-6 lg:sticky lg:top-6">
            <div class="flex items-start justify-between gap-3 mb-4">
                <div>
                    <h2 class="text-lg font-semibold text-gray-900">Preview</h2>
                    <p class="text-sm text-gray-500">How guests see it on their phone.</p>
                </div>
                @if (!IsNew)
                {
                    <a href="@($"menu/preview/{Id}")" target="_blank" rel="noopener"
                       class="inline-flex items-center gap-1 whitespace-nowrap text-sm font-medium text-blue-600 hover:text-blue-800">
                        Full screen
                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16" class="shrink-0" aria-hidden="true"><path fill-rule="evenodd" d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5"/> <path fill-rule="evenodd" d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0z"/></svg>
                    </a>
                }
            </div>
            @if (IsNew)
            {
                <div data-testid="menu-preview-hint" class="rounded-lg border border-dashed border-gray-300 bg-gray-50 px-[1rem] py-6 text-sm text-gray-600">
                    Save the menu to see how guests will see it.
                </div>
            }
            else
            {
                <div class="flex justify-center">
                    @* The real guest page (static SSR, its own CSS/JS) in an iframe, so its media queries see the
                       380 px phone width. Unsaved name, description and theme reach it live by postMessage
                       (js/menu-preview-draft.js → js/guest-preview.js, the theme switches in place). The language needs
                       server-rendered texts: a language change reloads the frame with ?lang= (and the current ?theme=);
                       @key replaces the iframe instead of changing its src, so that adds no history entries, and the
                       reloaded frame asks for the draft again. *@
                    <div data-testid="menu-preview-frame" @ref="previewFrame"
                         class="relative w-full rounded-[2.25rem] border-[10px] border-gray-900 bg-gray-900 shadow-xl"
                         style="max-width: 380px; height: 640px; overflow: hidden;">
                        <iframe @key="previewUrl" src="@previewUrl" title="Guest preview" data-testid="menu-preview-iframe"
                                class="bg-white rounded-[1.6rem]"
                                style="display: block; width: 100%; height: 100%; border: 0;"></iframe>
                    </div>
                </div>
                <p class="mt-3 text-xs text-gray-500" data-testid="menu-preview-note">Shows your unsaved changes. Guests see them after you save.</p>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private Menu Menu { get; set; } = new();
    private EditContext EditContext { get; set; } = new EditContext(new Menu());
    private ValidationMessageStore? messages;
    private bool IsNew => !Id.HasValue;
    private bool loaded;
    private bool canCreate;
    private Guid? loadedId;

    /// <summary>Language versions of the menu (this one included), for the select and the "Language versions" card.</summary>
    private IReadOnlyList<MenuVersion> versions = Array.Empty<MenuVersion>();

    /// <summary>
    /// Owner preview in the phone frame: the saved menu with the draft's language (?lang=) and theme (?theme=, the
    /// starting point after a reload). Set on load and on a language change only — theme and text changes arrive by
    /// postMessage without a reload. <see cref="previewReload"/> forces a reload (versions linked or unlinked).
    /// </summary>
    private string previewUrl = "";
    private int previewReload;

    private ElementReference formCard;
    private ElementReference previewFrame;
    private IJSObjectReference? draftModule;
    private IJSObjectReference? draftHandle;
    private bool draftAttached;

    protected override async Task OnParametersSetAsync()
    {
        // Same component for another menu (e.g. "Edit" of a language version, or the new copy): load it
        if (loaded && loadedId == Id)
            return;

        var requiredPerm = IsNew ? Permission.MenusCreate : Permission.MenusEdit;
        if (!await PermissionService.HasPermissionAsync(requiredPerm))
        {
            NavManager.NavigateTo("/menus");
            return;
        }
        canCreate = await PermissionService.HasPermissionAsync(Permission.MenusCreate);

        // Unsaved edits of a previously shown menu must never be written by a later save
        Context.ChangeTracker.Clear();
        if (IsNew)
        {
            Menu = new Menu();
            versions = Array.Empty<MenuVersion>();
        }
        else
        {
            // Only the menu itself: the preview is the guest page in an iframe and loads its own data
            Menu = (await Context.Menus
                .SingleOrDefaultAsync(e => e.Id == Id))
               ?? throw new InvalidOperationException($"Menu '{Id}' not found.");
            versions = await Translations.GetVersionsAsync(Menu.Id);
        }

        EditContext = new EditContext(Menu);
        messages = new ValidationMessageStore(EditContext);
        EditContext.OnFieldChanged += (_, e) =>
        {
            // A server-side message (name taken, language taken) goes away once the field changes
            if (e.FieldIdentifier.FieldName is nameof(Menu.Language) or nameof(Menu.Name))
            {
                messages.Clear(e.FieldIdentifier);
                EditContext.NotifyValidationStateChanged();
            }
        };
        loadedId = Id;
        loaded = true;
        UpdatePreviewUrl();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsNew || !loaded)
            return;
        try
        {
            if (!draftAttached)
            {
                draftAttached = true;
                // "./": resolved against the base href; the ImportMap of the back office maps it to the fingerprinted file
                draftModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/menu-preview-draft.js");
                draftHandle = await draftModule.InvokeAsync<IJSObjectReference>("attach", formCard, previewFrame);
            }
            else if (draftHandle is not null)
            {
                // Blazor may have changed a field itself (theme arrows, another menu loaded): send the current values
                await draftHandle.InvokeVoidAsync("refresh");
            }
        }
        catch (JSException e)
        {
            // Without the live draft the preview still shows the saved menu; the form must keep working
            Console.Error.WriteLine($"Menu editor: live preview unavailable: {e.Message}");
        }
    }

    private void UpdatePreviewUrl()
    {
        var code = MenuLanguages.Of(Menu.Language).Code;
        previewUrl = $"/menu/preview/{Id}?theme={Menu.Theme.ToString().ToLowerInvariant()}&lang={code}"
                     + (previewReload > 0 ? $"&v={previewReload}" : "");
    }

    /// <summary>The draft's language changed: reload the preview with ?lang= (texts and prices come from the server).</summary>
    private void OnLanguageChanged() => UpdatePreviewUrl();

    /// <summary>A version was linked or unlinked: reload the list, the select's taken languages and the preview's switch.</summary>
    private async Task OnVersionsChangedAsync()
    {
        versions = await Translations.GetVersionsAsync(Menu.Id);
        previewReload++;
        UpdatePreviewUrl();
    }

    private async Task HandleValidSubmit()
    {
        var nameExists = await Context.Menus
            .Where(m => m.Id != Menu.Id)
            .AnyAsync(m => m.Name == Menu.Name);

        if (nameExists)
        {
            messages!.Add(() => Menu.Name, "This name already exists.");
            EditContext.NotifyValidationStateChanged();
            return;
        }

        if (!IsNew && await Translations.ValidateLanguageAsync(Menu.Id, Menu.Language) is { } conflict)
        {
            messages!.Add(() => Menu.Language, conflict);
            EditContext.NotifyValidationStateChanged();
            return;
        }

        if (IsNew)
        {
            Context.Menus.Add(Menu);
        }
        else
        {
            Context.Menus.Update(Menu);
            // Linked and unlinked in the "Language versions" card (another DbContext): never overwrite it from here
            Context.Entry(Menu).Property(m => m.TranslationGroupId).IsModified = false;
        }

        await Context.SaveChangesAsync();
        NavManager.NavigateTo(IsNew ? "/menus" : $"/menudetail/{Menu.Id}");
    }

    void ChangeTheme(int direction)
    {
        var themes = Enum.GetValues<DesignTheme>().Cast<DesignTheme>().ToList();
        var currentIndex = themes.IndexOf(Menu.Theme);
        var nextIndex = (currentIndex + direction + themes.Count) % themes.Count;
        Menu.Theme = themes[nextIndex];
    }

    private void Cancel()
    {
        NavManager.NavigateTo(IsNew ? "/menus" : $"/menudetail/{Id}");
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (draftHandle is not null)
            {
                await draftHandle.InvokeVoidAsync("dispose");
                await draftHandle.DisposeAsync();
            }
            if (draftModule is not null)
                await draftModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone (tab closed): nothing to clean up in the browser
        }
    }
}
