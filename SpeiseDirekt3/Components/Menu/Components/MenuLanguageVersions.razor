@* "Language versions" of the menu settings (MenuEditForm): the menus linked as the same menu in other languages
   (Menu.TranslationGroupId, IMenuTranslationService) with a link to edit each, plus
   - "Add translation": copies the menu into a language the group does not have yet and opens the copy's settings, so
     the owner can translate the texts (needs MenusCreate; no machine translation);
   - "Link existing menu": another menu of the tenant in a free language that is not linked elsewhere;
   - "Unlink": per version, or this menu itself. A group left with one menu is dissolved.
   The parent loads the versions (Versions) and reloads them through OnChanged after every change. *@
@using SpeiseDirekt.Infrastructure
@using SpeiseDirekt.ServiceInterface
@inject IMenuTranslationService Translations
@inject NavigationManager NavManager
@inject IStringLocalizer<MenusText> T
@inject IStringLocalizer<CommonText> C

<div class="bg-white rounded-xl border border-gray-200 p-[1rem] sm:p-6" data-testid="language-versions">
    <h2 class="text-lg font-semibold text-gray-900">@T["Versions_Title"]</h2>
    <p class="mt-1 text-sm text-gray-500">
        @T["Versions_Intro"]
    </p>

    <ul class="mt-4 rounded-lg border border-gray-200 divide-y divide-gray-100" data-testid="language-version-list">
        @foreach (var version in Versions)
        {
            var language = MenuLanguages.Of(version.Language);
            var isCurrent = version.Id == MenuId;
            <li class="flex items-center gap-3 px-3 py-2.5" data-testid="language-version" data-language="@language.Code" @key="version.Id">
                <span class="inline-flex shrink-0 items-center justify-center w-10 h-7 rounded-md text-xs font-bold @(isCurrent ? "bg-brand-600 text-white" : "bg-gray-100 text-gray-700")">@language.ShortCode</span>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium text-gray-900 truncate">@version.Name</div>
                    <div class="text-xs text-gray-500">@(isCurrent ? T["Versions_ThisMenu", language.DisplayName] : language.DisplayName)</div>
                </div>
                @if (!isCurrent)
                {
                    <a href="@($"menu/edit/{version.Id}")" class="text-sm font-medium text-brand-600 hover:text-brand-800 whitespace-nowrap"
                       aria-label="@T["Versions_EditLabel", language.DisplayName]">@C["Edit"]</a>
                    @if (Versions.Count > 1)
                    {
                        <button type="button" class="ml-1 text-sm font-medium text-gray-500 hover:text-red-600 whitespace-nowrap disabled:opacity-50"
                                disabled="@busy" @onclick="() => UnlinkAsync(version.Id)"
                                aria-label="@T["Versions_UnlinkLabel", language.DisplayName]">@T["Versions_Unlink"]</button>
                    }
                }
            </li>
        }
    </ul>
    @if (Versions.Count <= 1)
    {
        <p class="mt-2 text-sm text-gray-500" data-testid="language-versions-empty">@T["Versions_Empty"]</p>
    }

    @if (error is not null)
    {
        <p class="mt-3 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" role="alert" data-testid="language-versions-error">@error</p>
    }

    @if (panel == Panel.Add)
    {
        <div class="mt-4 rounded-lg border border-gray-200 bg-gray-50 px-[1rem] py-[1rem]" data-testid="add-translation-panel">
            <label for="translationLanguage" class="block text-sm font-medium text-gray-700 mb-1">@T["Versions_CopyLanguage"]</label>
            <select id="translationLanguage" class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-gray-900 bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none"
                    @bind="newLanguage">
                @foreach (var language in FreeLanguages)
                {
                    <option value="@language.Language">@T["Versions_LinkOption", language.DisplayName, language.NativeName]</option>
                }
            </select>
            <p class="mt-2 text-xs text-gray-500">
                @T["Versions_CopyText"]
            </p>
            <div class="mt-3 flex flex-wrap items-center gap-2">
                <button type="button" class="inline-flex items-center px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg transition-colors disabled:opacity-50"
                        disabled="@busy" @onclick="CreateTranslationAsync">@T["Versions_CreateCopy"]</button>
                <button type="button" class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg transition-colors"
                        @onclick="ClosePanel">@C["Cancel"]</button>
            </div>
        </div>
    }
    else if (panel == Panel.Link)
    {
        <div class="mt-4 rounded-lg border border-gray-200 bg-gray-50 px-[1rem] py-[1rem]" data-testid="link-menu-panel">
            <label for="linkMenu" class="block text-sm font-medium text-gray-700 mb-1">@T["Versions_LinkMenu"]</label>
            <select id="linkMenu" class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-gray-900 bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none"
                    @bind="linkMenuIdText">
                @foreach (var candidate in candidates)
                {
                    <option value="@candidate.Id">@T["Versions_LinkOption", candidate.Name, MenuLanguages.Of(candidate.Language).DisplayName]</option>
                }
            </select>
            <p class="mt-2 text-xs text-gray-500">@T["Versions_LinkText"]</p>
            <div class="mt-3 flex flex-wrap items-center gap-2">
                <button type="button" class="inline-flex items-center px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg transition-colors disabled:opacity-50"
                        disabled="@busy" @onclick="LinkAsync">@T["Versions_Link"]</button>
                <button type="button" class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg transition-colors"
                        @onclick="ClosePanel">@C["Cancel"]</button>
            </div>
        </div>
    }
    else
    {
        <div class="mt-4 flex flex-wrap items-center gap-2">
            @if (CanCreate)
            {
                <button type="button" class="inline-flex items-center px-3.5 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg transition-colors disabled:opacity-50"
                        disabled="@(FreeLanguages.Count == 0)" @onclick="OpenAddPanel">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m-7-7h14" /></svg>
                    @T["Versions_AddTranslation"]
                </button>
            }
            <button type="button" class="inline-flex items-center px-3.5 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg transition-colors disabled:opacity-50"
                    disabled="@busy" @onclick="OpenLinkPanelAsync">@T["Versions_LinkExisting"]</button>
            @if (Versions.Count > 1)
            {
                <button type="button" class="inline-flex items-center px-3.5 py-2 text-gray-600 hover:text-red-600 text-sm font-medium rounded-lg transition-colors disabled:opacity-50"
                        disabled="@busy" @onclick="() => UnlinkAsync(MenuId)">@T["Versions_UnlinkThis"]</button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid MenuId { get; set; }
    /// <summary>The versions of the group in language order, this menu included (<see cref="IMenuTranslationService.GetVersionsAsync"/>).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<MenuVersion> Versions { get; set; } = Array.Empty<MenuVersion>();
    /// <summary>"Add translation" creates a menu: needs <see cref="Permission.MenusCreate"/>.</summary>
    [Parameter] public bool CanCreate { get; set; }
    /// <summary>After a link or unlink: the parent reloads <see cref="Versions"/> (and the preview).</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private enum Panel { None, Add, Link }

    private Panel panel;
    private bool busy;
    private string? error;
    private MenuLanguage newLanguage;
    private string linkMenuIdText = "";
    private IReadOnlyList<MenuVersion> candidates = Array.Empty<MenuVersion>();

    /// <summary>Languages the group does not have yet, in enum order.</summary>
    private IReadOnlyList<MenuLanguageInfo> FreeLanguages =>
        MenuLanguages.All.Where(l => Versions.All(v => v.Language != l.Language)).ToList();

    private void OpenAddPanel()
    {
        error = null;
        var free = FreeLanguages;
        if (free.Count == 0) return;
        // English first when it is free (the usual second language), else the first free one
        newLanguage = free.FirstOrDefault(l => l.Language == MenuLanguage.English)?.Language ?? free[0].Language;
        panel = Panel.Add;
    }

    private async Task OpenLinkPanelAsync()
    {
        error = null;
        candidates = await Translations.GetLinkCandidatesAsync(MenuId);
        if (candidates.Count == 0)
        {
            error = T["Versions_NothingToLink"];
            return;
        }
        linkMenuIdText = candidates[0].Id.ToString();
        panel = Panel.Link;
    }

    private void ClosePanel()
    {
        panel = Panel.None;
        error = null;
    }

    private async Task CreateTranslationAsync()
    {
        busy = true;
        error = null;
        try
        {
            var result = await Translations.CreateTranslationAsync(MenuId, newLanguage);
            if (!result.Succeeded)
            {
                error = result.Error;
                return;
            }
            panel = Panel.None;
            // The copy's settings: translate its name and description; the categories and items follow from there
            NavManager.NavigateTo($"/menu/edit/{result.MenuId}");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LinkAsync()
    {
        busy = true;
        error = null;
        try
        {
            if (!Guid.TryParse(linkMenuIdText, out var linkMenuId))
                return;
            var result = await Translations.LinkAsync(MenuId, linkMenuId);
            if (!result.Succeeded)
            {
                error = result.Error;
                return;
            }
            panel = Panel.None;
            await OnChanged.InvokeAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task UnlinkAsync(Guid menuId)
    {
        busy = true;
        error = null;
        try
        {
            var result = await Translations.UnlinkAsync(menuId);
            if (!result.Succeeded)
            {
                error = result.Error;
                return;
            }
            await OnChanged.InvokeAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
