<!-- ComplexMenuDisplayMenuItemOverlayComp.razor -->
@if (SelectedItem != null)
{
    <!-- Modal Backdrop -->
    <div class="fixed inset-0 z-[9999] bg-black bg-opacity-50 overflow-y-auto" @onclick="CloseModal">
        <div class="min-h-full flex flex-col items-center justify-start pt-[env(safe-area-inset-top,2rem)] " @onclick:stopPropagation>

        <!-- Modal Content -->
            <div class="bg-white max-w-2xl w-full rounded-xl shadow-lg overflow-hidden" style="max-width:500px;" @onclick:stopPropagation>

            <!-- Header -->
            <div class="px-4 py-4 flex items-center justify-between border-b sticky top-0 bg-white z-10">
                <button @onclick="CloseModal" class="p-2 -ml-2">
                    <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                </button>
                <h1 class="font-bold text-lg text-gray-900 truncate mx-4">@SelectedItem.Name</h1>
                <div class="w-6 h-6" /> <!-- Spacer for symmetry -->
            </div>

            <!-- Item Image -->
            <div class="aspect-square bg-gradient-to-br from-orange-100 to-green-100 relative">
                @if (!string.IsNullOrEmpty(SelectedItem.ImagePath))
                {
                    <img src="@SelectedItem.ImagePath" alt="@SelectedItem.Name" class="w-full h-full object-cover" />
                }
                else
                {
                    <div class="absolute inset-0 flex items-center justify-center">
                        <div class="w-48 h-48 bg-teal-100 rounded-full flex items-center justify-center border-8 border-yellow-200 shadow-xl">
                            <div class="text-6xl">🥙</div>
                        </div>
                    </div>
                }
            </div>

            <!-- Item Details -->
            <div class="p-6 mb-4">
                <div class="mb-4">
                    <span class="text-sm text-gray-500 uppercase tracking-wide">@(SelectedItem.Category?.Name ?? "KATEGORIE")</span>
                </div>

                <h1 class="text-2xl font-bold text-gray-900 mb-4">@SelectedItem.Name</h1>

                <p class="text-gray-700 mb-4 leading-relaxed">@SelectedItem.Description</p>

                <DietaryBadges Item="SelectedItem" Large="true" Class="mb-6" />

                <div class="flex justify-between items-center">
                    <span class="text-2xl font-bold text-gray-900">€ @SelectedItem.Price.ToString("F2")</span>
                    @if (SelectedItem.Allergens.Any())
                    {
                        <span class="text-sm text-gray-500 bg-gray-100 px-3 py-1 rounded-full">@string.Join(", ", SelectedItem.Allergens.OrderBy(a => a.Code).Select(a => a.Code))</span>
                    }
                </div>

                @if (SelectedItem.Allergens.Any())
                {
                    <!-- Allergen legend: codes with their names -->
                    <div class="mt-4 pt-4 border-t border-gray-100" data-testid="allergen-legend">
                        <h2 class="text-xs text-gray-500 uppercase tracking-wide mb-2">Allergene</h2>
                        <ul class="text-sm text-gray-600 space-y-1">
                            @foreach (var allergen in SelectedItem.Allergens.OrderBy(a => a.Code))
                            {
                                <li class="flex gap-2">
                                    <span class="font-semibold text-gray-800 w-5">@allergen.Code</span>
                                    <span>@allergen.Name</span>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (Combos.Any())
                {
                    <!-- Combo offers triggered by this item -->
                    <div class="mt-8 pt-6 border-t border-gray-200">
                        <h2 class="text-lg font-bold text-gray-900 mb-3">Kombi-Angebote</h2>
                        <div class="space-y-3">
                            @foreach (var combo in Combos)
                            {
                                var includedItems = combo.Items
                                    .Where(i => i.MenuItem != null)
                                    .Select(i => i.MenuItem!)
                                    .OrderBy(mi => mi.Name)
                                    .ToList();
                                var singlePriceSum = includedItems.Sum(mi => mi.Price);

                                <div class="bg-teal-50 border border-teal-200 rounded-xl p-4" @key="combo.Id">
                                    <div class="flex justify-between items-start gap-3 mb-1">
                                        <h3 class="font-bold text-gray-900 text-base leading-tight">@combo.Name</h3>
                                        <div class="text-right flex-shrink-0">
                                            <span class="font-bold text-teal-700 text-base">€ @combo.ComboPrice.ToString("F2")</span>
                                            @if (singlePriceSum > combo.ComboPrice)
                                            {
                                                <div class="text-xs text-gray-500">
                                                    einzeln <span class="line-through">€ @singlePriceSum.ToString("F2")</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(combo.Description))
                                    {
                                        <p class="text-gray-600 text-sm mb-2 leading-relaxed">@combo.Description</p>
                                    }
                                    @if (includedItems.Any())
                                    {
                                        <ul class="text-sm text-gray-700 space-y-1">
                                            @foreach (var mi in includedItems)
                                            {
                                                <li class="flex justify-between gap-2">
                                                    <span>• @mi.Name</span>
                                                    <span class="text-gray-500">€ @mi.Price.ToString("F2")</span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    @if (singlePriceSum > combo.ComboPrice)
                                    {
                                        <span class="inline-block mt-3 text-xs font-medium text-white bg-teal-600 px-2 py-1 rounded-full">
                                            Sie sparen € @((singlePriceSum - combo.ComboPrice).ToString("F2"))
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
    </div>
}


@code{
    [Parameter]
    public MenuItem? SelectedItem { get; set; }
    [Parameter]
    public EventCallback<MenuItem?> SelectedItemChanged { get; set; }
    /// <summary>Combos whose trigger is <see cref="SelectedItem"/> (included items with <c>MenuItem</c> loaded).</summary>
    [Parameter]
    public List<MenuCombo> Combos { get; set; } = new();

    private async Task CloseModal()
    {
        await SelectedItemChanged.InvokeAsync(null);
    }
}