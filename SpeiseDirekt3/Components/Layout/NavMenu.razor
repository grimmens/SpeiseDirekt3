@implements IDisposable
@inject NavigationManager NavigationManager

@* The primary navigation (ShellNavigation.Items): the top bar's links from 1024 px (Variant "bar") and the list in
   the phone drawer (Variant "drawer", with icons). The entry of the current page carries aria-current="page". *@
<nav class="@(Drawer ? "sd-drawer-nav" : "sd-topnav")" aria-label="@AriaLabel" data-testid="@(Drawer ? "drawer-nav" : "top-nav")">
    <ul role="list">
        @foreach (var item in ShellNavigation.Items)
        {
            var active = item.Key == section;
            <li>
                <a href="@(item.Href.Length == 0 ? "/" : item.Href)"
                   class="@(Drawer ? "sd-drawer-link" : "sd-topnav-link")"
                   aria-current="@(active ? "page" : null)"
                   data-nav="@item.Key">
                    @if (Drawer)
                    {
                        <svg class="sd-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="@item.IconPath" />
                        </svg>
                    }
                    <span>@item.Label</span>
                </a>
            </li>
        }
    </ul>
</nav>

@code {
    /// <summary>"bar" (top bar) or "drawer" (phone drawer).</summary>
    [Parameter] public string Variant { get; set; } = "bar";

    [Parameter] public string AriaLabel { get; set; } = "Main";

    private bool Drawer => Variant == "drawer";

    private string? section;

    protected override void OnInitialized()
    {
        section = ShellNavigation.SectionOf(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var next = ShellNavigation.SectionOf(NavigationManager.ToBaseRelativePath(e.Location));
        if (next == section) return;
        section = next;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
