@* The user menu at the right of the top bar (from 1024 px): initials, name and role; the dropdown repeats them with
   the e-mail and offers "Account settings" and "Log out". A disclosure button driven by js/shell.js (works on the
   static Identity pages too): click toggles, Escape and a click outside close it, focus returns to the button. *@
<div class="sd-dropdown sd-user" data-sd-dropdown>
    <button type="button" class="sd-user-button" id="sd-user-button"
            aria-expanded="false" aria-controls="sd-user-menu"
            title="@User.Title" data-sd-dropdown-toggle data-testid="user-menu-button">
        <span class="sd-avatar" aria-hidden="true">@User.Initials</span>
        <span class="sd-user-text">
            <span class="sd-user-name" data-testid="user-name">@User.Name</span>
            @if (!string.IsNullOrEmpty(User.Role))
            {
                <span class="sd-user-role" data-testid="user-role">@User.Role</span>
            }
        </span>
        <span class="sd-sr-only">@T["UserMenuHint"]</span>
        <svg class="sd-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
    </button>
    <div class="sd-menu sd-menu--end" id="sd-user-menu" hidden data-sd-dropdown-panel data-testid="user-menu">
        <div class="sd-menu-header">
            <span class="sd-avatar sd-avatar--lg" aria-hidden="true">@User.Initials</span>
            <span class="sd-menu-header-text">
                <span class="sd-menu-title">@User.Name</span>
                @if (User.DisplayName is not null)
                {
                    <span class="sd-menu-meta">@User.Email</span>
                }
                @if (!string.IsNullOrEmpty(User.Role))
                {
                    <span class="sd-badge">@User.Role</span>
                }
            </span>
        </div>
        <div class="sd-menu-sep" role="separator"></div>
        <a href="Account/Manage" class="sd-menu-item" data-testid="account-settings-link">
            <svg class="sd-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>@T["AccountSettings"]</span>
        </a>
        <LogoutForm ButtonClass="sd-menu-item sd-menu-item--danger" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ShellUser User { get; set; } = default!;

    [Inject] private IStringLocalizer<ShellText> T { get; set; } = default!;
}
