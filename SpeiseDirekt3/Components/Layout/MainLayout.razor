@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject SpeiseDirekt.ServiceInterface.IPermissionService PermissionService
@inject IStringLocalizer<ShellText> T
@inject IStringLocalizer<CommonText> C

@* The back-office shell (css/shell.css, js/shell.js): a sticky top bar with the primary navigation and the user menu
   (from 1024 px), a menu button + drawer below; the menu context bar on the pages of one menu; the page gutter.
   Also used by the static Identity pages under /Account — so the chrome's behaviour is plain JS, not Blazor events. *@
<a href="#sd-main" class="sd-skip-link" data-sd-skip>@T["SkipToContent"]</a>

<header class="sd-topbar" data-testid="topbar">
    <div class="sd-container sd-topbar-inner">
        @if (user is not null)
        {
            <button type="button" class="sd-icon-button sd-icon-button--on-dark sd-menu-button" aria-label="@T["OpenNavigation"]"
                    aria-expanded="false" aria-controls="sd-nav-drawer" data-sd-drawer-open data-testid="nav-drawer-button">
                <svg class="sd-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
        }
        <a href="@(user is null ? "/" : "/dashboard")" class="sd-brand" aria-label="@(user is null ? T["BrandToHome"] : T["BrandToDashboard"])" data-testid="brand-link">
            <BrandLogo Inverse="true" Height="32" Alt="" />
        </a>
        @if (user is not null)
        {
            <NavMenu Variant="bar" Permissions="user.Permissions" />
            <UserMenu User="user" />
        }
        else
        {
            <nav class="sd-anon-nav" aria-label="@T["AccountNavLabel"]" data-testid="anonymous-nav">
                <a href="Account/Login" class="sd-anon-link">@T["LogIn"]</a>
                <a href="Account/Register" class="sd-anon-cta">@T["Register"]</a>
            </nav>
        }
    </div>
</header>

@if (user is not null)
{
    <NavDrawer User="user" />
}

<main id="sd-main" class="sd-main" tabindex="-1">
    <MenuContextBar />
    <div class="sd-page">
        <div class="max-w-7xl mx-auto px-[1rem] sm:px-6 lg:px-8">
            @Body
        </div>
    </div>
</main>

<SpeiseDirekt3.Components.Shared.ConfirmationModal />

@* Status messages for screen readers (js/sortable-list.js: "Moved Desserts to position 3 of 4.") and the description of
   every drag handle (Shared/Sortable/SortableList). Blazor never renders content into the live region; scripts set it. *@
<div id="sd-announcer" class="sd-sr-only" role="status" aria-live="polite" aria-atomic="true" data-testid="sd-announcer"></div>
<span id="sd-sort-help" hidden>@T["Sort_Help"]</span>

<!-- Error UI (shown by blazor.web.js) -->
<div id="blazor-error-ui" role="alert" data-nosnippet>
    <div class="sd-container sd-error-inner">
        <svg class="sd-icon sd-error-icon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <span class="sd-error-text">@T["Error_Unhandled"]</span>
        <a href="." class="sd-error-reload">@T["Error_Reload"]</a>
        <button type="button" class="sd-error-dismiss" aria-label="@T["Error_Dismiss"]" onclick="document.getElementById('blazor-error-ui').style.display='none'">×</button>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>The signed-in user for the chrome; null for anonymous visitors (Identity pages).</summary>
    private ShellUser? user;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;
        var principal = (await AuthState).User;
        if (principal.Identity?.IsAuthenticated != true) return;

        var email = principal.Identity.Name ?? "";
        // Owner, manager (an active team member) or none: the role's name and the navigation's entries
        var role = await PermissionService.GetCurrentRoleAsync();
        var permissions = await PermissionService.GetCurrentPermissionsAsync();
        var roleName = role is { } r ? RoleName(r) : null;
        var tenantOwnerId = principal.FindFirstValue("TenantOwnerId");
        if (string.IsNullOrEmpty(tenantOwnerId))
        {
            user = new ShellUser(email, null, roleName, permissions);
            return;
        }

        // Sub-account: show the name the owner gave it (falls back to the e-mail)
        var userId = principal.FindFirstValue(ClaimTypes.NameIdentifier);
        await using var db = await DbFactory.CreateDbContextAsync();
        var displayName = await db.TenantUsers.AsNoTracking()
            .Where(tu => tu.ApplicationUserId == userId && tu.TenantOwnerId == tenantOwnerId)
            .Select(tu => tu.DisplayName)
            .FirstOrDefaultAsync();
        user = new ShellUser(email, string.IsNullOrWhiteSpace(displayName) ? null : displayName, roleName, permissions);
    }

    /// <summary>The role's display name (CommonText Role_*, shared with the team pages).</summary>
    private string RoleName(TenantRole role) => C[$"Role_{role}"];
}
