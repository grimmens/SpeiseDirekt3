@* <title> and <head> meta of a guest menu page: description, canonical link and Open Graph tags for link previews
   (messengers, social networks). Every URL points to the public page /menu/{id} (also from /qr/… and the owner
   preview; the demo's is /demo); a page with ?item= describes that item. The owner preview and the demo are noindex.
   Language: og:locale of the menu's language; public pages of a menu with language versions also list every version
   (this one included) as <link rel="alternate" hreflang> and og:locale:alternate — not the preview. Texts of our own
   (the "Speisekarte"/"Menu" suffix) follow the UI language (GuestText).
   Absolute URLs use the origin the guest's browser sees (GuestFormat.PublicOrigin: the request after UseForwardedHeaders). *@
@using Microsoft.AspNetCore.Http
@{
    var menu = Model.Menu;
    var profile = Model.Profile;
    var item = Model.SelectedItem;
    var origin = GuestFormat.PublicOrigin(HttpContext?.Request);
    var text = Model.Text;

    var pageTitle = item is not null
        ? $"{item.Name} – {Model.SiteName}"
        : Model.ShowsRestaurantName ? $"{menu.Name} – {profile!.Name}" : $"{menu.Name} – {text.MenuWord}";

    var description = item is not null
        ? string.Join(" · ", new[] { item.Description, text.ItemPrice(item) }.Where(s => !string.IsNullOrWhiteSpace(s)))
        : FirstText(menu.Description, profile?.Description) ?? text.MenuOf(Model.SiteName);
    description = GuestFormat.Excerpt(description);

    var path = item is not null ? GuestFormat.ItemUrl(Model.PublicPath, item.Id) : Model.PublicPath;
    var url = GuestFormat.Absolute(origin, path);

    // Item page: its photo; menu: the cover, else the first dish photo
    var imagePath = (item is not null ? GuestFormat.ImageUrl(item.ImagePath) : null)
                    ?? GuestFormat.ImageUrl(profile?.CoverImagePath)
                    ?? Model.AllItems.Select(i => GuestFormat.ImageUrl(i.ImagePath)).FirstOrDefault(i => i is not null);
    var image = GuestFormat.Absolute(origin, imagePath);
}
<PageTitle>@pageTitle</PageTitle>
<HeadContent>
    @* Browser UI (scrollbars, form controls) before the CSS applies; the colors themselves live in guest-themes.css *@
    <meta name="color-scheme" content="@(Model.ThemeKey == "dark" ? "dark" : "light")" />
    <meta name="description" content="@description" />
    @if (Model.NoIndex)
    {
        <meta name="robots" content="noindex" />
    }
    @if (url is not null)
    {
        <link rel="canonical" href="@url" />
        <meta property="og:url" content="@url" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="@Model.Language.OgLocale" />
    @if (!Model.NoIndex && Model.HasLanguageVersions)
    {
        foreach (var version in Model.Versions)
        {
            if (GuestFormat.Absolute(origin, version.PublicPath) is { } alternate)
            {
                <link rel="alternate" hreflang="@version.Language.Code" href="@alternate" />
            }
            if (!version.IsCurrent)
            {
                <meta property="og:locale:alternate" content="@version.Language.OgLocale" />
            }
        }
    }
    <meta property="og:site_name" content="@Model.SiteName" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@description" />
    @if (image is not null)
    {
        <meta property="og:image" content="@image" />
        <meta name="twitter:card" content="summary_large_image" />
    }
</HeadContent>

@code {
    [Parameter, EditorRequired] public GuestMenuModel Model { get; set; } = default!;

    /// <summary>The request (static SSR); null outside one.</summary>
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private static string? FirstText(params string?[] texts) => texts.FirstOrDefault(t => !string.IsNullOrWhiteSpace(t));
}
