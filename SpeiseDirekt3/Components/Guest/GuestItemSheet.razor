@* The item sheet (<dialog data-sheet="item">) plus one <template data-item-template="<id>"> per item with its
   server-rendered detail (GuestItemDetail). guest-menu.js clones the template into [data-sheet-body] and opens
   the sheet; no markup is built in JS.
   ?item=<id> (deep link, or a card click without JS): the server renders the sheet open (non-modal <dialog open>
   plus a scrim link); the close links lead back to the plain page at the item's card. With JS the sheet becomes
   modal right away. The heart next to the close button toggles the shown item in the favourites list (JS only). *@
@{
    var selected = Model.SelectedItem;
}
<dialog class="gm-sheet gm-sheet--item" data-sheet="item" data-testid="item-sheet" aria-modal="true"
        aria-labelledby="@(selected is null ? null : GuestFormat.ItemTitleId(selected.Id))"
        data-item-id="@selected?.Id" open="@(selected is not null)">
    <div class="gm-sheet-panel">
        <div class="gm-sheet-handle" aria-hidden="true"></div>
        <a class="gm-iconbtn gm-sheet-close gm-sheet-close--float" href="@CloseHref(selected)" data-sheet-close aria-label="@T.Close">
            <GuestIcon Name="close" />
        </a>
        @* Heart for the item shown (js/guest-favorites.js sets data-fav-item and the labels on every item open). After
           the close link in the DOM, so opening the sheet focuses "Schließen", not the heart. *@
        <button type="button" class="gm-iconbtn gm-fav gm-sheet-fav" data-js-only data-fav-toggle data-fav-sheet
                data-fav-item="@selected?.Id" aria-pressed="false"
                aria-label="@(selected is null ? T.FavoriteDefault : T.FavoriteAdd(selected.Name))"
                data-label-add="@(selected is null ? null : T.FavoriteAdd(selected.Name))"
                data-label-remove="@(selected is null ? null : T.FavoriteRemove(selected.Name))"
                data-testid="item-favorite-button">
            <GuestIcon Name="heart" />
        </button>
        <div class="gm-sheet-body" data-sheet-body>
            @if (selected is not null)
            {
                <GuestItemDetail Item="selected" CategoryName="@Model.CategoryOf(selected)?.Category.Name" Combos="Model.CombosFor(selected)" />
            }
        </div>
    </div>
</dialog>
@if (selected is not null)
{
    <a class="gm-scrim" href="@CloseHref(selected)" data-scrim tabindex="-1" aria-hidden="true"></a>
}
<div class="gm-templates" hidden>
    @foreach (var category in Model.Categories)
    {
        foreach (var item in category.Items)
        {
            <template data-item-template="@item.Id" @key="item.Id">
                <GuestItemDetail Item="item" CategoryName="@category.Category.Name" Combos="Model.CombosFor(item)" />
            </template>
        }
    }
</div>

@code {
    /// <summary>UI texts and price notation of the menu (cascading from GuestMenuView; German by default).</summary>
    [CascadingParameter] public GuestText T { get; set; } = GuestText.German;
    [Parameter, EditorRequired] public GuestMenuModel Model { get; set; } = default!;

    /// <summary>Without JS: back to the plain page, scrolled to the item's card.</summary>
    private string CloseHref(MenuItem? item) =>
        item is null ? Model.BasePath : $"{Model.BasePath}#{GuestFormat.ItemAnchor(item.Id)}";
}
