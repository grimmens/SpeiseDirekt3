@* Inline SVG icons of the guest view (24 × 24 grid, stroke = currentColor, size via CSS .gm-icon).
   Add an icon with one more case. Decorative: hidden from assistive technology, the button carries the aria-label. *@
<svg class="gm-icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="@StrokeWidth"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "search":
            <circle cx="11" cy="11" r="6.5" />
            <path d="M20 20l-4.2-4.2" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6L6 18" />
            break;
        case "chevron-down":
            <path d="M6 9l6 6 6-6" />
            break;
        case "leaf":
            <path d="M5 19c.5-8.5 5.5-13.5 15-14-.5 9.5-5.5 14.5-14 15z" />
            <path d="M5 19l8.5-8.5" />
            break;
        case "flame":
            <path d="M12 3c.6 3.4 4.5 5.2 4.5 9.6a4.5 4.5 0 0 1-9 0c0-2.3 1.2-3.8 2.3-4.8.2 1.6 1 2.6 1.8 3 .6-2.8-.9-5 .4-7.8z" />
            break;
        case "info":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5M12 8h.01" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
            break;
        @* --- AP3: labels, restaurant info, share --- *@
        case "star":
            <path d="M12 3.6l2.55 5.2 5.7.83-4.12 4.02.97 5.68L12 16.65l-5.1 2.68.97-5.68-4.12-4.02 5.7-.83z" />
            break;
        case "sparkle":
            <path d="M12 3c.7 4.4 3.1 6.9 7.5 7.6v.8c-4.4.7-6.8 3.2-7.5 7.6h-.8c-.7-4.4-3.1-6.9-7.5-7.6v-.8C8.1 9.9 10.5 7.4 11.2 3z" />
            break;
        case "glass-off":
            <path d="M8 3.5h8l-.6 5.2a3.4 3.4 0 0 1-6.8 0z" />
            <path d="M12 12.2V20M8.8 20h6.4" />
            <path d="M4 4l16 16" />
            break;
        case "map-pin":
            <path d="M12 21s-6.5-5.8-6.5-11a6.5 6.5 0 0 1 13 0c0 5.2-6.5 11-6.5 11z" />
            <circle cx="12" cy="10" r="2.4" />
            break;
        case "phone":
            <path d="M6.2 3.8h2.6l1.6 4.1-2 1.4a11.5 11.5 0 0 0 6.3 6.3l1.4-2 4.1 1.6v2.6a1.7 1.7 0 0 1-1.8 1.7A15.6 15.6 0 0 1 4.5 5.6a1.7 1.7 0 0 1 1.7-1.8z" />
            break;
        case "mail":
            <rect x="3.5" y="5.5" width="17" height="13" rx="2" />
            <path d="M4 7l8 6 8-6" />
            break;
        case "globe":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M3.5 12h17M12 3.5c2.3 2.4 3.4 5.2 3.4 8.5s-1.1 6.1-3.4 8.5c-2.3-2.4-3.4-5.2-3.4-8.5S9.7 5.9 12 3.5z" />
            break;
        case "instagram":
            <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
            <circle cx="12" cy="12" r="3.8" />
            <path d="M17 7h.01" />
            break;
        case "facebook":
            <path d="M14.5 20.5v-7h2.6l.4-3h-3V8.8c0-.9.3-1.5 1.6-1.5h1.5V4.6a19 19 0 0 0-2.3-.1c-2.3 0-3.8 1.4-3.8 4v2h-2.6v3h2.6v7" />
            break;
        case "share":
            <path d="M12 14.5V3.5M8 7.5l4-4 4 4" />
            <path d="M8 10.5H6.5a1.5 1.5 0 0 0-1.5 1.5v7a1.5 1.5 0 0 0 1.5 1.5h11a1.5 1.5 0 0 0 1.5-1.5v-7a1.5 1.5 0 0 0-1.5-1.5H16" />
            break;
        case "external":
            <path d="M13.5 4.5h6v6M19.5 4.5l-8 8M17.5 13.5v4.5a1.5 1.5 0 0 1-1.5 1.5H6a1.5 1.5 0 0 1-1.5-1.5V8A1.5 1.5 0 0 1 6 6.5h4.5" />
            break;
        case "chevron-right":
            <path d="M9 6l6 6-6 6" />
            break;
        case "check":
            <path d="M5 12.5l4.5 4.5L19 7.5" />
            break;
    }
</svg>

@code {
    /// <summary>search, close, chevron-down, leaf, flame, info, clock, star, sparkle, glass-off, map-pin, phone, mail,
    /// globe, instagram, facebook, share, external, chevron-right, check</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    /// <summary>SVG stroke width as written in the attribute (a string, so no culture-specific decimal comma).</summary>
    [Parameter] public string StrokeWidth { get; set; } = "2";
}
