@* Inline SVG icons of the guest view (24 × 24 grid, stroke = currentColor, size via CSS .gm-icon).
   Add an icon with one more case. Decorative: hidden from assistive technology, the button carries the aria-label. *@
<svg class="gm-icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="@StrokeWidth"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        @* AP4: favourites, filter, favourites list *@
        case "heart":
            <path d="M12 20.3C5.6 15.9 3.5 12.6 3.5 9.6 3.5 6.9 5.6 5 8 5c1.6 0 3 .8 4 2.2C13 5.8 14.4 5 16 5c2.4 0 4.5 1.9 4.5 4.6 0 3-2.1 6.3-8.5 10.7z" />
            break;
        case "sliders":
            <path d="M4 7h9M17 7h3M4 17h3M11 17h9" />
            <circle cx="15" cy="7" r="2" />
            <circle cx="9" cy="17" r="2" />
            break;
        case "trash":
            <path d="M5 7h14M10 7V5h4v2M7 7l1 12h8l1-12M10.5 11v5M13.5 11v5" />
            break;
        case "minus":
            <path d="M6 12h12" />
            break;
        case "plus":
            <path d="M12 6v12M6 12h12" />
            break;
        case "search":
            <circle cx="11" cy="11" r="6.5" />
            <path d="M20 20l-4.2-4.2" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6L6 18" />
            break;
        case "chevron-down":
            <path d="M6 9l6 6 6-6" />
            break;
        case "leaf":
            <path d="M5 19c.5-8.5 5.5-13.5 15-14-.5 9.5-5.5 14.5-14 15z" />
            <path d="M5 19l8.5-8.5" />
            break;
        case "flame":
            <path d="M12 3c.6 3.4 4.5 5.2 4.5 9.6a4.5 4.5 0 0 1-9 0c0-2.3 1.2-3.8 2.3-4.8.2 1.6 1 2.6 1.8 3 .6-2.8-.9-5 .4-7.8z" />
            break;
        case "info":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5M12 8h.01" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
            break;
    }
</svg>

@code {
    /// <summary>search, close, chevron-down, leaf, flame, info, clock</summary>
    /// <remarks>Also: heart, sliders, trash, minus, plus (search, filter and favourites).</remarks>
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    /// <summary>SVG stroke width as written in the attribute (a string, so no culture-specific decimal comma).</summary>
    [Parameter] public string StrokeWidth { get; set; } = "2";
}
