@* Content of the item sheet for one item: photo, category, name, description, labels, price, allergen legend,
   combo offers. Rendered by the server twice per page at most: inside a <template> per item (guest-menu.js clones
   it into the item sheet) and directly in the open sheet for ?item=. Extend it here (variants, extras, share). *@
@{
    var image = GuestFormat.ImageUrl(Item.ImagePath);
    var allergens = Item.Allergens.OrderBy(a => a.Code, StringComparer.Ordinal).ToList();
}
<article class="gm-detail @(image is null ? "gm-detail--noimage" : null)" data-testid="item-detail" data-item-id="@Item.Id">
    @if (image is not null)
    {
        <div class="gm-detail-media">
            <img src="@image" alt="@Item.Name" width="600" height="750" decoding="async" />
        </div>
    }
    <div class="gm-detail-body">
        @if (!string.IsNullOrEmpty(CategoryName))
        {
            <p class="gm-detail-category">@CategoryName</p>
        }
        <h2 class="gm-detail-title" id="@GuestFormat.ItemTitleId(Item.Id)">@Item.Name</h2>
        @if (!string.IsNullOrWhiteSpace(Item.Description))
        {
            <p class="gm-detail-desc">@Item.Description</p>
        }
        <GuestLabelChips Item="Item" Large="true" />
        <div class="gm-detail-price-row">
            <span class="gm-price gm-price--lg" data-testid="item-price">@GuestFormat.ItemPrice(Item)</span>
            @if (allergens.Count > 0)
            {
                <span class="gm-allergen-codes gm-allergen-codes--pill" data-testid="item-allergens" title="Allergene">@GuestFormat.AllergenCodes(Item)</span>
            }
        </div>
        @ChildContent

        @if (allergens.Count > 0)
        {
            <section class="gm-detail-section" data-testid="allergen-legend" aria-label="Allergene">
                <h3 class="gm-detail-section-title">Allergene</h3>
                <ul class="gm-legend">
                    @foreach (var allergen in allergens)
                    {
                        <li><span class="gm-legend-code">@allergen.Code</span><span>@allergen.Name</span></li>
                    }
                </ul>
            </section>
        }

        @if (Combos.Count > 0)
        {
            <section class="gm-detail-section" data-testid="combo-offers" aria-label="Kombi-Angebote">
                <h3 class="gm-detail-section-title">Kombi-Angebote</h3>
                @foreach (var combo in Combos)
                {
                    var included = combo.Items.Where(i => i.MenuItem != null).Select(i => i.MenuItem!).OrderBy(mi => mi.Name).ToList();
                    var singleSum = included.Sum(mi => mi.Price);
                    <div class="gm-combo" data-testid="combo" @key="combo.Id">
                        <div class="gm-combo-head">
                            <h4 class="gm-combo-name">@combo.Name</h4>
                            <div class="gm-combo-prices">
                                <span class="gm-price gm-combo-price">@GuestFormat.Price(combo.ComboPrice)</span>
                                @if (singleSum > combo.ComboPrice)
                                {
                                    <span class="gm-combo-single">einzeln <del>@GuestFormat.Price(singleSum)</del></span>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(combo.Description))
                        {
                            <p class="gm-combo-desc">@combo.Description</p>
                        }
                        @if (included.Count > 0)
                        {
                            <ul class="gm-combo-items">
                                @foreach (var mi in included)
                                {
                                    <li><span>@mi.Name</span><span class="gm-price">@GuestFormat.Price(mi.Price)</span></li>
                                }
                            </ul>
                        }
                        @if (singleSum > combo.ComboPrice)
                        {
                            <span class="gm-combo-saving">Sie sparen @GuestFormat.Price(singleSum - combo.ComboPrice)</span>
                        }
                    </div>
                }
            </section>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public MenuItem Item { get; set; } = default!;
    [Parameter] public string? CategoryName { get; set; }
    /// <summary>Combos this item triggers (<see cref="GuestMenuModel.CombosFor"/>).</summary>
    [Parameter] public IReadOnlyList<MenuCombo> Combos { get; set; } = Array.Empty<MenuCombo>();
    /// <summary>Extra content after the price row (e.g. variants, extras, share button).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
