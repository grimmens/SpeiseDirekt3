@* One item in a photo category (grid). The whole card is a link to ?item=<id> (opens the item sheet; without JS
   the server renders it open). Items without a photo render as a text card in the same grid.
   The data-* attributes describe the item for scripts (search/filter/favourites):
   data-item-id, data-category-id, data-labels ("vegan spicy"), data-allergens ("A C G"), data-price ("9.90"),
   data-has-image. The corner slot (data-slot="favorite") is reserved for the heart button and empty for now;
   it is a sibling of the link because interactive content must not be nested inside <a>. *@
@{
    var image = GuestFormat.ImageUrl(Item.ImagePath);
    var codes = GuestFormat.AllergenCodes(Item);
}
<li class="gm-card @(image is null ? "gm-card--text" : "gm-card--photo")" id="@GuestFormat.ItemAnchor(Item.Id)" data-testid="item-card"
    data-item-id="@Item.Id" data-category-id="@Item.CategoryId" data-labels="@GuestLabels.Data(Item)"
    data-allergens="@GuestFormat.AllergenData(Item)" data-price="@GuestFormat.PriceData(Item.Price)"
    data-has-image="@(image is null ? "false" : "true")">
    <a class="gm-card-link" href="@Href" data-item-link>
        @if (image is not null)
        {
            <div class="gm-card-media">
                <img src="@image" alt="" width="600" height="750" loading="lazy" decoding="async" />
            </div>
        }
        <div class="gm-card-body">
            <h3 class="gm-card-title">@Item.Name</h3>
            @if (!string.IsNullOrWhiteSpace(Item.Description))
            {
                <p class="gm-card-desc">@Item.Description</p>
            }
            <GuestLabelChips Item="Item" />
            <div class="gm-card-foot">
                <span class="gm-price" data-testid="item-price">@GuestFormat.ItemPrice(Item)</span>
                @if (codes.Length > 0)
                {
                    <span class="gm-allergen-codes" data-testid="item-allergens" title="Allergene">@codes</span>
                }
            </div>
        </div>
    </a>
    <div class="gm-card-corner" data-slot="favorite">@Corner</div>
</li>

@code {
    [Parameter, EditorRequired] public MenuItem Item { get; set; } = default!;
    /// <summary>Link that opens the item (<see cref="GuestMenuModel.ItemUrl"/>).</summary>
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    /// <summary>Content of the top-right corner over the photo (reserved for the heart button).</summary>
    [Parameter] public RenderFragment? Corner { get; set; }
}
