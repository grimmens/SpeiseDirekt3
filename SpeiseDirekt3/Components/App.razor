@using SpeiseDirekt3.Components.Guest
@implements IDisposable
@inject GuestDocument GuestDocument
<!DOCTYPE html>
@if (Document is PageDocument.Guest or PageDocument.Landing)
{
    @* Pages with their own document (OwnDocumentAttribute): the guest pages (/qr, /menu, /menu/preview — Components/Guest)
       and the landing page (/ — Components/Landing). Static SSR, own assets only, no Tailwind CDN, Bootstrap or
       blazor.web.js. No <base href>: every URL on these pages is absolute (fragment and ?item= links must stay on the page).
       lang: the guest menu's language (GuestDocument, set by GuestMenuView; "de" on notice pages — never the browser's),
       the landing page "de" (its copy is German). *@
    var guest = Document == PageDocument.Guest;
    <html lang="@(guest ? GuestDocument.Language : "de")" data-guest-page="@guest" data-landing-page="@(!guest)">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="@Assets.Absolute("css/fonts.css")" />
        @if (guest)
        {
            <link rel="stylesheet" href="@Assets.Absolute("css/guest-themes.css")" />
            <link rel="stylesheet" href="@Assets.Absolute("css/guest-menu.css")" />
            <script type="module" src="@Assets.Absolute("js/guest-menu.js")"></script>
        }
        else
        {
            <link rel="stylesheet" href="@Assets.Absolute("css/brand.css")" />
            <link rel="stylesheet" href="@Assets.Absolute("css/landing.css")" />
            <script type="module" src="@Assets.Absolute("js/landing.js")"></script>
            <meta name="theme-color" content="#fff8ec" />
        }
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <HeadOutlet />
    </head>
    <body class="@(guest ? "gm-body" : "lp-body")">
        <Routes />
    </body>
    </html>
}
else
{
@* lang: the request's language (AppCultures, from Accept-Language); an Interactive Server circuit keeps it *@
<html lang="@AppCultures.HtmlLang">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="_content/BytexDigital.Blazor.Components.CookieConsent/styles.min.css" />
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        // Brand palettes from css/brand.css (RGB channels), so opacity modifiers work: bg-brand-600/20. `gray` is the
        // back office's cool, brand-tinted gray (AP11, --sd-gray-*), `shadow-sm` the card shadow (--sd-shadow-card).
        (() => {
            const scale = name => Object.fromEntries([50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950]
                .map(step => [step, `rgb(var(--sd-${name}-${step}) / <alpha-value>)`]));
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            brand: scale('brand'),
                            primary: scale('brand'),
                            accent: scale('accent'),
                            gray: scale('gray')
                        },
                        boxShadow: {
                            sm: 'var(--sd-shadow-card)'
                        },
                        fontFamily: {
                            'sans': ['Inter', 'system-ui', 'sans-serif'],
                            'display': ['Manrope', 'system-ui', 'sans-serif'],
                        }
                    }
                }
            };
        })();
    </script>
    <!-- Fonts (self-hosted, wwwroot/fonts) -->
    <link rel="stylesheet" href="@Assets["css/fonts.css"]" />
    <!-- Brand tokens (css/brand.css) before everything that reads them -->
    <link rel="stylesheet" href="@Assets["css/brand.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["SpeiseDirekt3.styles.css"]" />
    <link rel="stylesheet" href="@Assets["css/tailwind-overrides.css"]" />
    <link rel="stylesheet" href="@Assets["css/shell.css"]" />
    <link rel="stylesheet" href="@Assets["css/back-office.css"]" />
    <!-- Bootstrap JS (required for modal to work) -->
    <script src="@Assets["lib/bootstrap/dist/js/bootstrap.bundle.min.js"]"></script>

    <!-- Chart.js 4.6.1 with date adapter 3.0.0 (local, wwwroot/lib/chartjs) -->
    <script src="@Assets["lib/chartjs/chart.umd.min.js"]"></script>
    <script src="@Assets["lib/chartjs/chartjs-adapter-date-fns.bundle.min.js"]"></script>

    <script src="js/speisedirekt.js"></script>
    <script src="js/analytics.js"></script>
    <ImportMap />
    <script src="@Assets["js/shell.js"]" defer></script>
    <link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <meta name="theme-color" content="#1b3d46" />
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>

<body>
    <Routes @rendermode="RenderModeForPage" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>
    /// Back-office pages are Interactive Server. Static SSR: the Identity pages under /Account and every page with
    /// [ExcludeFromInteractiveRouting] (the guest pages and the landing page).
    /// </summary>
    private IComponentRenderMode? RenderModeForPage =>
        HttpContext.Request.Path.StartsWithSegments("/Account") || !HttpContext.AcceptsInteractiveRouting()
            ? null
            : InteractiveServer;

    protected override void OnInitialized() => GuestDocument.Changed += OnGuestDocumentChanged;

    /// <summary>A guest page set its language after this component rendered: render &lt;html lang&gt; again.</summary>
    private void OnGuestDocumentChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => GuestDocument.Changed -= OnGuestDocumentChanged;

    /// <summary>
    /// The document of the page: its <see cref="OwnDocumentAttribute"/> (<see cref="GuestPageAttribute"/>,
    /// <see cref="SpeiseDirekt3.Components.Landing.LandingPageAttribute"/>), else the back office's.
    /// </summary>
    private PageDocument Document =>
        HttpContext.GetEndpoint()?.Metadata.GetMetadata<OwnDocumentAttribute>()?.Document ?? PageDocument.BackOffice;
}
