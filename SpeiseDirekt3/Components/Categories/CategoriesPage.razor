@page "/Categories/{MenuId}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using SpeiseDirekt3.Components.Categories.Components
@using SpeiseDirekt.Data
@using SpeiseDirekt.Model
@using SpeiseDirekt.Infrastructure
@using SpeiseDirekt.ServiceInterface
@attribute [Authorize]

<PageTitle>Categories</PageTitle>

<div class="max-w-6xl mx-auto p-4 sm:p-6 space-y-6">

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-600" aria-label="breadcrumb">
        <ol class="flex flex-wrap gap-y-1 space-x-2">
            <li>
                <a href="/menus" class="text-blue-600 hover:underline">Menus</a>
                <span class="mx-2">/</span>
            </li>
            <li>
                <a href="@($"/menudetail/{MenuId}")" class="text-blue-600 hover:underline">@menu?.Name</a>
                <span class="mx-2">/</span>
            </li>
            <li class="text-gray-800">Categories</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h1 class="text-3xl font-bold text-gray-900 font-display">Categories</h1>
        <p class="mt-2 text-gray-600">The sections of <strong>@menu?.Name</strong>. Guests see them in the order of this list.</p>
        <nav class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm" aria-label="Related pages" data-testid="category-links">
            <a href="@($"/MenuItems/{MenuId}")" class="font-medium text-blue-600 hover:underline">Menu items</a>
            <span class="text-gray-300" aria-hidden="true">·</span>
            <a href="@($"/allergens/{MenuId}")" class="font-medium text-blue-600 hover:underline">Allergens</a>
            <span class="text-gray-300" aria-hidden="true">·</span>
            <a href="@($"/combos/{MenuId}")" class="font-medium text-blue-600 hover:underline">Combos</a>
        </nav>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

        <!-- Categories List -->
        <div class="@(canCreate ? "lg:col-span-2" : "lg:col-span-3") bg-white rounded-xl shadow-sm border border-gray-200">
            <div class="px-4 sm:px-6 py-4 border-b border-gray-200 flex flex-wrap items-baseline justify-between gap-2">
                <h2 class="text-lg font-semibold text-gray-900">
                    Categories <span class="font-normal text-gray-400">(@Categories.Count)</span>
                </h2>
                @if (canEdit && Categories.Count > 1)
                {
                    <p class="text-xs text-gray-500">Use the arrows to change the order.</p>
                }
            </div>
            @if (Categories.Any())
            {
                <table class="w-full text-left" data-testid="category-list">
                    <thead class="sr-only">
                        <tr>
                            @if (canEdit)
                            {
                                <th>Order</th>
                            }
                            <th>Category</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @for (var i = 0; i < Categories.Count; i++)
                        {
                            var index = i;
                            var item = Categories[index];
                            <tr @key="item.Id" class="hover:bg-gray-50" data-testid="category-row">
                                @if (canEdit)
                                {
                                    <td class="pl-2 sm:pl-4 py-2 w-px whitespace-nowrap">
                                        <div class="flex items-center gap-0.5">
                                            <button type="button" title="Move up" aria-label="@($"Move {item.Name} up")"
                                                    class="p-2 rounded-md text-gray-500 hover:bg-gray-100 hover:text-gray-900 disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent transition-colors"
                                                    disabled="@(index == 0 || isMoving)" @onclick="() => MoveCategory(item, -1)">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                                                </svg>
                                            </button>
                                            <button type="button" title="Move down" aria-label="@($"Move {item.Name} down")"
                                                    class="p-2 rounded-md text-gray-500 hover:bg-gray-100 hover:text-gray-900 disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent transition-colors"
                                                    disabled="@(index == Categories.Count - 1 || isMoving)" @onclick="() => MoveCategory(item, 1)">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                                </svg>
                                            </button>
                                        </div>
                                    </td>
                                }
                                <td class="px-3 sm:px-4 py-3 min-w-0">
                                    <a href="@($"/MenuItems/Category/{item.Id}")" class="font-semibold text-blue-600 hover:underline hover:text-blue-800 break-words transition">@item.Name</a>
                                    <span class="block sm:inline sm:ml-2 text-sm text-gray-500" data-testid="category-item-count">@ItemCountText(item)</span>
                                </td>
                                <td class="pr-2 sm:pr-4 py-3 w-px whitespace-nowrap text-right">
                                    @if (canEdit || canDelete)
                                    {
                                        <SpeiseDirekt3.Components.HelperComp.ActionSubMenu Edit="canEdit ? () => EditCategory(item) : null"
                                                                                           Delete="canDelete ? () => DeleteCategory(item.Id) : null" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="px-6 py-10 text-center" data-testid="categories-empty">
                    <h3 class="text-base font-semibold text-gray-900">No categories yet</h3>
                    <p class="mt-1 text-sm text-gray-500">
                        Categories are the sections of the menu card, e.g. Starters, Mains, Desserts and Drinks.
                        @(canCreate ? "Add the first one with the form." : "")
                    </p>
                </div>
            }
        </div>

        @if (canCreate)
        {
            <!-- Add New Category Form -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200">
                <div class="px-4 sm:px-6 py-4 border-b border-gray-200">
                    <h2 class="text-lg font-semibold text-gray-900">Add New Category</h2>
                </div>
                <div class="p-4 sm:p-6">
                    <EditForm @ref="editForm" EditContext="editContext" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator />

                        <div class="mb-4">
                            <label for="Input.Name" class="block text-sm font-medium text-gray-700 mb-1">Category Name</label>
                            <InputText @bind-Value="Input.Name" id="Input.Name" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            <ValidationMessage For="() => Input.Name" class="text-red-600 text-sm mt-1" />
                            <p class="mt-1 text-xs text-gray-500">New categories are added at the end of the list.</p>
                        </div>

                        <button type="submit" class="w-full bg-blue-600 text-white font-medium py-2 rounded-lg hover:bg-blue-700 transition">
                            Add Category
                        </button>
                    </EditForm>
                </div>
            </div>
        }
    </div>
</div>

<!-- Category Editor Modal -->
<CategoryEditor @ref="categoryEditor" OnOk="HandleOk" OnCancel="HandleCancel" />


@code {
    [Parameter]
    public string MenuId { get; set; }

    [Inject]
    public ApplicationDbContext Context { get; set; }
    [Inject]
    public AuthenticationStateProvider AuthenticationStateProvider { get; set; }
    [Inject]
    public INotificationService NotificationService { get; set; }
    [Inject]
    public IPermissionService PermissionService { get; set; }

    List<Category> Categories { get; set; } = [];
    Dictionary<Guid, int> itemCounts = new();
    bool canCreate, canEdit, canDelete;
    bool isMoving;

    Category Input { get; set; } = new();
    CategoryEditor categoryEditor;
    Category? editingCategory;
    EditContext editContext = new EditContext(new Category());
    EditForm editForm;
    Menu? menu;

    Guid MenuGuid => Guid.Parse(MenuId);

    protected override Task OnParametersSetAsync()
    {
        editContext = new EditContext(Input);
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        canCreate = await PermissionService.HasPermissionAsync(Permission.CategoriesCreate);
        canEdit = await PermissionService.HasPermissionAsync(Permission.CategoriesEdit);
        canDelete = await PermissionService.HasPermissionAsync(Permission.CategoriesDelete);
        await LoadCategoriesAsync();
        Input = new()
            {
                MenuId = new Guid(MenuId)
            };
    }

    string ItemCountText(Category category)
    {
        var count = itemCounts.GetValueOrDefault(category.Id);
        return $"{count} item{(count == 1 ? "" : "s")}";
    }

    async Task SaveAsync()
    {
        if (!canCreate) return;
        try
        {
            editContext = new EditContext(Input);
            editForm.EditContext = editContext;
            if (!editContext.Validate())
                return;

            // Validate that we have a valid user context
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState?.User?.Identity?.IsAuthenticated != true)
            {
                var messages = new ValidationMessageStore(editContext);
                messages.Add(() => Input.Name, "You must be logged in to add categories.");
                editContext.NotifyValidationStateChanged();
                StateHasChanged();
                return;
            }

            var nameExists = await Context.Categories.AnyAsync(c => c.MenuId == Guid.Parse(MenuId) && c.Name == Input.Name);
            if (nameExists)
            {
                var messages = new ValidationMessageStore(editContext);
                messages.Add(() => Input.Name, "This name already exists.");
                editContext.NotifyValidationStateChanged();
                StateHasChanged();
                return;
            }

            // Ensure the Input has the correct MenuId; new categories go to the end
            Input.MenuId = new Guid(MenuId);
            Input.SortOrder = await Context.NextCategorySortOrderAsync(Input.MenuId);

            Context.Categories.Add(Input);
            await Context.SaveChangesAsync();

            // Category added successfully - reset form
            Input = new()
                {
                    MenuId = new Guid(MenuId)
                };
            await LoadCategoriesAsync();
        }
        catch (Exception ex)
        {
            // Show error in validation message
            var messages = new ValidationMessageStore(editContext);
            messages.Add(() => Input.Name, $"Error adding category: {ex.Message}");
            editContext.NotifyValidationStateChanged();
            StateHasChanged();

            // Log the full exception for debugging
            Console.WriteLine($"Error in SaveAsync: {ex}");
        }
    }

    async Task MoveCategory(Category category, int offset)
    {
        if (!canEdit || isMoving) return;
        isMoving = true;
        try
        {
            // Renumber all categories of the menu in their current order, then save the changed rows
            var siblings = await Context.Categories
                .Where(c => c.MenuId == MenuGuid)
                .InDisplayOrder()
                .ToListAsync();
            if (DisplayOrder.Move(siblings, siblings.FindIndex(c => c.Id == category.Id), offset, (c, i) => c.SortOrder = i))
                await Context.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error moving category: {ex}");
        }
        finally
        {
            isMoving = false;
        }
        await LoadCategoriesAsync();
    }

    async void EditCategory(Category category)
    {
        editingCategory = category;
        categoryEditor.Input = category;
        await categoryEditor.ShowModal();
    }

    async Task HandleOk(Category category)
    {
        try
        {
            // Update logic here
            Context.Categories.Update(category);
            await Context.SaveChangesAsync();
            editingCategory = null;
            await LoadCategoriesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating category: {ex}");
        }
    }

    async Task HandleCancel()
    {
        // The editor binds to the tracked entity: undo a name typed but not saved
        if (editingCategory is not null && Context.Entry(editingCategory).State != EntityState.Detached)
            await Context.Entry(editingCategory).ReloadAsync();
        editingCategory = null;
        categoryEditor.Input = new()
            {
                MenuId = new Guid(MenuId)
            };
        StateHasChanged();
    }

    async Task DeleteCategory(Guid id)
    {
        if (!canDelete) return;
        try
        {
            var category = await Context.Categories.FindAsync(id);
            if (category is not null)
            {
                var res = await NotificationService.ShowConfirmation(("Delete", $"Are you sure you want to delete the category \"{category.Name}\"?"));
                if (res)
                {
                    Context.Categories.Remove(category);
                    await Context.SaveChangesAsync();
                    await LoadCategoriesAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting category: {ex}");
        }
    }

    async Task LoadCategoriesAsync()
    {
        menu = await Context.Menus.FindAsync(MenuGuid);
        Categories = await Context.Categories
            .Where(e => e.MenuId == MenuGuid)
            .InDisplayOrder()
            .ToListAsync();
        itemCounts = await Context.Categories
            .Where(e => e.MenuId == MenuGuid)
            .Select(e => new { e.Id, Count = e.MenuItems!.Count() })
            .ToDictionaryAsync(e => e.Id, e => e.Count);
        await InvokeAsync(StateHasChanged);
    }
}
