@page "/Categories/{MenuId}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using SpeiseDirekt3.Components.Shared.Sortable
@using SpeiseDirekt.Data
@using SpeiseDirekt.Model
@using SpeiseDirekt.Infrastructure
@using SpeiseDirekt.ServiceInterface
@attribute [Authorize]
@inject IStringLocalizer<CategoriesText> T
@inject IStringLocalizer<CommonText> C
@inject IStringLocalizer<ShellText> S

<PageTitle>@C["PageTitle", T["Title"]]</PageTitle>

<div class="max-w-6xl mx-auto">

    @* "Menus › menu" and the links to items, allergens and combos are in the menu context bar *@
    <PageHeader Title="@T["Title"]" Icon="PageIcons.Categories" Tone="TileTone.Brand">
        <Description>@UiMarkup.Strong(T["Description"], menu?.Name ?? "")</Description>
    </PageHeader>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

        <!-- Categories list: drag the grip (or ↑/↓ on it) to reorder, edit name and subtitle in the row -->
        <section class="@(canCreate ? "lg:col-span-2" : "lg:col-span-3") bg-white rounded-xl shadow-sm border border-gray-200" aria-labelledby="categories-heading">
            <div class="sd-card-head">
                <h2 id="categories-heading" class="sd-card-title">
                    @T["List_Heading"] <span class="sd-count" data-testid="category-count">@Categories.Count</span>
                </h2>
                @if (canEdit && Categories.Count > 1)
                {
                    <p class="sd-card-hint" data-testid="category-order-hint">@T["OrderHint"]</p>
                }
            </div>
            @if (orderError is not null)
            {
                <div class="mx-[1rem] sm:mx-6 mt-[1rem] rounded-lg border border-red-200 bg-red-50 px-[1rem] py-[0.75rem] text-sm text-red-800 flex items-start justify-between gap-3" role="alert" data-testid="order-error">
                    <span>@orderError</span>
                    <button type="button" class="text-red-700 hover:text-red-900" aria-label="@S["Error_Dismiss"]" @onclick="() => orderError = null">&times;</button>
                </div>
            }
            @if (Categories.Any())
            {
                <table class="w-full text-left" data-testid="category-list">
                    <thead class="sr-only">
                        <tr>
                            @if (canEdit)
                            {
                                <th>@T["Column_Order"]</th>
                            }
                            <th>@T["Column_Category"]</th>
                            <th>@T["Column_Actions"]</th>
                        </tr>
                    </thead>
                    <SortableList TItem="Category" Element="tbody" RowElement="tr" Items="Categories" KeyOf="c => c.Id" NameOf="c => c.Name"
                                  OnMove="@(canEdit ? MoveCategoryAsync : null)" class="divide-y divide-gray-100"
                                  RowClass="hover:bg-gray-50" RowAttributes="RowAttributes">
                        <ChildContent Context="row">
                            @{ var item = row.Item; }
                            @if (canEdit)
                            {
                                <td class="pl-1 sm:pl-3 py-2 w-px align-middle">@row.Handle</td>
                            }
                            @if (draft is not null && draft.Id == item.Id)
                            {
                                <td colspan="2" class="@(canEdit ? "pl-1" : "pl-[0.75rem] sm:pl-4") pr-[0.75rem] sm:pr-4 py-[0.75rem]">
                                    <div @onkeydown="OnEditKeyDown">
                                        <EditForm EditContext="draftContext" OnSubmit="SaveEditAsync" class="sd-inline-form" data-testid="category-edit">
                                            <DataAnnotationsValidator />
                                            <div class="sd-inline-field">
                                                <label for="Category.Name" class="sd-inline-label">@T["Field_Name"]</label>
                                                <InputText @ref="draftNameInput" @bind-Value="draft.Name" id="Category.Name" class="sd-input" />
                                                <ValidationMessage For="() => draft.Name" class="sd-field-error" />
                                            </div>
                                            <div class="sd-inline-field">
                                                <label for="Category.Description" class="sd-inline-label">@T["Field_SubtitleOptional"]</label>
                                                <InputText @bind-Value="draft.Description" id="Category.Description" class="sd-input" placeholder="@T["Field_SubtitlePlaceholder"]"
                                                           maxlength="@Category.DescriptionMaxLength" />
                                                <ValidationMessage For="() => draft.Description" class="sd-field-error" />
                                            </div>
                                            <div class="sd-inline-actions">
                                                <button type="submit" class="sd-btn sd-btn--primary sd-btn--small" disabled="@savingDraft">@C["Save"]</button>
                                                <button type="button" class="sd-btn sd-btn--secondary sd-btn--small" @onclick="CancelEditAsync">@C["Cancel"]</button>
                                            </div>
                                            <p class="sd-inline-hint">@T["InlineHint"]</p>
                                        </EditForm>
                                    </div>
                                </td>
                            }
                            else
                            {
                                <td class="@(canEdit ? "pl-1" : "pl-[0.75rem] sm:pl-4") pr-[0.75rem] py-[0.75rem] min-w-0">
                                    <a href="@($"/MenuItems/Category/{item.Id}")" class="font-semibold text-brand-700 hover:underline hover:text-brand-800 break-words transition">@item.Name</a>
                                    <span class="block sm:inline sm:ml-2 text-sm text-gray-500" data-testid="category-item-count">@ItemCountText(item)</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <span class="block mt-0.5 text-sm text-gray-600 break-words" data-testid="category-description">@item.Description</span>
                                    }
                                </td>
                                <td class="pr-1 sm:pr-3 py-2 w-px whitespace-nowrap text-right align-middle">
                                    @if (canEdit)
                                    {
                                        <button type="button" class="sd-row-action" title="@C["Edit"]" aria-label="@T["EditLabel", item.Name]"
                                                @ref="editButtons[item.Id]" @onclick="() => StartEditAsync(item)">
                                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                            </svg>
                                        </button>
                                    }
                                    @if (canDelete)
                                    {
                                        <button type="button" class="sd-row-action sd-row-action--danger" title="@C["Delete"]" aria-label="@T["DeleteLabel", item.Name]"
                                                @onclick="() => DeleteCategory(item.Id)">
                                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                        </button>
                                    }
                                </td>
                            }
                        </ChildContent>
                    </SortableList>
                </table>
            }
            else
            {
                <div class="sd-empty" data-testid="categories-empty">
                    <span class="sd-empty-icon" aria-hidden="true">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="@PageIcons.Categories.Path" /></svg>
                    </span>
                    <h3 class="sd-empty-title">@T["EmptyTitle"]</h3>
                    <p class="sd-empty-text">
                        @T["EmptyText"]
                        @(canCreate ? T["EmptyAddHint"] : "")
                    </p>
                </div>
            }
        </section>

        @if (canCreate)
        {
            <!-- Add New Category Form -->
            <section class="bg-white rounded-xl shadow-sm border border-gray-200" aria-labelledby="add-category-heading">
                <div class="sd-card-head">
                    <h2 id="add-category-heading" class="sd-card-title">@T["Add_Title"]</h2>
                </div>
                <div class="p-[1rem] sm:p-6">
                    <EditForm @ref="editForm" EditContext="editContext" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator />

                        <div class="mb-4">
                            <label for="Input.Name" class="block text-sm font-medium text-gray-700 mb-1">@T["Add_Name"]</label>
                            <InputText @bind-Value="Input.Name" id="Input.Name" class="sd-input" />
                            <ValidationMessage For="() => Input.Name" class="sd-field-error" />
                            <p class="mt-1 text-xs text-gray-500">@T["Add_NameHint"]</p>
                        </div>

                        <div class="mb-4">
                            <label for="Input.Description" class="block text-sm font-medium text-gray-700 mb-1">@T["Add_Subtitle"] <span class="font-normal text-gray-500">@C["OptionalSuffix"]</span></label>
                            <InputText @bind-Value="Input.Description" id="Input.Description" maxlength="@Category.DescriptionMaxLength"
                                       placeholder="@T["Field_SubtitlePlaceholder"]" class="sd-input" />
                            <ValidationMessage For="() => Input.Description" class="sd-field-error" />
                            <p class="mt-1 text-xs text-gray-500">@T["Add_SubtitleHint"]</p>
                        </div>

                        <button type="submit" class="sd-btn sd-btn--primary w-full">
                            @T["Add_Submit"]
                        </button>
                    </EditForm>
                </div>
            </section>
        }
    </div>
</div>


@code {
    [Parameter]
    public string MenuId { get; set; }

    [Inject]
    public ApplicationDbContext Context { get; set; }
    [Inject]
    public AuthenticationStateProvider AuthenticationStateProvider { get; set; }
    [Inject]
    public INotificationService NotificationService { get; set; }
    [Inject]
    public IPermissionService PermissionService { get; set; }

    List<Category> Categories { get; set; } = [];
    Dictionary<Guid, int> itemCounts = new();
    bool canCreate, canEdit, canDelete;
    string? orderError;

    Category Input { get; set; } = new();
    EditContext editContext = new EditContext(new Category());
    EditForm editForm;
    Menu? menu;

    // Inline edit: a detached copy of the row being edited (the tracked entity changes only on Save)
    Category? draft;
    EditContext draftContext = new(new Category());
    ValidationMessageStore? draftMessages;
    InputText? draftNameInput;
    bool savingDraft;
    bool focusDraft;
    Guid? focusEditButton;
    readonly Dictionary<Guid, ElementReference> editButtons = new();

    Guid MenuGuid => Guid.Parse(MenuId);

    static IReadOnlyDictionary<string, object> RowAttributes(Category category) =>
        new Dictionary<string, object> { ["data-testid"] = "category-row" };

    protected override Task OnParametersSetAsync()
    {
        editContext = new EditContext(Input);
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        canCreate = await PermissionService.HasPermissionAsync(Permission.CategoriesCreate);
        canEdit = await PermissionService.HasPermissionAsync(Permission.CategoriesEdit);
        canDelete = await PermissionService.HasPermissionAsync(Permission.CategoriesDelete);
        await LoadCategoriesAsync();
        Input = new()
            {
                MenuId = new Guid(MenuId)
            };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusDraft && draftNameInput?.Element is { } input)
        {
            focusDraft = false;
            await input.FocusAsync();
        }
        else if (focusEditButton is { } id && editButtons.TryGetValue(id, out var button))
        {
            focusEditButton = null;
            try { await button.FocusAsync(); } catch (JSException) { /* row gone */ }
        }
    }

    string ItemCountText(Category category)
    {
        return T.Plural(itemCounts.GetValueOrDefault(category.Id), "ItemCount");
    }

    async Task SaveAsync()
    {
        if (!canCreate) return;
        try
        {
            editContext = new EditContext(Input);
            editForm.EditContext = editContext;
            if (!editContext.Validate())
                return;

            // Validate that we have a valid user context
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState?.User?.Identity?.IsAuthenticated != true)
            {
                var messages = new ValidationMessageStore(editContext);
                messages.Add(() => Input.Name, T["Error_NotLoggedIn"]);
                editContext.NotifyValidationStateChanged();
                StateHasChanged();
                return;
            }

            var nameExists = await Context.Categories.AnyAsync(c => c.MenuId == Guid.Parse(MenuId) && c.Name == Input.Name);
            if (nameExists)
            {
                var messages = new ValidationMessageStore(editContext);
                messages.Add(() => Input.Name, T["Error_NameTaken"]);
                editContext.NotifyValidationStateChanged();
                StateHasChanged();
                return;
            }

            // Ensure the Input has the correct MenuId; new categories go to the end
            Input.MenuId = new Guid(MenuId);
            Input.Description = string.IsNullOrWhiteSpace(Input.Description) ? null : Input.Description.Trim();
            Input.SortOrder = await Context.NextCategorySortOrderAsync(Input.MenuId);

            Context.Categories.Add(Input);
            await Context.SaveChangesAsync();

            // Category added successfully - reset form
            Input = new()
                {
                    MenuId = new Guid(MenuId)
                };
            await LoadCategoriesAsync();
        }
        catch (Exception ex)
        {
            // Show error in validation message
            var messages = new ValidationMessageStore(editContext);
            messages.Add(() => Input.Name, T["Error_Add"]);
            editContext.NotifyValidationStateChanged();
            StateHasChanged();

            // Log the full exception for debugging
            Console.WriteLine($"Error in SaveAsync: {ex}");
        }
    }

    /// <summary>
    /// A row was dragged (or moved with the arrow keys) from one position to another: show the new order at once,
    /// then renumber all categories of the menu in that order and save once. A failed save shows the stored order
    /// again with a message.
    /// </summary>
    async Task<bool> MoveCategoryAsync(SortableMove move)
    {
        if (!canEdit) return false;
        var moved = Categories[move.OldIndex];
        var reordered = Categories.ToList();
        reordered.RemoveAt(move.OldIndex);
        reordered.Insert(move.NewIndex, moved);
        Categories = reordered;
        orderError = null;
        StateHasChanged();
        await Task.Yield(); // render the optimistic order before the database round trip

        try
        {
            var siblings = await Context.Categories
                .Where(c => c.MenuId == MenuGuid)
                .InDisplayOrder()
                .ToListAsync();
            var from = siblings.FindIndex(c => c.Id == moved.Id);
            if (from < 0)
                throw new InvalidOperationException("The category no longer exists.");
            var to = Math.Clamp(move.NewIndex, 0, siblings.Count - 1);
            if (DisplayOrder.Move(siblings, from, to - from, (c, i) => c.SortOrder = i))
                await Context.SaveChangesAsync();
            await LoadCategoriesAsync();
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error moving category: {ex}");
            Context.ChangeTracker.Clear(); // drop the unsaved SortOrder values
            orderError = T["Error_Order", moved.Name];
            await LoadCategoriesAsync();
            return false;
        }
    }

    async Task StartEditAsync(Category category)
    {
        if (!canEdit) return;
        draft = new Category
        {
            Id = category.Id,
            MenuId = category.MenuId,
            Name = category.Name,
            Description = category.Description,
            SortOrder = category.SortOrder
        };
        draftContext = new EditContext(draft);
        draftMessages = new ValidationMessageStore(draftContext);
        focusDraft = true;
        await Task.CompletedTask;
    }

    void OnEditKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            _ = CancelEditAsync();
    }

    Task CancelEditAsync()
    {
        if (draft is not null)
            focusEditButton = draft.Id;
        draft = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    async Task SaveEditAsync()
    {
        if (draft is null || !canEdit || savingDraft) return;
        var messages = draftMessages ??= new ValidationMessageStore(draftContext);
        messages.Clear();
        if (!draftContext.Validate())
            return;

        draft.Name = draft.Name.Trim();
        draft.Description = string.IsNullOrWhiteSpace(draft.Description) ? null : draft.Description.Trim();
        savingDraft = true;
        try
        {
            var nameExists = await Context.Categories.AnyAsync(c => c.Id != draft.Id && c.MenuId == draft.MenuId && c.Name == draft.Name);
            if (nameExists)
            {
                messages.Add(() => draft.Name, T["Error_NameTaken"]);
                draftContext.NotifyValidationStateChanged();
                return;
            }

            var category = await Context.Categories.FindAsync(draft.Id);
            if (category is null)
            {
                messages.Add(() => draft.Name, T["Error_Gone"]);
                draftContext.NotifyValidationStateChanged();
                return;
            }
            category.Name = draft.Name;
            category.Description = draft.Description;
            await Context.SaveChangesAsync();
            focusEditButton = draft.Id;
            draft = null;
            await LoadCategoriesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating category: {ex}");
            Context.ChangeTracker.Clear();
            messages.Add(() => draft!.Name, T["Error_Save"]);
            draftContext.NotifyValidationStateChanged();
            await LoadCategoriesAsync();
        }
        finally
        {
            savingDraft = false;
        }
    }

    async Task DeleteCategory(Guid id)
    {
        if (!canDelete) return;
        try
        {
            var category = await Context.Categories.FindAsync(id);
            if (category is not null)
            {
                var res = await NotificationService.ShowConfirmation(new ConfirmationRequest(T["Delete_Title"], T["Delete_Message", category.Name])
                {
                    ConfirmText = C["Delete"],
                    Destructive = true
                });
                if (res)
                {
                    Context.Categories.Remove(category);
                    await Context.SaveChangesAsync();
                    if (draft?.Id == id)
                        draft = null;
                    await LoadCategoriesAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting category: {ex}");
        }
    }

    async Task LoadCategoriesAsync()
    {
        menu = await Context.Menus.FindAsync(MenuGuid);
        Categories = await Context.Categories
            .Where(e => e.MenuId == MenuGuid)
            .InDisplayOrder()
            .ToListAsync();
        itemCounts = await Context.Categories
            .Where(e => e.MenuId == MenuGuid)
            .Select(e => new { e.Id, Count = e.MenuItems!.Count() })
            .ToDictionaryAsync(e => e.Id, e => e.Count);
        await InvokeAsync(StateHasChanged);
    }
}
