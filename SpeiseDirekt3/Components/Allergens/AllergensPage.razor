@page "/allergens/{MenuId}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using SpeiseDirekt.Data
@using SpeiseDirekt.Model
@using SpeiseDirekt.Infrastructure
@using SpeiseDirekt.ServiceInterface
@attribute [Authorize]

<PageTitle>Allergens - Speise-Direkt</PageTitle>

@* "Menus › menu" and the links to categories, items and combos are in the menu context bar *@
<PageHeader Title="Allergens" Icon="PageIcons.Allergens" Tone="TileTone.Green">
    <Description>The allergen codes guests see on the dishes of <strong>@menu?.Name</strong>.</Description>
    <Actions>
        @if (canCreate)
        {
            <div class="sm:text-right sm:max-w-xs">
                <button type="button" data-testid="eu-quick-fill"
                        class="sd-btn sd-btn--primary w-full sm:w-auto"
                        disabled="@(AllEuAllergensPresent || quickFillBusy)"
                        @onclick="AddEuAllergensAsync">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path fill-rule="evenodd" d="M5 11.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5M3.854 2.146a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 1 1 .708-.708L2 3.293l1.146-1.147a.5.5 0 0 1 .708 0m0 4a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 1 1 .708-.708L2 7.293l1.146-1.147a.5.5 0 0 1 .708 0m0 4a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 0 1 .708-.708l.146.147 1.146-1.147a.5.5 0 0 1 .708 0"/></svg>Add the 14 EU allergens
                </button>
                <p class="mt-2 mb-0 text-xs text-gray-500" data-testid="eu-quick-fill-hint">
                    @if (AllEuAllergensPresent)
                    {
                        <text>All 14 EU allergens are already on this menu.</text>
                    }
                    else
                    {
                        <text>Codes A–R, @(UsesGermanNames ? "German" : "English") names; existing codes are kept.</text>
                    }
                </p>
            </div>
        }
    </Actions>
</PageHeader>

@if (quickFillNotice is not null)
{
    <div role="status" data-testid="eu-quick-fill-notice"
         class="-mt-2 mb-6 flex items-start gap-2 rounded-lg border px-4 py-3 text-sm @(quickFillAddedAny ? "border-green-200 bg-green-50 text-green-800" : "border-gray-200 bg-white text-gray-700")">
        <span>@quickFillNotice</span>
    </div>
}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

    <!-- Allergens list: code and name are edited in the row -->
    <section class="bg-white rounded-xl shadow-sm border border-gray-200 lg:col-span-2" aria-labelledby="allergens-heading">
        <div class="sd-card-head">
            <h2 id="allergens-heading" class="sd-card-title">Allergens on this menu <span class="sd-count">@rows.Count</span></h2>
        </div>
        @if (rows.Any())
        {
            <table class="w-full text-left text-sm" data-testid="allergen-list">
                <thead class="sd-thead">
                    <tr>
                        <th class="py-[0.625rem] pl-[1rem] sm:pl-6 pr-2 w-14">Code</th>
                        <th class="py-[0.625rem] px-2">Name</th>
                        <th class="py-[0.625rem] px-2 whitespace-nowrap">Used by</th>
                        @if (canEdit || canDelete)
                        {
                            <th class="py-[0.625rem] pl-2 pr-[1rem] sm:pr-6"><span class="sr-only">Actions</span></th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var row in rows)
                    {
                        var item = row.Allergen;
                        <tr @key="item.Id" class="hover:bg-gray-50" data-testid="allergen-row">
                            @if (draft is not null && draft.Id == item.Id)
                            {
                                <td colspan="@(canEdit || canDelete ? 4 : 3)" class="py-[0.75rem] pl-[1rem] sm:pl-6 pr-[1rem] sm:pr-6">
                                    <div @onkeydown="OnEditKeyDown">
                                        <EditForm EditContext="draftContext" OnSubmit="SaveEditAsync" class="sd-inline-form" data-testid="allergen-edit">
                                            <DataAnnotationsValidator />
                                            <div class="sd-inline-field sd-inline-field--narrow">
                                                <label for="Allergen.Code" class="sd-inline-label">Code</label>
                                                <InputText @ref="draftCodeInput" @bind-Value="draft.Code" id="Allergen.Code" class="sd-input font-mono" />
                                                <ValidationMessage For="() => draft.Code" class="sd-field-error" />
                                            </div>
                                            <div class="sd-inline-field">
                                                <label for="Allergen.Name" class="sd-inline-label">Name</label>
                                                <InputText @bind-Value="draft.Name" id="Allergen.Name" class="sd-input" />
                                                <ValidationMessage For="() => draft.Name" class="sd-field-error" />
                                            </div>
                                            <div class="sd-inline-actions">
                                                <button type="submit" class="sd-btn sd-btn--primary sd-btn--small" disabled="@savingDraft">Save</button>
                                                <button type="button" class="sd-btn sd-btn--secondary sd-btn--small" @onclick="CancelEdit">Cancel</button>
                                            </div>
                                            <p class="sd-inline-hint">Enter saves, Escape cancels.</p>
                                        </EditForm>
                                    </div>
                                </td>
                            }
                            else
                            {
                                <td class="py-2 pl-[1rem] sm:pl-6 pr-2 align-middle">
                                    <span class="inline-flex items-center justify-center min-w-[2rem] px-1.5 py-0.5 rounded-md font-mono font-bold text-brand-800 bg-brand-50 border border-brand-200" data-testid="allergen-code">@item.Code</span>
                                </td>
                                <td class="py-2 px-2 text-gray-900 align-middle">@item.Name</td>
                                <td class="py-2 px-2 whitespace-nowrap align-middle" data-testid="allergen-usage">
                                    @if (row.UsageCount > 0)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-brand-100 px-2.5 py-0.5 text-xs font-semibold text-brand-800">@ItemCount(row.UsageCount)</span>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-gray-500">Not used</span>
                                    }
                                </td>
                                @if (canEdit || canDelete)
                                {
                                    <td class="py-1 pl-2 pr-[0.5rem] sm:pr-4 text-right whitespace-nowrap align-middle">
                                        @if (canEdit)
                                        {
                                            <button type="button" class="sd-row-action" title="Edit" aria-label="@($"Edit allergen {item.Code}")"
                                                    @ref="editButtons[item.Id]" @onclick="() => StartEdit(item)">
                                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                                </svg>
                                            </button>
                                        }
                                        @if (canDelete)
                                        {
                                            <button type="button" class="sd-row-action sd-row-action--danger" title="Delete" aria-label="@($"Delete allergen {item.Code}")"
                                                    @onclick="() => DeleteAllergen(item.Id)">
                                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                                </svg>
                                            </button>
                                        }
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="sd-empty" data-testid="allergens-empty">
                <span class="sd-empty-icon" aria-hidden="true">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="@PageIcons.Allergens.Path" /></svg>
                </span>
                <h3 class="sd-empty-title">No allergens yet</h3>
                <p class="sd-empty-text">
                    @if (canCreate)
                    {
                        <text>Add the 14 EU allergens with one click or enter your own codes.</text>
                    }
                    else
                    {
                        <text>Nobody has added allergens to this menu yet.</text>
                    }
                </p>
            </div>
        }
    </section>

    @if (canCreate)
    {
        <!-- Add New Allergen Form -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200" aria-labelledby="add-allergen-heading">
            <div class="sd-card-head">
                <h2 id="add-allergen-heading" class="sd-card-title">Add New Allergen</h2>
            </div>
            <div class="p-[1rem] sm:p-6">
                <EditForm @ref="editForm" EditContext="editContext" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />

                    <div class="mb-4">
                        <label for="Input.Code" class="block text-sm font-medium text-gray-700 mb-1">Code</label>
                        <InputText @bind-Value="Input.Code" id="Input.Code" placeholder="e.g. A" class="sd-input" />
                        <ValidationMessage For="() => Input.Code" class="sd-field-error" />
                    </div>

                    <div class="mb-4">
                        <label for="Input.Name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
                        <InputText @bind-Value="Input.Name" id="Input.Name" placeholder="e.g. Glutenhaltiges Getreide" class="sd-input" />
                        <ValidationMessage For="() => Input.Name" class="sd-field-error" />
                    </div>

                    <button type="submit" class="sd-btn sd-btn--primary w-full">
                        Add Allergen
                    </button>
                </EditForm>
            </div>
        </section>
    }
</div>


@code {
    [Parameter]
    public string MenuId { get; set; }

    [Inject]
    public ApplicationDbContext Context { get; set; }
    [Inject]
    public AuthenticationStateProvider AuthenticationStateProvider { get; set; }
    [Inject]
    public INotificationService NotificationService { get; set; }
    [Inject]
    public IPermissionService PermissionService { get; set; }

    /// <summary>An allergen of the menu and the number of menu items that carry it.</summary>
    sealed record AllergenRow(Allergen Allergen, int UsageCount);

    List<AllergenRow> rows = [];
    bool canCreate, canEdit, canDelete;

    Allergen Input { get; set; } = new();
    EditContext editContext = new EditContext(new Allergen());
    EditForm editForm;
    Menu? menu;

    string? quickFillNotice;
    bool quickFillAddedAny;
    bool quickFillBusy;

    bool AllEuAllergensPresent => EuAllergens.Missing(rows.Select(r => r.Allergen.Code)).Count == 0;
    bool UsesGermanNames => (menu?.Language ?? MenuLanguage.German) == MenuLanguage.German;

    static string ItemCount(int count) => count == 1 ? "1 item" : $"{count} items";

    protected override Task OnParametersSetAsync()
    {
        editContext = new EditContext(Input);
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        canCreate = await PermissionService.HasPermissionAsync(Permission.AllergensCreate);
        canEdit = await PermissionService.HasPermissionAsync(Permission.AllergensEdit);
        canDelete = await PermissionService.HasPermissionAsync(Permission.AllergensDelete);
        await LoadAllergensAsync();
        Input = new()
            {
                MenuId = new Guid(MenuId)
            };
    }

    async Task SaveAsync()
    {
        if (!canCreate) return;
        try
        {
            editContext = new EditContext(Input);
            editForm.EditContext = editContext;
            if (!editContext.Validate())
                return;

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState?.User?.Identity?.IsAuthenticated != true)
            {
                var messages = new ValidationMessageStore(editContext);
                messages.Add(() => Input.Code, "You must be logged in to add allergens.");
                editContext.NotifyValidationStateChanged();
                StateHasChanged();
                return;
            }

            var codeExists = await Context.Allergens.AnyAsync(a => a.MenuId == Guid.Parse(MenuId) && a.Code == Input.Code);
            if (codeExists)
            {
                var messages = new ValidationMessageStore(editContext);
                messages.Add(() => Input.Code, "This code already exists for this menu.");
                editContext.NotifyValidationStateChanged();
                StateHasChanged();
                return;
            }

            Input.MenuId = new Guid(MenuId);

            Context.Allergens.Add(Input);
            await Context.SaveChangesAsync();

            Input = new()
                {
                    MenuId = new Guid(MenuId)
                };
            quickFillNotice = null;
            await LoadAllergensAsync();
        }
        catch (Exception ex)
        {
            var messages = new ValidationMessageStore(editContext);
            messages.Add(() => Input.Code, $"Error adding allergen: {ex.Message}");
            editContext.NotifyValidationStateChanged();
            StateHasChanged();
            Console.WriteLine($"Error in SaveAsync: {ex}");
        }
    }

    /// <summary>
    /// Adds those of the 14 EU allergens whose code does not exist on this menu yet (codes compared
    /// case-insensitively, against the database rather than the possibly stale list on screen).
    /// </summary>
    async Task AddEuAllergensAsync()
    {
        if (!canCreate || quickFillBusy) return;
        quickFillBusy = true;
        try
        {
            var menuId = Guid.Parse(MenuId);
            var existingCodes = await Context.Allergens.Where(a => a.MenuId == menuId).Select(a => a.Code).ToListAsync();
            var language = (await Context.Menus.Where(m => m.Id == menuId).Select(m => (MenuLanguage?)m.Language).SingleOrDefaultAsync())
                           ?? MenuLanguage.German;
            var missing = EuAllergens.Missing(existingCodes);

            foreach (var entry in missing)
                Context.Allergens.Add(new Allergen { MenuId = menuId, Code = entry.Code, Name = entry.NameFor(language) });
            if (missing.Count > 0)
                await Context.SaveChangesAsync();

            var alreadyThere = EuAllergens.All.Count - missing.Count;
            quickFillAddedAny = missing.Count > 0;
            quickFillNotice = missing.Count == 0
                ? $"No allergens added: all {EuAllergens.All.Count} EU allergens already existed."
                : $"{missing.Count} {(missing.Count == 1 ? "allergen" : "allergens")} added, {alreadyThere} already existed.";
            await LoadAllergensAsync();
        }
        catch (Exception ex)
        {
            quickFillAddedAny = false;
            quickFillNotice = $"Could not add the EU allergens: {ex.Message}";
            Console.WriteLine($"Error in AddEuAllergensAsync: {ex}");
        }
        finally
        {
            quickFillBusy = false;
        }
    }

    // Inline edit: a detached copy of the row being edited (the tracked entity changes only on Save)
    Allergen? draft;
    EditContext draftContext = new(new Allergen());
    ValidationMessageStore? draftMessages;
    InputText? draftCodeInput;
    bool savingDraft, focusDraft;
    Guid? focusEditButton;
    readonly Dictionary<Guid, ElementReference> editButtons = new();

    void StartEdit(Allergen allergen)
    {
        if (!canEdit) return;
        draft = new Allergen { Id = allergen.Id, MenuId = allergen.MenuId, Code = allergen.Code, Name = allergen.Name };
        draftContext = new EditContext(draft);
        draftMessages = new ValidationMessageStore(draftContext);
        focusDraft = true;
    }

    void OnEditKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CancelEdit();
    }

    void CancelEdit()
    {
        if (draft is not null)
            focusEditButton = draft.Id;
        draft = null;
        StateHasChanged();
    }

    async Task SaveEditAsync()
    {
        if (draft is null || !canEdit || savingDraft) return;
        var messages = draftMessages ??= new ValidationMessageStore(draftContext);
        messages.Clear();
        if (!draftContext.Validate())
            return;

        savingDraft = true;
        try
        {
            var codeExists = await Context.Allergens.AnyAsync(a => a.Id != draft.Id && a.MenuId == draft.MenuId && a.Code == draft.Code);
            if (codeExists)
            {
                messages.Add(() => draft.Code, "This code already exists for this menu.");
                draftContext.NotifyValidationStateChanged();
                return;
            }

            var allergen = await Context.Allergens.FindAsync(draft.Id);
            if (allergen is null)
            {
                messages.Add(() => draft.Code, "This allergen no longer exists.");
                draftContext.NotifyValidationStateChanged();
                return;
            }
            allergen.Code = draft.Code;
            allergen.Name = draft.Name;
            await Context.SaveChangesAsync();
            focusEditButton = draft.Id;
            draft = null;
            await LoadAllergensAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating allergen: {ex}");
            Context.ChangeTracker.Clear();
            messages.Add(() => draft!.Code, "The allergen could not be saved. Please try again.");
            draftContext.NotifyValidationStateChanged();
            await LoadAllergensAsync();
        }
        finally
        {
            savingDraft = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusDraft && draftCodeInput?.Element is { } input)
        {
            focusDraft = false;
            await input.FocusAsync();
        }
        else if (focusEditButton is { } id && editButtons.TryGetValue(id, out var button))
        {
            focusEditButton = null;
            try { await button.FocusAsync(); } catch (JSException) { /* row gone */ }
        }
    }

    async Task DeleteAllergen(Guid id)
    {
        if (!canDelete) return;
        try
        {
            var allergen = await Context.Allergens.FindAsync(id);
            if (allergen is not null)
            {
                // Count fresh from the database: an item may have been tagged since the list was loaded
                var usage = await Context.Allergens.Where(a => a.Id == id).Select(a => a.MenuItems.Count).SingleAsync();
                var message = usage > 0
                    ? $"The allergen \"{allergen.Code} – {allergen.Name}\" is used by {ItemCount(usage)}. Deleting it removes it from {(usage == 1 ? "that item" : "these items")}. Delete anyway?"
                    : $"Are you sure you want to delete the allergen \"{allergen.Name}\"?";
                var res = await NotificationService.ShowConfirmation(("Delete", message));
                if (res)
                {
                    if (draft?.Id == id)
                        draft = null;
                    Context.Allergens.Remove(allergen);
                    await Context.SaveChangesAsync();
                    quickFillNotice = null;
                    await LoadAllergensAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting allergen: {ex}");
        }
    }

    async Task LoadAllergensAsync()
    {
        var menuId = Guid.Parse(MenuId);
        menu = await Context.Menus.FindAsync(menuId);
        // One query: the allergens with the number of items that use them (correlated count over the join table)
        rows = await Context.Allergens
            .Where(a => a.MenuId == menuId)
            .OrderBy(a => a.Code)
            .Select(a => new AllergenRow(a, a.MenuItems.Count))
            .ToListAsync();
        await InvokeAsync(StateHasChanged);
    }
}
