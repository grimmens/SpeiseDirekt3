@page "/allergens/{MenuId}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using SpeiseDirekt3.Components.Allergens.Components
@using SpeiseDirekt.Data
@using SpeiseDirekt.Model
@using SpeiseDirekt.Infrastructure
@using SpeiseDirekt.ServiceInterface
@attribute [Authorize]

<PageTitle>Allergens - Speise-Direkt</PageTitle>

<!-- Header -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-6">
    <div class="p-6">
        <nav class="flex flex-wrap items-center text-sm text-gray-500 mb-3" aria-label="breadcrumb">
            <a href="/menus" class="hover:text-blue-600 transition-colors">Menus</a>
            <svg class="mx-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <a href="@($"/menudetail/{MenuId}")" class="hover:text-blue-600 transition-colors">@menu?.Name</a>
            <svg class="mx-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span class="text-gray-900 font-medium">Allergens</span>
        </nav>

        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
            <div class="min-w-0">
                <h1 class="text-3xl font-bold text-gray-900 font-display">Allergens</h1>
                <p class="mt-2 text-gray-600">The allergen codes guests see on the dishes of <strong>@menu?.Name</strong>.</p>
                <nav class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm" aria-label="Related pages" data-testid="allergen-related-links">
                    <a href="@($"/Categories/{MenuId}")" class="font-medium text-blue-600 hover:text-blue-800 hover:underline">Categories</a>
                    <span class="text-gray-300" aria-hidden="true">·</span>
                    <a href="@($"/MenuItems/{MenuId}")" class="font-medium text-blue-600 hover:text-blue-800 hover:underline">Menu items</a>
                    <span class="text-gray-300" aria-hidden="true">·</span>
                    <a href="@($"/combos/{MenuId}")" class="font-medium text-blue-600 hover:text-blue-800 hover:underline">Combos</a>
                </nav>
            </div>
            @if (canCreate)
            {
                <div class="sm:text-right sm:max-w-xs">
                    <button type="button" data-testid="eu-quick-fill"
                            class="inline-flex w-full sm:w-auto items-center justify-center px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-sm transition-colors disabled:bg-gray-300 disabled:text-gray-600 disabled:shadow-none disabled:cursor-not-allowed"
                            disabled="@(AllEuAllergensPresent || quickFillBusy)"
                            @onclick="AddEuAllergensAsync">
                        <i class="bi bi-list-check mr-2" aria-hidden="true"></i>
                        Add the 14 EU allergens
                    </button>
                    <p class="mt-2 text-xs text-gray-500" data-testid="eu-quick-fill-hint">
                        @if (AllEuAllergensPresent)
                        {
                            <text>All 14 EU allergens are already on this menu.</text>
                        }
                        else
                        {
                            <text>Codes A–R with @(UsesGermanNames ? "German" : "English") names. Codes that already exist are kept.</text>
                        }
                    </p>
                </div>
            }
        </div>

        @if (quickFillNotice is not null)
        {
            <div role="status" data-testid="eu-quick-fill-notice"
                 class="mt-4 flex items-start gap-2 rounded-lg border px-4 py-3 text-sm @(quickFillAddedAny ? "border-green-200 bg-green-50 text-green-800" : "border-gray-200 bg-gray-50 text-gray-700")">
                <i class="bi @(quickFillAddedAny ? "bi-check-circle" : "bi-info-circle") mt-0.5" aria-hidden="true"></i>
                <span>@quickFillNotice</span>
            </div>
        }
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

    <!-- Allergens List -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 lg:col-span-2">
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Allergens on this menu</h2>
            <span class="text-sm text-gray-500">@rows.Count</span>
        </div>
        <div class="px-2 py-2 sm:px-4">
            @if (rows.Any())
            {
                <table class="w-full text-left text-sm">
                    <thead class="text-xs text-gray-500 uppercase">
                        <tr>
                            <th class="py-2 px-2 sm:px-3 font-medium w-12">Code</th>
                            <th class="py-2 px-2 sm:px-3 font-medium">Name</th>
                            <th class="py-2 px-2 sm:px-3 font-medium whitespace-nowrap">Used by</th>
                            @if (canEdit || canDelete)
                            {
                                <th class="py-2 px-2 sm:px-3"><span class="sr-only">Actions</span></th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var row in rows)
                        {
                            var item = row.Allergen;
                            <tr class="hover:bg-gray-50">
                                <td class="py-2 px-2 sm:px-3 font-mono font-semibold text-gray-900">@item.Code</td>
                                <td class="py-2 px-2 sm:px-3 text-gray-800">@item.Name</td>
                                <td class="py-2 px-2 sm:px-3 whitespace-nowrap" data-testid="allergen-usage">
                                    @if (row.UsageCount > 0)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700">@ItemCount(row.UsageCount)</span>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-gray-400">Not used</span>
                                    }
                                </td>
                                @if (canEdit || canDelete)
                                {
                                    <td class="py-2 px-2 sm:px-3 text-right">
                                        <SpeiseDirekt3.Components.HelperComp.ActionSubMenu Edit="canEdit ? () => EditAllergen(item) : null"
                                                                                           Delete="canDelete ? () => DeleteAllergen(item.Id) : null" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="px-2 py-6 text-center text-gray-500">
                    No allergens yet.
                    @if (canCreate)
                    {
                        <text>Add the 14 EU allergens with one click or enter your own codes.</text>
                    }
                </p>
            }
        </div>
    </div>

    @if (canCreate)
    {
        <!-- Add New Allergen Form -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-900">Add New Allergen</h2>
            </div>
            <div class="p-6">
                <EditForm @ref="editForm" EditContext="editContext" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />

                    <div class="mb-4">
                        <label for="Input.Code" class="block text-sm font-medium text-gray-700 mb-1">Code</label>
                        <InputText @bind-Value="Input.Code" id="Input.Code" placeholder="e.g. A" class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        <ValidationMessage For="() => Input.Code" class="text-red-600 text-sm mt-1" />
                    </div>

                    <div class="mb-4">
                        <label for="Input.Name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
                        <InputText @bind-Value="Input.Name" id="Input.Name" placeholder="e.g. Glutenhaltiges Getreide" class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        <ValidationMessage For="() => Input.Name" class="text-red-600 text-sm mt-1" />
                    </div>

                    <button type="submit" class="w-full bg-blue-600 text-white font-medium py-2.5 rounded-lg hover:bg-blue-700 transition-colors">
                        Add Allergen
                    </button>
                </EditForm>
            </div>
        </div>
    }
</div>

<!-- Allergen Editor Modal -->
<AllergenEditor @ref="allergenEditor" OnOk="HandleOk" OnCancel="HandleCancel" />


@code {
    [Parameter]
    public string MenuId { get; set; }

    [Inject]
    public ApplicationDbContext Context { get; set; }
    [Inject]
    public AuthenticationStateProvider AuthenticationStateProvider { get; set; }
    [Inject]
    public INotificationService NotificationService { get; set; }
    [Inject]
    public IPermissionService PermissionService { get; set; }

    /// <summary>An allergen of the menu and the number of menu items that carry it.</summary>
    sealed record AllergenRow(Allergen Allergen, int UsageCount);

    List<AllergenRow> rows = [];
    bool canCreate, canEdit, canDelete;

    Allergen Input { get; set; } = new();
    AllergenEditor allergenEditor;
    EditContext editContext = new EditContext(new Allergen());
    EditForm editForm;
    Menu? menu;

    string? quickFillNotice;
    bool quickFillAddedAny;
    bool quickFillBusy;

    bool AllEuAllergensPresent => EuAllergens.Missing(rows.Select(r => r.Allergen.Code)).Count == 0;
    bool UsesGermanNames => (menu?.Language ?? MenuLanguage.German) == MenuLanguage.German;

    static string ItemCount(int count) => count == 1 ? "1 item" : $"{count} items";

    protected override Task OnParametersSetAsync()
    {
        editContext = new EditContext(Input);
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        canCreate = await PermissionService.HasPermissionAsync(Permission.AllergensCreate);
        canEdit = await PermissionService.HasPermissionAsync(Permission.AllergensEdit);
        canDelete = await PermissionService.HasPermissionAsync(Permission.AllergensDelete);
        await LoadAllergensAsync();
        Input = new()
            {
                MenuId = new Guid(MenuId)
            };
    }

    async Task SaveAsync()
    {
        if (!canCreate) return;
        try
        {
            editContext = new EditContext(Input);
            editForm.EditContext = editContext;
            if (!editContext.Validate())
                return;

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState?.User?.Identity?.IsAuthenticated != true)
            {
                var messages = new ValidationMessageStore(editContext);
                messages.Add(() => Input.Code, "You must be logged in to add allergens.");
                editContext.NotifyValidationStateChanged();
                StateHasChanged();
                return;
            }

            var codeExists = await Context.Allergens.AnyAsync(a => a.MenuId == Guid.Parse(MenuId) && a.Code == Input.Code);
            if (codeExists)
            {
                var messages = new ValidationMessageStore(editContext);
                messages.Add(() => Input.Code, "This code already exists for this menu.");
                editContext.NotifyValidationStateChanged();
                StateHasChanged();
                return;
            }

            Input.MenuId = new Guid(MenuId);

            Context.Allergens.Add(Input);
            await Context.SaveChangesAsync();

            Input = new()
                {
                    MenuId = new Guid(MenuId)
                };
            quickFillNotice = null;
            await LoadAllergensAsync();
        }
        catch (Exception ex)
        {
            var messages = new ValidationMessageStore(editContext);
            messages.Add(() => Input.Code, $"Error adding allergen: {ex.Message}");
            editContext.NotifyValidationStateChanged();
            StateHasChanged();
            Console.WriteLine($"Error in SaveAsync: {ex}");
        }
    }

    /// <summary>
    /// Adds those of the 14 EU allergens whose code does not exist on this menu yet (codes compared
    /// case-insensitively, against the database rather than the possibly stale list on screen).
    /// </summary>
    async Task AddEuAllergensAsync()
    {
        if (!canCreate || quickFillBusy) return;
        quickFillBusy = true;
        try
        {
            var menuId = Guid.Parse(MenuId);
            var existingCodes = await Context.Allergens.Where(a => a.MenuId == menuId).Select(a => a.Code).ToListAsync();
            var language = (await Context.Menus.Where(m => m.Id == menuId).Select(m => (MenuLanguage?)m.Language).SingleOrDefaultAsync())
                           ?? MenuLanguage.German;
            var missing = EuAllergens.Missing(existingCodes);

            foreach (var entry in missing)
                Context.Allergens.Add(new Allergen { MenuId = menuId, Code = entry.Code, Name = entry.NameFor(language) });
            if (missing.Count > 0)
                await Context.SaveChangesAsync();

            var alreadyThere = EuAllergens.All.Count - missing.Count;
            quickFillAddedAny = missing.Count > 0;
            quickFillNotice = missing.Count == 0
                ? $"No allergens added: all {EuAllergens.All.Count} EU allergens already existed."
                : $"{missing.Count} {(missing.Count == 1 ? "allergen" : "allergens")} added, {alreadyThere} already existed.";
            await LoadAllergensAsync();
        }
        catch (Exception ex)
        {
            quickFillAddedAny = false;
            quickFillNotice = $"Could not add the EU allergens: {ex.Message}";
            Console.WriteLine($"Error in AddEuAllergensAsync: {ex}");
        }
        finally
        {
            quickFillBusy = false;
        }
    }

    async void EditAllergen(Allergen allergen)
    {
        allergenEditor.Input = allergen;
        await allergenEditor.ShowModal();
    }

    async Task HandleOk(Allergen allergen)
    {
        try
        {
            Context.Allergens.Update(allergen);
            await Context.SaveChangesAsync();
            await LoadAllergensAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating allergen: {ex}");
        }
    }

    async Task HandleCancel()
    {
        allergenEditor.Input = new()
            {
                MenuId = new Guid(MenuId)
            };
    }

    async Task DeleteAllergen(Guid id)
    {
        if (!canDelete) return;
        try
        {
            var allergen = await Context.Allergens.FindAsync(id);
            if (allergen is not null)
            {
                // Count fresh from the database: an item may have been tagged since the list was loaded
                var usage = await Context.Allergens.Where(a => a.Id == id).Select(a => a.MenuItems.Count).SingleAsync();
                var message = usage > 0
                    ? $"The allergen \"{allergen.Code} – {allergen.Name}\" is used by {ItemCount(usage)}. Deleting it removes it from {(usage == 1 ? "that item" : "these items")}. Delete anyway?"
                    : $"Are you sure you want to delete the allergen \"{allergen.Name}\"?";
                var res = await NotificationService.ShowConfirmation(("Delete", message));
                if (res)
                {
                    Context.Allergens.Remove(allergen);
                    await Context.SaveChangesAsync();
                    quickFillNotice = null;
                    await LoadAllergensAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting allergen: {ex}");
        }
    }

    async Task LoadAllergensAsync()
    {
        var menuId = Guid.Parse(MenuId);
        menu = await Context.Menus.FindAsync(menuId);
        // One query: the allergens with the number of items that use them (correlated count over the join table)
        rows = await Context.Allergens
            .Where(a => a.MenuId == menuId)
            .OrderBy(a => a.Code)
            .Select(a => new AllergenRow(a, a.MenuItems.Count))
            .ToListAsync();
        await InvokeAsync(StateHasChanged);
    }
}
