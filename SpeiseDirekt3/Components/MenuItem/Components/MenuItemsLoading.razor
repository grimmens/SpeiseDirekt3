@page "/MenuItems/{MenuId}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SpeiseDirekt.Data
@using SpeiseDirekt.Infrastructure
@using SpeiseDirekt.Model
@using SpeiseDirekt.ServiceInterface
@attribute [Authorize]
@inject NavigationManager Navigation
@inject IPermissionService PermissionService
@inject IStringLocalizer<ItemsText> T
@inject IStringLocalizer<CommonText> C

<PageTitle>@(state == State.Loading ? C["Loading"] : C["PageTitle", T["Title"]])</PageTitle>

@if (state != State.Loading)
{
    <div class="max-w-6xl mx-auto p-[1rem] sm:p-6 space-y-6">
        @* "Menus › menu" is in the menu context bar (Layout/MenuContextBar) *@
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 px-6 py-12 text-center" data-testid="menu-items-no-categories">
            <div class="mx-auto h-12 w-12 text-gray-400 mb-3">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h7"></path>
                </svg>
            </div>
            @if (state == State.MenuNotFound)
            {
                <h1 class="text-lg font-semibold text-gray-900 mb-1">@T["Loading_NotFoundTitle"]</h1>
                <p class="text-sm text-gray-500 mb-6">@T["Loading_NotFoundText"]</p>
                <a href="/menus" class="inline-flex items-center px-[1rem] py-2 text-sm font-medium bg-brand-600 hover:bg-brand-700 text-white rounded-lg transition-colors no-underline">@T["BackToMenus"]</a>
            }
            else
            {
                <h1 class="text-lg font-semibold text-gray-900 mb-1">@T["Loading_NoCategoriesTitle"]</h1>
                <p class="text-sm text-gray-500 mb-6">
                    @T["Loading_NoCategoriesText"]
                    @(canCreateCategories ? T["Loading_AddCategoryFirst"] : T["Loading_CategoryNeeded"])
                </p>
                @if (canCreateCategories)
                {
                    <a href="@($"/Categories/{MenuId}")" class="inline-flex items-center px-[1rem] py-2 text-sm font-medium bg-brand-600 hover:bg-brand-700 text-white rounded-lg transition-colors no-underline">
                        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        @T["Loading_AddCategory"]
                    </a>
                }
            }
        </div>
    </div>
}


@code {
    [Parameter]
    public string MenuId { get; set; }
    [Inject] public ApplicationDbContext Context { get; set; }

    private enum State { Loading, MenuNotFound, NoCategories }
    private State state = State.Loading;
    private Menu? menu;
    private bool canCreateCategories;

    protected override async Task OnInitializedAsync()
    {
        menu = Guid.TryParse(MenuId, out var menuId) ? await Context.Menus.FindAsync(menuId) : null;

        if (menu == null)
        {
            state = State.MenuNotFound;
            return;
        }

        var firstCategory = await Context.Categories
            .Where(c => c.MenuId == menu.Id)
            .InDisplayOrder()
            .FirstOrDefaultAsync();

        if (firstCategory is null)
        {
            canCreateCategories = await PermissionService.HasPermissionAsync(Permission.CategoriesCreate);
            state = State.NoCategories;
            return;
        }

        Navigation.NavigateTo($"/MenuItems/Category/{firstCategory.Id}", replace: true);
    }
}
