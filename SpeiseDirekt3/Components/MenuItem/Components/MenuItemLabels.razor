@using SpeiseDirekt.Infrastructure
@using SpeiseDirekt.Model
@* Labels (ItemLabels, back-office texts) and allergen codes of a menu item as small chips (back office, English). *@

@if (HasLabels)
{
    <div class="flex flex-wrap gap-1 @Class" data-testid="item-labels">
        @foreach (var label in labels)
        {
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium border @ChipClass(label)"
                  data-label="@label.Key">@label.BackOfficeText</span>
        }
        @foreach (var allergen in Item.Allergens.OrderBy(a => a.Code, StringComparer.Ordinal))
        {
            <span class="inline-flex items-center justify-center min-w-[1.5rem] px-1.5 py-0.5 rounded text-xs font-semibold bg-gray-100 text-gray-700 border border-gray-200"
                  title="@($"Allergen {allergen.Code}: {allergen.Name}")" data-testid="allergen-chip">@allergen.Code</span>
        }
    </div>
}
else if (ShowPlaceholder)
{
    <span class="text-gray-300" aria-label="No labels">—</span>
}

@code {
    [Parameter, EditorRequired] public MenuItem Item { get; set; } = default!;
    [Parameter] public string? Class { get; set; }
    /// <summary>Render a dash when the item has no labels (table cells).</summary>
    [Parameter] public bool ShowPlaceholder { get; set; }

    private IReadOnlyList<ItemLabel> labels = Array.Empty<ItemLabel>();

    protected override void OnParametersSet() => labels = ItemLabels.ActiveFor(Item);

    private bool HasLabels => labels.Count > 0 || Item.Allergens.Any();

    /// <summary>Chip colours per label key (back office only; the guest view styles labels per theme).</summary>
    internal static string ChipClass(ItemLabel label) => label.Key switch
    {
        "popular" => "bg-amber-50 text-amber-800 border-amber-200",
        "new" => "bg-violet-50 text-violet-700 border-violet-200",
        "vegan" => "bg-green-50 text-green-700 border-green-200",
        "vegetarian" => "bg-lime-50 text-lime-700 border-lime-200",
        "halal" => "bg-teal-50 text-teal-700 border-teal-200",
        "alcohol-free" => "bg-sky-50 text-sky-700 border-sky-200",
        "spicy" => "bg-red-50 text-red-700 border-red-200",
        _ => "bg-gray-50 text-gray-700 border-gray-200"
    };
}
