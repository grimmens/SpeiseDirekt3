@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using SpeiseDirekt3.Components.Shared
@using SpeiseDirekt3.Components.Shared.Sortable
@using SpeiseDirekt.Data
@using SpeiseDirekt.Infrastructure
@using SpeiseDirekt.Model
@using Microsoft.AspNetCore.Components.Forms
@using SpeiseDirekt.ServiceInterface
@inject ApplicationDbContext Context
@inject INotificationService NotificationService
@inject IImageUploadService ImageUploadService
@inject IPermissionService PermissionService
@inject IOptions<MenuItemGeneratorOptions> GeneratorOptions
@inject IJSRuntime JS

@if (Category != null)
{
    <section class="bg-white rounded-xl shadow-sm border border-gray-200" data-testid="menu-items" aria-label="@($"Items in {Category.Name}")">
        @if (MenuItems.Any())
        {
            <!-- Toolbar -->
            <div class="sd-card-head">
                <div class="flex flex-wrap items-center gap-2">
                    @if (canCreate)
                    {
                        <a href="@NewItemHref" class="sd-btn sd-btn--primary" data-testid="new-item-link">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                            New Menu Entry
                        </a>
                        @if (GeneratorEnabled)
                        {
                            @GenerateButton
                        }
                    }
                </div>
                <div class="ml-auto flex flex-wrap items-center justify-end gap-x-3 gap-y-2">
                    @if (canEdit && MenuItems.Count > 1)
                    {
                        <span class="sd-card-hint hidden sm:inline">Drag the handle to change the order.</span>
                    }
                    <span class="sd-count" data-testid="menu-item-count">@MenuItems.Count item@(MenuItems.Count == 1 ? "" : "s")</span>
                    @if (canDelete)
                    {
                        <button type="button"
                                class="inline-flex items-center px-[0.75rem] py-2 text-sm font-semibold rounded-lg border border-red-300 text-red-700 bg-white hover:bg-red-50 disabled:opacity-50 disabled:cursor-not-allowed transition"
                                @onclick="DeleteAll"
                                disabled="@isWorking">
                            Delete All
                        </button>
                    }
                </div>
            </div>

            @if (errorMessage is not null)
            {
                <div class="mx-[1rem] sm:mx-6 mt-[1rem] rounded-lg border border-red-200 bg-red-50 px-[1rem] py-[0.75rem] text-sm text-red-800 flex items-start justify-between gap-3" role="alert" data-testid="items-error">
                    <span>@errorMessage</span>
                    <button type="button" class="text-red-700 hover:text-red-900" aria-label="Dismiss" @onclick="() => errorMessage = null">&times;</button>
                </div>
            }

            <!-- Desktop table (from 1280 px) -->
            <div class="hidden xl:block">
                <table class="min-w-full">
                    <thead class="sd-thead">
                        <tr>
                            @if (canEdit)
                            {
                                <th class="pl-3 pr-0 py-[0.625rem] text-left w-px"><span class="sr-only">Order</span></th>
                            }
                            <th class="px-[0.75rem] py-[0.625rem] text-left">Name</th>
                            <th class="px-[0.75rem] py-[0.625rem] text-right">Price</th>
                            <th class="px-[0.75rem] py-[0.625rem] text-left">Labels</th>
                            <th class="px-[0.75rem] py-[0.625rem] text-left">Description</th>
                            @if (canEdit || canDelete)
                            {
                                <th class="pl-[0.75rem] pr-4 py-[0.625rem] text-right w-px"><span class="sr-only">Actions</span></th>
                            }
                        </tr>
                    </thead>
                    <SortableList TItem="MenuItem" Element="tbody" RowElement="tr" Items="MenuItems" KeyOf="m => m.Id" NameOf="m => m.Name"
                                  OnMove="@(canEdit ? MoveMenuItemAsync : null)" class="bg-white divide-y divide-gray-100"
                                  RowClass="hover:bg-gray-50 transition-colors duration-150" RowClassOf="HighlightClass"
                                  RowAttributes="@(m => RowAttributes(m, "menu-item-row"))">
                        <ChildContent Context="row">
                            @{ var item = row.Item; }
                            @if (canEdit)
                            {
                                <td class="pl-3 pr-0 py-2 whitespace-nowrap align-middle">@row.Handle</td>
                            }
                            <td class="px-[0.75rem] py-[0.75rem] text-sm font-medium text-gray-900 align-middle">
                                <div class="flex items-center gap-x-3 min-w-[10rem]">
                                    @if (!string.IsNullOrEmpty(item.ImagePath))
                                    {
                                        <img src="@ImageUploadService.GetImageUrl(item.ImagePath)" alt=""
                                             class="w-10 h-10 flex-shrink-0 object-cover rounded-md border border-gray-200" />
                                    }
                                    @ItemName(item)
                                </div>
                            </td>
                            <td class="px-[0.75rem] py-[0.75rem] whitespace-nowrap text-right text-sm font-semibold text-gray-900 tabular-nums align-middle">@PriceCell(item)</td>
                            <td class="px-[0.75rem] py-[0.75rem] align-middle"><MenuItemLabels Item="item" ShowPlaceholder="true" /></td>
                            <td class="px-[0.75rem] py-[0.75rem] text-sm text-gray-600 align-middle max-w-md">
                                @if (string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <span class="text-gray-300" aria-label="No description">—</span>
                                }
                                else
                                {
                                    <p class="line-clamp-2 mb-0" title="@item.Description">@item.Description</p>
                                }
                            </td>
                            @if (canEdit || canDelete)
                            {
                                <td class="pl-[0.75rem] pr-3 py-2 whitespace-nowrap align-middle">@ItemActions(item)</td>
                            }
                        </ChildContent>
                    </SortableList>
                </table>
            </div>

            <!-- Phone/tablet: cards -->
            <SortableList TItem="MenuItem" Element="ul" RowElement="li" Items="MenuItems" KeyOf="m => m.Id" NameOf="m => m.Name"
                          OnMove="@(canEdit ? MoveMenuItemAsync : null)" class="xl:hidden divide-y divide-gray-100 list-none m-0 p-0"
                          RowClass="bg-white px-[0.5rem] py-[0.75rem] sm:px-4" RowClassOf="HighlightClass"
                          RowAttributes="@(m => RowAttributes(m, "menu-item-card"))">
                <ChildContent Context="row">
                    @{ var item = row.Item; }
                    <div class="flex items-start gap-x-1.5">
                        @if (canEdit)
                        {
                            <div class="-mt-0.5">@row.Handle</div>
                        }
                        <div class="min-w-0 flex-1 @(canEdit ? "" : "pl-[0.5rem]")">
                            <div class="flex items-start gap-x-3">
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@ImageUploadService.GetImageUrl(item.ImagePath)" alt=""
                                         class="w-12 h-12 flex-shrink-0 object-cover rounded-lg border border-gray-200" />
                                }
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-start justify-between gap-x-3">
                                        <h3 class="text-base font-semibold text-gray-900 break-words mb-0">@ItemName(item)</h3>
                                        <span class="text-base font-semibold text-gray-900 whitespace-nowrap tabular-nums text-right">@PriceCell(item)</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <p class="mt-1 mb-0 text-sm text-gray-600 line-clamp-2 break-words" title="@item.Description">@item.Description</p>
                                    }
                                </div>
                            </div>
                            <div class="mt-1.5 flex flex-wrap items-center justify-between gap-x-2 gap-y-1">
                                <MenuItemLabels Item="item" />
                                @if (canEdit || canDelete)
                                {
                                    <div class="ml-auto -mr-1.5 -my-1">@ItemActions(item)</div>
                                }
                            </div>
                        </div>
                    </div>
                </ChildContent>
            </SortableList>
        }
        else
        {
            @if (errorMessage is not null)
            {
                <div class="mx-[1rem] sm:mx-6 mt-[1rem] rounded-lg border border-red-200 bg-red-50 px-[1rem] py-[0.75rem] text-sm text-red-800" role="alert">@errorMessage</div>
            }
            <!-- Empty State -->
            <div class="sd-empty" data-testid="menu-items-empty">
                <span class="sd-empty-icon" aria-hidden="true">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="@PageIcons.Items.Path" /></svg>
                </span>
                <h3 class="sd-empty-title">No items in @Category.Name yet</h3>
                <p class="sd-empty-text mb-4">Add the dishes or drinks guests can order in this category.</p>
                @if (canCreate)
                {
                    <div class="flex flex-wrap justify-center gap-2">
                        <a href="@NewItemHref" class="sd-btn sd-btn--primary" data-testid="new-item-link">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                            New Menu Entry
                        </a>
                        @if (GeneratorEnabled)
                        {
                            @GenerateButton
                        }
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    [Parameter] public Category Category {
        get {
            return category;
        }
        set
        {
            if(value?.Id != category?.Id)
            {
                category = value;
                InvokeAsync(OnCategoryChangedAsync);
            }
            else
            {
                category = value;
            }
        }
    }
    [Parameter] public List<Category> Categories { get; set; }

    /// <summary>The item just saved or opened on the edit page (?highlight=): scrolled into view and highlighted once.</summary>
    [Parameter] public Guid? HighlightId { get; set; }

    [Inject] private IMenuItemGenerator MenuItemGenerator { get; set; }

    private bool canCreate, canEdit, canDelete;
    private Category category;
    private SemaphoreSlim semaphoreSlim = new(1);
    List<MenuItem> MenuItems = new();
    List<Allergen> availableAllergens = new();

    private bool isWorking;
    private string? errorMessage;
    private bool revealHighlight;

    private string NewItemHref => $"/MenuItems/Category/{Category.Id}/new";
    private static string EditHref(MenuItem item) => $"/MenuItems/item/{item.Id}/edit";

    private string? HighlightClass(MenuItem item) => item.Id == HighlightId ? "sd-row-highlight" : null;

    private IReadOnlyDictionary<string, object> RowAttributes(MenuItem item, string testId)
    {
        var attributes = new Dictionary<string, object> { ["data-testid"] = testId, ["data-item-id"] = item.Id.ToString() };
        if (item.Id == HighlightId)
            attributes["data-highlighted"] = "true";
        return attributes;
    }

    /// <summary>The Ollama generator only works where an Ollama server runs (configuration MenuItemGenerator:Enabled).</summary>
    private bool GeneratorEnabled => GeneratorOptions.Value.Enabled;

    /// <summary>Secondary button for the Ollama generator; rendered only when <see cref="GeneratorEnabled"/>.</summary>
    private RenderFragment GenerateButton => @<button type="button" @onclick="CreateNewMenuEntries"
                class="inline-flex items-center px-[1rem] py-2 text-sm font-medium rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition"
                disabled="@isWorking">
            @if (isWorking)
            {
                <svg class="inline w-4 h-4 me-2 animate-spin" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                </svg>
                <span>Generating...</span>
            }
            else
            {
                <span>Generate Menu Items</span>
            }
        </button>;

    /// <summary>"€ 9.50", or "from € 3.40" plus "2 variants · 1 extra" when the item has price options.</summary>
    private static RenderFragment PriceCell(MenuItem item) => __builder =>
    {
        var variants = item.Variants().Count;
        var extras = item.Extras().Count;
        <span data-testid="item-price">@(variants > 0 ? "from " : "")@PriceFormat.Euro(item.Price)</span>
        @if (variants > 0 || extras > 0)
        {
            <span class="block text-xs font-normal text-gray-500" data-testid="item-price-options">@OptionSummary(variants, extras)</span>
        }
    };

    private static string OptionSummary(int variants, int extras) => string.Join(" · ", new[]
    {
        variants > 0 ? $"{variants} variant{(variants == 1 ? "" : "s")}" : null,
        extras > 0 ? $"{extras} extra{(extras == 1 ? "" : "s")}" : null
    }.Where(t => t is not null));

    /// <summary>The item's name; a link to its edit page for editors.</summary>
    private RenderFragment ItemName(MenuItem item) => __builder =>
    {
        if (canEdit)
        {
            <a href="@EditHref(item)" class="text-gray-900 hover:text-brand-700 hover:underline break-words">@item.Name</a>
        }
        else
        {
            <span class="break-words">@item.Name</span>
        }
    };

    private RenderFragment ItemActions(MenuItem item) => @<div class="flex items-center justify-end gap-0.5">
        @if (canEdit)
        {
            <a href="@EditHref(item)" title="Edit" aria-label="@($"Edit {item.Name}")" class="sd-row-action">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
            </a>
        }
        @if (canDelete)
        {
            <button type="button" title="Delete" aria-label="@($"Delete {item.Name}")" class="sd-row-action sd-row-action--danger"
                    @onclick="() => DeleteMenuItem(item.Id)">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
            </button>
        }
    </div>;

    async Task OnCategoryChangedAsync()
    {
        if (Category != null)
        {
            canCreate = await PermissionService.HasPermissionAsync(Permission.MenuItemsCreate);
            canEdit = await PermissionService.HasPermissionAsync(Permission.MenuItemsEdit);
            canDelete = await PermissionService.HasPermissionAsync(Permission.MenuItemsDelete);
            await LoadItems();
            revealHighlight = HighlightId is { } id && MenuItems.Any(m => m.Id == id);
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!revealHighlight || HighlightId is not { } id)
            return;
        revealHighlight = false;
        try
        {
            await JS.InvokeAsync<bool>("sdShell.revealRow", $"[data-item-id=\"{id}\"]");
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    async Task LoadItems()
    {
        await semaphoreSlim.WaitAsync();
        try
        {
            MenuItems = await Context.MenuItems
                .Include(m => m.Allergens)
                .Include(m => m.PriceOptions)
                .Where(m => m.CategoryId == Category.Id)
                .InDisplayOrder()
                .ToListAsync();
            availableAllergens = await Context.Allergens
                .Where(a => a.MenuId == Category.MenuId)
                .OrderBy(a => a.Code)
                .ToListAsync();
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            semaphoreSlim.Release();
        }
    }

    /// <summary>
    /// A row was dragged (or moved with the arrow keys): show the new order at once, then renumber all items of the
    /// category in that order and save once. A failed save shows the stored order again with a message.
    /// </summary>
    async Task<bool> MoveMenuItemAsync(SortableMove move)
    {
        if (!canEdit) return false;
        var moved = MenuItems[move.OldIndex];
        var reordered = MenuItems.ToList();
        reordered.RemoveAt(move.OldIndex);
        reordered.Insert(move.NewIndex, moved);
        MenuItems = reordered;
        errorMessage = null;
        StateHasChanged();
        await Task.Yield(); // render the optimistic order before the database round trip

        try
        {
            var siblings = await Context.MenuItems
                .Where(m => m.CategoryId == Category.Id)
                .InDisplayOrder()
                .ToListAsync();
            var from = siblings.FindIndex(m => m.Id == moved.Id);
            if (from < 0)
                throw new InvalidOperationException("The item no longer exists.");
            var to = Math.Clamp(move.NewIndex, 0, siblings.Count - 1);
            if (DisplayOrder.Move(siblings, from, to - from, (m, i) => m.SortOrder = i))
                await Context.SaveChangesAsync();
            await LoadItems();
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error moving menu item: {ex}");
            Context.ChangeTracker.Clear(); // drop the unsaved SortOrder values
            errorMessage = $"The new position of \"{moved.Name}\" could not be saved. The previous order is shown again.";
            await LoadItems();
            return false;
        }
    }

    async Task DeleteMenuItem(Guid id)
    {
        if (!canDelete) return;
        var item = await Context.MenuItems.FindAsync(id);
        if (item != null)
        {
            var confirm = await NotificationService.ShowConfirmation(("Delete", $"Delete \"{item.Name}\"?"));
            if (confirm)
            {
                try
                {
                    // Guest click rows reference the item without cascade; they mean nothing without it
                    await Context.MenuItemClicks.Where(c => c.MenuItemId == id).ExecuteDeleteAsync();
                    Context.MenuItems.Remove(item);
                    await Context.SaveChangesAsync();
                }
                catch (DbUpdateException ex)
                {
                    Console.WriteLine($"Error deleting menu item: {ex}");
                    Context.ChangeTracker.Clear();
                    errorMessage = $"\"{item.Name}\" could not be deleted. It is still used by a combo.";
                }
                await LoadItems();
            }
        }
    }

    async Task CreateNewMenuEntries()
    {
        if (!GeneratorEnabled) return;
        isWorking = true;
        try
        {
            var newEntries = (await MenuItemGenerator.CreateMockMenuEntriesAsync(Category, 10)).ToList();
            if (newEntries.Any())
            {
                await AppendInOrderAsync(newEntries);
                await Context.AddRangeAsync(newEntries);
                await Context.SaveChangesAsync();
                await LoadItems();
                Console.WriteLine($"Successfully generated {newEntries.Count} AI menu items!");
            }
            else
            {
                Console.WriteLine("Warning: AI service is not available. Generating fallback menu items...");
                await CreateFallbackMenuItems();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error generating AI menu entries: {ex.Message}");
            Console.WriteLine("AI service unavailable. Generating fallback menu items...");
            await CreateFallbackMenuItems();
        }
        finally
        {
            isWorking = false;
        }
    }

    /// <summary>Gives generated items consecutive SortOrder values after the existing items.</summary>
    async Task AppendInOrderAsync(IEnumerable<MenuItem> items)
    {
        var next = await Context.NextMenuItemSortOrderAsync(Category.Id);
        foreach (var item in items)
            item.SortOrder = next++;
    }

    async Task CreateFallbackMenuItems()
    {
        try
        {
            var fallbackItems = GenerateFallbackMenuItems(Category, 5);
            await AppendInOrderAsync(fallbackItems);
            await Context.AddRangeAsync(fallbackItems);
            await Context.SaveChangesAsync();
            await LoadItems();
            Console.WriteLine($"Generated {fallbackItems.Count} fallback menu items for category: {Category.Name}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating fallback menu items: {ex.Message}");
        }
    }

    List<MenuItem> GenerateFallbackMenuItems(Category category, int count)
    {
        var items = new List<MenuItem>();
        var random = new Random();
        var allergensByCode = availableAllergens.ToDictionary(a => a.Code, a => a);

        // Sample menu items based on category name
        var sampleItems = GetSampleItemsForCategory(category.Name.ToLower());

        for (int i = 0; i < count && i < sampleItems.Count; i++)
        {
            var sample = sampleItems[i];
            var allergens = sample.AllergenCodes
                .Where(c => allergensByCode.ContainsKey(c))
                .Select(c => allergensByCode[c])
                .ToList();
            items.Add(new MenuItem
            {
                Id = Guid.NewGuid(),
                Name = sample.Name,
                Description = sample.Description,
                Allergens = allergens,
                Price = (decimal)(random.NextDouble() * 15.0 + 5.0),
                CategoryId = category.Id
            });
        }

        return items;
    }

    List<(string Name, string Description, string[] AllergenCodes)> GetSampleItemsForCategory(string categoryName)
    {
        // Default items that work for most categories
        var defaultItems = new List<(string, string, string[])>
        {
            ("Klassisches Gericht", "Ein traditionelles und beliebtes Gericht", new[] { "A", "G" }),
            ("Hausgemachte Spezialität", "Nach unserem besonderen Rezept zubereitet", new[] { "A" }),
            ("Saisonale Auswahl", "Mit frischen, saisonalen Zutaten", Array.Empty<string>()),
            ("Chef's Empfehlung", "Vom Küchenchef persönlich empfohlen", new[] { "A", "G" }),
            ("Regionale Köstlichkeit", "Mit lokalen Zutaten zubereitet", new[] { "G" })
        };

        if (categoryName.Contains("vorspeise") || categoryName.Contains("starter"))
        {
            return new List<(string, string, string[])>
            {
                ("Bruschetta", "Geröstetes Brot mit Tomaten und Basilikum", new[] { "A" }),
                ("Carpaccio", "Hauchdünn geschnittenes Rindfleisch", new[] { "G" }),
                ("Suppe des Tages", "Täglich wechselnde hausgemachte Suppe", Array.Empty<string>()),
                ("Antipasti Teller", "Auswahl italienischer Vorspeisen", new[] { "A", "G" }),
                ("Caesar Salad", "Klassischer Salat mit Parmesan", new[] { "A", "G", "C" })
            };
        }
        else if (categoryName.Contains("hauptgang") || categoryName.Contains("main"))
        {
            return new List<(string, string, string[])>
            {
                ("Schnitzel Wiener Art", "Paniertes Kalbsschnitzel mit Zitrone", new[] { "A", "C" }),
                ("Pasta Carbonara", "Spaghetti mit Speck und Ei", new[] { "A", "G", "C" }),
                ("Gegrilltes Lachs", "Mit Kräuterbutter und Gemüse", new[] { "D", "G" }),
                ("Rinderfilet", "Medium gebraten mit Pfeffersauce", new[] { "G" }),
                ("Vegetarische Lasagne", "Mit Gemüse und Béchamelsauce", new[] { "A", "G" })
            };
        }
        else if (categoryName.Contains("dessert") || categoryName.Contains("nachspeise"))
        {
            return new List<(string, string, string[])>
            {
                ("Tiramisu", "Klassisches italienisches Dessert", new[] { "A", "G", "C" }),
                ("Schokoladenkuchen", "Warmer Kuchen mit Vanilleeis", new[] { "A", "G", "C" }),
                ("Panna Cotta", "Mit Beerensauce", new[] { "G" }),
                ("Apfelstrudel", "Mit Vanillesauce", new[] { "A", "G", "C" }),
                ("Eis-Variation", "Drei Kugeln nach Wahl", new[] { "G" })
            };
        }
        else if (categoryName.Contains("getränk") || categoryName.Contains("drink"))
        {
            return new List<(string, string, string[])>
            {
                ("Hauswein", "Rotwein oder Weißwein", new[] { "L" }),
                ("Craft Beer", "Lokales Bier vom Fass", new[] { "A" }),
                ("Espresso", "Italienischer Kaffee", Array.Empty<string>()),
                ("Frischer Orangensaft", "Täglich gepresst", Array.Empty<string>()),
                ("Mineralwasser", "Still oder sprudelnd", Array.Empty<string>())
            };
        }

        return defaultItems;
    }

    async Task DeleteAll()
    {
        if (!canDelete || !MenuItems.Any()) return;
        var count = MenuItems.Count;
        var confirm = await NotificationService.ShowConfirmation(("Delete all items",
            $"Delete all {count} item{(count == 1 ? "" : "s")} in \"{Category.Name}\"? This cannot be undone."));
        if (!confirm) return;

        isWorking = true;
        try
        {
            await Context.MenuItemClicks
                .Where(c => Context.MenuItems.Any(i => i.Id == c.MenuItemId && i.CategoryId == Category.Id))
                .ExecuteDeleteAsync();
            Context.RemoveRange(Context.MenuItems.Where(e => e.CategoryId == Category.Id));
            await Context.SaveChangesAsync();
        }
        catch (DbUpdateException ex)
        {
            Console.WriteLine($"Error deleting all menu items: {ex}");
            Context.ChangeTracker.Clear();
            errorMessage = $"The items of \"{Category.Name}\" could not be deleted. Some of them are still used by a combo.";
        }
        finally
        {
            isWorking = false;
        }
        await LoadItems();
    }
}
