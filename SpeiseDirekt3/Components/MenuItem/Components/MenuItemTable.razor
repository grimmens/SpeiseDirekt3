@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using SpeiseDirekt3.Components.Shared
@using SpeiseDirekt.Data
@using SpeiseDirekt.Infrastructure
@using SpeiseDirekt.Model
@using Microsoft.AspNetCore.Components.Forms
@using SpeiseDirekt.ServiceInterface
@inject ApplicationDbContext Context
@inject INotificationService NotificationService
@inject IImageUploadService ImageUploadService
@inject IPermissionService PermissionService
@inject IOptions<MenuItemGeneratorOptions> GeneratorOptions

@if (Category != null)
{
    <div class="bg-white rounded-xl shadow-sm border border-gray-200" data-testid="menu-items">
        @if (errorMessage is not null)
        {
            <div class="mx-[1rem] sm:mx-6 mt-[1rem] rounded-lg border border-red-200 bg-red-50 px-[1rem] py-[0.75rem] text-sm text-red-700 flex items-start justify-between gap-3" role="alert">
                <span>@errorMessage</span>
                <button type="button" class="text-red-500 hover:text-red-700" aria-label="Dismiss" @onclick="() => errorMessage = null">&times;</button>
            </div>
        }

        @if (MenuItems.Any())
        {
            <!-- Toolbar -->
            <div class="px-[1rem] sm:px-6 py-[0.75rem] border-b border-gray-200 flex flex-wrap items-center gap-2">
                @if (canCreate)
                {
                    <button type="button" @onclick="CreateNewMenuItem"
                            class="inline-flex items-center px-[1rem] py-2 text-sm font-medium rounded-lg bg-blue-600 text-white hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed transition"
                            disabled="@isWorking">
                        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        New Menu Entry
                    </button>
                    @if (GeneratorEnabled)
                    {
                        @GenerateButton
                    }
                }
                <div class="ml-auto flex items-center gap-2">
                    <span class="text-sm text-gray-500" data-testid="menu-item-count">@MenuItems.Count item@(MenuItems.Count == 1 ? "" : "s")</span>
                    @if (canDelete)
                    {
                        <button type="button"
                                class="inline-flex items-center px-[0.75rem] py-2 text-sm font-medium rounded-lg border border-red-300 text-red-600 bg-white hover:bg-red-50 disabled:opacity-50 disabled:cursor-not-allowed transition"
                                @onclick="DeleteAll"
                                disabled="@isWorking">
                            Delete All
                        </button>
                    }
                </div>
            </div>

            <!-- Desktop Table View -->
            <div class="hidden xl:block overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            @if (canEdit)
                            {
                                <th class="pl-4 pr-1 py-[0.75rem] text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-px"><span class="sr-only">Order</span></th>
                            }
                            <th class="px-[0.75rem] py-[0.75rem] text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                            <th class="px-[0.75rem] py-[0.75rem] text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Price</th>
                            <th class="px-[0.75rem] py-[0.75rem] text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Labels</th>
                            <th class="px-[0.75rem] py-[0.75rem] text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                            @if (canEdit || canDelete)
                            {
                                <th class="pl-[0.75rem] pr-4 py-[0.75rem] text-right text-xs font-medium text-gray-500 uppercase tracking-wider w-px"><span class="sr-only">Actions</span></th>
                            }
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-100">
                        @for (var i = 0; i < MenuItems.Count; i++)
                        {
                            var index = i;
                            var item = MenuItems[index];
                            <tr @key="item.Id" class="hover:bg-gray-50 transition-colors duration-150" data-testid="menu-item-row">
                                @if (canEdit)
                                {
                                    <td class="pl-4 pr-1 py-2 whitespace-nowrap align-middle">@MoveButtons(item, index)</td>
                                }
                                <td class="px-[0.75rem] py-[0.75rem] text-sm font-medium text-gray-900 align-middle">
                                    <div class="flex items-center gap-x-3 min-w-[10rem]">
                                        @if (!string.IsNullOrEmpty(item.ImagePath))
                                        {
                                            <img src="@ImageUploadService.GetImageUrl(item.ImagePath)" alt=""
                                                 class="w-9 h-9 flex-shrink-0 object-cover rounded-md border border-gray-200" />
                                        }
                                        <span>@item.Name</span>
                                    </div>
                                </td>
                                <td class="px-[0.75rem] py-[0.75rem] whitespace-nowrap text-right text-sm font-semibold text-gray-900 tabular-nums align-middle">@PriceFormat.Euro(item.Price)</td>
                                <td class="px-[0.75rem] py-[0.75rem] align-middle"><MenuItemLabels Item="item" ShowPlaceholder="true" /></td>
                                <td class="px-[0.75rem] py-[0.75rem] text-sm text-gray-600 align-middle max-w-md">
                                    @if (string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <span class="text-gray-300" aria-label="No description">—</span>
                                    }
                                    else
                                    {
                                        <p class="line-clamp-2 mb-0" title="@item.Description">@item.Description</p>
                                    }
                                </td>
                                @if (canEdit || canDelete)
                                {
                                    <td class="pl-[0.75rem] pr-4 py-2 whitespace-nowrap align-middle">@ItemActions(item)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile/Tablet Card View -->
            <ul class="xl:hidden divide-y divide-gray-100 list-none m-0 p-0">
                @for (var i = 0; i < MenuItems.Count; i++)
                {
                    var index = i;
                    var item = MenuItems[index];
                    <li @key="item.Id" class="px-[1rem] py-[0.875rem] sm:px-6" data-testid="menu-item-card">
                        <div class="flex items-start gap-x-3">
                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img src="@ImageUploadService.GetImageUrl(item.ImagePath)" alt=""
                                     class="w-12 h-12 flex-shrink-0 object-cover rounded-lg border border-gray-200" />
                            }
                            <div class="min-w-0 flex-1">
                                <div class="flex items-start justify-between gap-x-3">
                                    <h3 class="text-base font-semibold text-gray-900 break-words mb-0">@item.Name</h3>
                                    <span class="text-base font-semibold text-gray-900 whitespace-nowrap tabular-nums">@PriceFormat.Euro(item.Price)</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <p class="mt-1 mb-0 text-sm text-gray-600 line-clamp-2 break-words" title="@item.Description">@item.Description</p>
                                }
                                <MenuItemLabels Item="item" Class="mt-2" />
                            </div>
                        </div>
                        @if (canEdit || canDelete)
                        {
                            <div class="mt-[0.75rem] flex items-center justify-between gap-2">
                                <div>
                                    @if (canEdit)
                                    {
                                        @MoveButtons(item, index)
                                    }
                                </div>
                                @ItemActions(item)
                            </div>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <!-- Empty State -->
            <div class="text-center px-6 py-12" data-testid="menu-items-empty">
                <div class="mx-auto h-12 w-12 text-gray-400 mb-3">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                    </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 mb-1">No items in @Category.Name yet</h3>
                <p class="text-sm text-gray-500 mb-6">Add the dishes or drinks guests can order in this category.</p>
                @if (canCreate)
                {
                    <div class="flex flex-wrap justify-center gap-2">
                        <button type="button" class="inline-flex items-center px-[1rem] py-2 text-sm font-medium bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors disabled:opacity-50"
                                @onclick="CreateNewMenuItem" disabled="@isWorking">
                            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                            New Menu Entry
                        </button>
                        @if (GeneratorEnabled)
                        {
                            @GenerateButton
                        }
                    </div>
                }
            </div>
        }
    </div>
}

<MenuItemEditor @ref="menuItemEditor" OnOk="HandleOk" OnCancel="HandleCancel" SelectedCategory="Category" Categories="Categories" AvailableAllergens="availableAllergens" />


@code {
    [Parameter] public Category Category {
        get {
            return category;
        }
        set
        {
            if(value?.Id != category?.Id)
            {
                category = value;
                InvokeAsync(OnCategoryChangedAsync);
            }
            else
            {
                category = value;
            }
        }
    }
    [Parameter] public List<Category> Categories { get; set; }
    [Inject] private IMenuItemGenerator MenuItemGenerator { get; set; }

    private bool canCreate, canEdit, canDelete;
    private Category category;
    private SemaphoreSlim semaphoreSlim = new(1);
    List<MenuItem> MenuItems = new();
    List<Allergen> availableAllergens = new();
    MenuItem Input = new();
    EditContext editContext;
    EditForm editForm;
    MenuItemEditor menuItemEditor;

    private bool isWorking;
    private bool isMoving;
    private string? errorMessage;

    /// <summary>The Ollama generator only works where an Ollama server runs (configuration MenuItemGenerator:Enabled).</summary>
    private bool GeneratorEnabled => GeneratorOptions.Value.Enabled;

    /// <summary>Secondary button for the Ollama generator; rendered only when <see cref="GeneratorEnabled"/>.</summary>
    private RenderFragment GenerateButton => @<button type="button" @onclick="CreateNewMenuEntries"
                class="inline-flex items-center px-[1rem] py-2 text-sm font-medium rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition"
                disabled="@isWorking">
            @if (isWorking)
            {
                <svg class="inline w-4 h-4 me-2 animate-spin" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                </svg>
                <span>Generating...</span>
            }
            else
            {
                <span>Generate Menu Items</span>
            }
        </button>;

    private RenderFragment MoveButtons(MenuItem item, int index) => @<div class="flex items-center gap-0.5">
        <button type="button" title="Move up" aria-label="@($"Move {item.Name} up")"
                class="p-2 rounded-md text-gray-500 hover:bg-gray-100 hover:text-gray-900 disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent transition-colors"
                disabled="@(index == 0 || isMoving)" @onclick="() => MoveMenuItem(item, -1)">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
            </svg>
        </button>
        <button type="button" title="Move down" aria-label="@($"Move {item.Name} down")"
                class="p-2 rounded-md text-gray-500 hover:bg-gray-100 hover:text-gray-900 disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent transition-colors"
                disabled="@(index == MenuItems.Count - 1 || isMoving)" @onclick="() => MoveMenuItem(item, 1)">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
        </button>
    </div>;

    private RenderFragment ItemActions(MenuItem item) => @<div class="flex items-center justify-end gap-1">
        @if (canEdit)
        {
            <button type="button" title="Edit" aria-label="@($"Edit {item.Name}")"
                    class="p-2 rounded-md text-gray-500 hover:text-blue-700 hover:bg-blue-50 transition-colors"
                    @onclick="() => EditMenuItem(item)">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
            </button>
        }
        @if (canDelete)
        {
            <button type="button" title="Delete" aria-label="@($"Delete {item.Name}")"
                    class="p-2 rounded-md text-gray-500 hover:text-red-700 hover:bg-red-50 transition-colors"
                    @onclick="() => DeleteMenuItem(item.Id)">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
            </button>
        }
    </div>;

    async Task OnCategoryChangedAsync()
    {
        if (Category != null)
        {
            canCreate = await PermissionService.HasPermissionAsync(Permission.MenuItemsCreate);
            canEdit = await PermissionService.HasPermissionAsync(Permission.MenuItemsEdit);
            canDelete = await PermissionService.HasPermissionAsync(Permission.MenuItemsDelete);
            Input = new MenuItem { CategoryId = Category.Id };
            editContext = new EditContext(Input);
            await LoadItems();
        }
    }


    async Task LoadItems()
    {
        await semaphoreSlim.WaitAsync();
        try
        {
            MenuItems = await Context.MenuItems
                .Include(m => m.Allergens)
                .Where(m => m.CategoryId == Category.Id)
                .InDisplayOrder()
                .ToListAsync();
            availableAllergens = await Context.Allergens
                .Where(a => a.MenuId == Category.MenuId)
                .OrderBy(a => a.Code)
                .ToListAsync();
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            semaphoreSlim.Release();
        }
    }

    async Task MoveMenuItem(MenuItem item, int offset)
    {
        if (!canEdit || isMoving) return;
        isMoving = true;
        try
        {
            // Renumber all items of the category in their current order, then save the changed rows
            var siblings = await Context.MenuItems
                .Where(m => m.CategoryId == Category.Id)
                .InDisplayOrder()
                .ToListAsync();
            if (DisplayOrder.Move(siblings, siblings.FindIndex(m => m.Id == item.Id), offset, (m, i) => m.SortOrder = i))
                await Context.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error moving menu item: {ex}");
        }
        finally
        {
            isMoving = false;
        }
        await LoadItems();
    }

    async Task DeleteMenuItem(Guid id)
    {
        if (!canDelete) return;
        var item = await Context.MenuItems.FindAsync(id);
        if (item != null)
        {
            var confirm = await NotificationService.ShowConfirmation(("Delete", $"Delete \"{item.Name}\"?"));
            if (confirm)
            {
                try
                {
                    Context.MenuItems.Remove(item);
                    await Context.SaveChangesAsync();
                }
                catch (DbUpdateException ex)
                {
                    Console.WriteLine($"Error deleting menu item: {ex}");
                    Context.ChangeTracker.Clear();
                    errorMessage = $"\"{item.Name}\" could not be deleted. It is probably still used by a combo or by the guest statistics.";
                }
                await LoadItems();
            }
        }
    }

    async Task CreateNewMenuItem()
    {
        // prepare a fresh model
        menuItemEditor.Input = new MenuItem { CategoryId = Category.Id };
        await menuItemEditor.ShowModal();
    }

    async void EditMenuItem(MenuItem item)
    {
        menuItemEditor.Input = item;
        await menuItemEditor.ShowModal();
    }

    async Task HandleOk(MenuItem item)
    {
        if (item.Id == Guid.Empty)
        {
            // New items go to the end of their category
            item.SortOrder = await Context.NextMenuItemSortOrderAsync(item.CategoryId);
            Context.Add(item);
        }
        else
        {
            // Moved to another category in the editor: append it there
            var entry = Context.Entry(item);
            if (entry.State != EntityState.Detached && entry.Property(m => m.CategoryId).OriginalValue != item.CategoryId)
                item.SortOrder = await Context.NextMenuItemSortOrderAsync(item.CategoryId);
            Context.MenuItems.Update(item);
        }
        await Context.SaveChangesAsync();
        await LoadItems();
    }

    Task HandleCancel()
    {
        menuItemEditor.Input = new();
        return Task.CompletedTask;
    }

    async Task CreateNewMenuEntries()
    {
        if (!GeneratorEnabled) return;
        isWorking = true;
        try
        {
            var newEntries = (await MenuItemGenerator.CreateMockMenuEntriesAsync(Category, 10)).ToList();
            if (newEntries.Any())
            {
                await AppendInOrderAsync(newEntries);
                await Context.AddRangeAsync(newEntries);
                await Context.SaveChangesAsync();
                await LoadItems();
                Console.WriteLine($"Successfully generated {newEntries.Count} AI menu items!");
            }
            else
            {
                Console.WriteLine("Warning: AI service is not available. Generating fallback menu items...");
                await CreateFallbackMenuItems();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error generating AI menu entries: {ex.Message}");
            Console.WriteLine("AI service unavailable. Generating fallback menu items...");
            await CreateFallbackMenuItems();
        }
        finally
        {
            isWorking = false;
        }
    }

    /// <summary>Gives generated items consecutive SortOrder values after the existing items.</summary>
    async Task AppendInOrderAsync(IEnumerable<MenuItem> items)
    {
        var next = await Context.NextMenuItemSortOrderAsync(Category.Id);
        foreach (var item in items)
            item.SortOrder = next++;
    }

    async Task CreateFallbackMenuItems()
    {
        try
        {
            var fallbackItems = GenerateFallbackMenuItems(Category, 5);
            await AppendInOrderAsync(fallbackItems);
            await Context.AddRangeAsync(fallbackItems);
            await Context.SaveChangesAsync();
            await LoadItems();
            Console.WriteLine($"Generated {fallbackItems.Count} fallback menu items for category: {Category.Name}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating fallback menu items: {ex.Message}");
        }
    }

    List<MenuItem> GenerateFallbackMenuItems(Category category, int count)
    {
        var items = new List<MenuItem>();
        var random = new Random();
        var allergensByCode = availableAllergens.ToDictionary(a => a.Code, a => a);

        // Sample menu items based on category name
        var sampleItems = GetSampleItemsForCategory(category.Name.ToLower());

        for (int i = 0; i < count && i < sampleItems.Count; i++)
        {
            var sample = sampleItems[i];
            var allergens = sample.AllergenCodes
                .Where(c => allergensByCode.ContainsKey(c))
                .Select(c => allergensByCode[c])
                .ToList();
            items.Add(new MenuItem
            {
                Id = Guid.NewGuid(),
                Name = sample.Name,
                Description = sample.Description,
                Allergens = allergens,
                Price = (decimal)(random.NextDouble() * 15.0 + 5.0),
                CategoryId = category.Id
            });
        }

        return items;
    }

    List<(string Name, string Description, string[] AllergenCodes)> GetSampleItemsForCategory(string categoryName)
    {
        // Default items that work for most categories
        var defaultItems = new List<(string, string, string[])>
        {
            ("Klassisches Gericht", "Ein traditionelles und beliebtes Gericht", new[] { "A", "G" }),
            ("Hausgemachte Spezialität", "Nach unserem besonderen Rezept zubereitet", new[] { "A" }),
            ("Saisonale Auswahl", "Mit frischen, saisonalen Zutaten", Array.Empty<string>()),
            ("Chef's Empfehlung", "Vom Küchenchef persönlich empfohlen", new[] { "A", "G" }),
            ("Regionale Köstlichkeit", "Mit lokalen Zutaten zubereitet", new[] { "G" })
        };

        if (categoryName.Contains("vorspeise") || categoryName.Contains("starter"))
        {
            return new List<(string, string, string[])>
            {
                ("Bruschetta", "Geröstetes Brot mit Tomaten und Basilikum", new[] { "A" }),
                ("Carpaccio", "Hauchdünn geschnittenes Rindfleisch", new[] { "G" }),
                ("Suppe des Tages", "Täglich wechselnde hausgemachte Suppe", Array.Empty<string>()),
                ("Antipasti Teller", "Auswahl italienischer Vorspeisen", new[] { "A", "G" }),
                ("Caesar Salad", "Klassischer Salat mit Parmesan", new[] { "A", "G", "C" })
            };
        }
        else if (categoryName.Contains("hauptgang") || categoryName.Contains("main"))
        {
            return new List<(string, string, string[])>
            {
                ("Schnitzel Wiener Art", "Paniertes Kalbsschnitzel mit Zitrone", new[] { "A", "C" }),
                ("Pasta Carbonara", "Spaghetti mit Speck und Ei", new[] { "A", "G", "C" }),
                ("Gegrilltes Lachs", "Mit Kräuterbutter und Gemüse", new[] { "D", "G" }),
                ("Rinderfilet", "Medium gebraten mit Pfeffersauce", new[] { "G" }),
                ("Vegetarische Lasagne", "Mit Gemüse und Béchamelsauce", new[] { "A", "G" })
            };
        }
        else if (categoryName.Contains("dessert") || categoryName.Contains("nachspeise"))
        {
            return new List<(string, string, string[])>
            {
                ("Tiramisu", "Klassisches italienisches Dessert", new[] { "A", "G", "C" }),
                ("Schokoladenkuchen", "Warmer Kuchen mit Vanilleeis", new[] { "A", "G", "C" }),
                ("Panna Cotta", "Mit Beerensauce", new[] { "G" }),
                ("Apfelstrudel", "Mit Vanillesauce", new[] { "A", "G", "C" }),
                ("Eis-Variation", "Drei Kugeln nach Wahl", new[] { "G" })
            };
        }
        else if (categoryName.Contains("getränk") || categoryName.Contains("drink"))
        {
            return new List<(string, string, string[])>
            {
                ("Hauswein", "Rotwein oder Weißwein", new[] { "L" }),
                ("Craft Beer", "Lokales Bier vom Fass", new[] { "A" }),
                ("Espresso", "Italienischer Kaffee", Array.Empty<string>()),
                ("Frischer Orangensaft", "Täglich gepresst", Array.Empty<string>()),
                ("Mineralwasser", "Still oder sprudelnd", Array.Empty<string>())
            };
        }

        return defaultItems;
    }

    async Task DeleteAll()
    {
        if (!canDelete || !MenuItems.Any()) return;
        var count = MenuItems.Count;
        var confirm = await NotificationService.ShowConfirmation(("Delete all items",
            $"Delete all {count} item{(count == 1 ? "" : "s")} in \"{Category.Name}\"? This cannot be undone."));
        if (!confirm) return;

        isWorking = true;
        try
        {
            Context.RemoveRange(Context.MenuItems.Where(e => e.CategoryId == Category.Id));
            await Context.SaveChangesAsync();
        }
        catch (DbUpdateException ex)
        {
            Console.WriteLine($"Error deleting all menu items: {ex}");
            Context.ChangeTracker.Clear();
            errorMessage = $"The items of \"{Category.Name}\" could not be deleted. Some of them are probably still used by a combo or by the guest statistics.";
        }
        finally
        {
            isWorking = false;
        }
        await LoadItems();
    }
}
