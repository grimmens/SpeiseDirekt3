@using Microsoft.EntityFrameworkCore
@using SpeiseDirekt.Data
@using SpeiseDirekt.Infrastructure
@using SpeiseDirekt.Model
@using SpeiseDirekt.ServiceInterface
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JSRuntime
@inject IImageUploadService ImageUploadService

<!-- Modern Modal Overlay -->
<div class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4 @(isVisible ? "" : "hidden")" id="menuItemEditModal">
    @* Header and footer stay put, only the fields scroll: Save is always reachable on short screens *@
    <div class="bg-white rounded-xl shadow-2xl max-w-2xl w-full max-h-[90vh] flex flex-col overflow-hidden"
         role="dialog" aria-modal="true" aria-labelledby="menuItemEditModalTitle">
        <!-- Modal Header -->
        <div class="flex-shrink-0 bg-gradient-to-r from-blue-900 via-blue-800 to-blue-900 px-6 py-4">
            <div class="flex items-center justify-between">
                <h3 class="text-xl font-bold text-white mb-0" id="menuItemEditModalTitle">
                    @(Input.Id == Guid.Empty ? "Add New Menu Item" : "Edit Menu Item")
                </h3>
                <button type="button" class="text-white hover:text-gray-200 transition-colors" aria-label="Close" @onclick="Cancel">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
        </div>

        <EditForm @ref="editForm" EditContext="editContext" OnSubmit="OnSubmit" class="flex flex-col flex-1 min-h-0">
            <DataAnnotationsValidator />

            <!-- Modal Body -->
            <div class="flex-1 min-h-0 overflow-y-auto p-6 space-y-6">
                <!-- Image Upload Section -->
                <div class="space-y-4">
                    <label class="block text-sm font-medium text-gray-700">Menu Item Image</label>

                    <!-- Current Image Preview -->
                    <div class="flex items-center space-x-4">
                        <div class="flex-shrink-0">
                            <img src="@ImageUploadService.GetImageUrl(Input.ImagePath)"
                                 alt="Menu item preview"
                                 class="w-24 h-24 object-cover rounded-lg border border-gray-300" />
                        </div>
                        <div class="flex-1">
                            <InputFile OnChange="HandleImageUpload"
                                      accept="image/*"
                                      class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
                            <p class="mt-1 text-xs text-gray-500">PNG, JPG, GIF up to 5MB</p>
                            @if (imageUploadError != null)
                            {
                                <p class="mt-1 text-xs text-red-600">@imageUploadError</p>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(Input.ImagePath))
                        {
                            <button type="button" @onclick="RemoveImage"
                                    class="px-3 py-1 text-sm text-red-600 hover:text-red-800 border border-red-300 rounded-md hover:bg-red-50 transition-colors">
                                Remove
                            </button>
                        }
                    </div>
                </div>

                <!-- Name Field -->
                <div class="space-y-2">
                    <label for="MenuItem.Name" class="block text-sm font-medium text-gray-700">Name *</label>
                    <InputText @bind-Value="Input.Name" id="MenuItem.Name"
                              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
                    <ValidationMessage For="() => Input.Name" class="text-red-600 text-sm" />
                </div>

                <!-- Description Field -->
                <div class="space-y-2">
                    <label for="MenuItem.Description" class="block text-sm font-medium text-gray-700">Description <span class="font-normal text-gray-400">(optional)</span></label>
                    <InputTextArea @bind-Value="Input.Description" id="MenuItem.Description" rows="4"
                                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors resize-none" />
                    <ValidationMessage For="() => Input.Description" class="text-red-600 text-sm" />
                </div>

                <!-- Allergens Field -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700">Allergens</label>
                    <div class="grid grid-cols-2 gap-2 max-h-48 overflow-y-auto border border-gray-300 rounded-lg p-3">
                        @if (AvailableAllergens.Any())
                        {
                            @foreach (var allergen in AvailableAllergens)
                            {
                                var isChecked = Input.Allergens.Any(a => a.Id == allergen.Id);
                                <label class="flex items-center space-x-2 cursor-pointer hover:bg-gray-50 rounded px-1 py-0.5">
                                    <input type="checkbox" checked="@isChecked"
                                           @onchange="e => ToggleAllergen(allergen, (bool)e.Value!)"
                                           class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" />
                                    <span class="text-sm text-gray-700">@allergen.Code - @allergen.Name</span>
                                </label>
                            }
                        }
                        else
                        {
                            <p class="text-sm text-gray-500 col-span-2">
                                No allergens defined for this menu.
                                <a href="/allergens/@SelectedCategory?.MenuId" class="text-blue-600 hover:underline">Manage Allergens</a>
                            </p>
                        }
                    </div>
                </div>

                <!-- Labels (one list for back office and guests: ItemLabels) -->
                <fieldset class="space-y-2" data-testid="item-label-options">
                    <legend class="block float-none w-full text-sm font-medium text-gray-700 mb-2">Labels</legend>
                    <div class="border border-gray-300 rounded-lg p-3 space-y-3">
                        @foreach (var group in LabelGroups)
                        {
                            <div>
                                <p class="text-xs font-medium uppercase tracking-wide text-gray-500 mb-1.5">@group.Title</p>
                                <div class="flex flex-wrap gap-x-5 gap-y-2">
                                    @foreach (var label in group.Labels)
                                    {
                                        <label class="flex items-center gap-x-2 cursor-pointer">
                                            <input type="checkbox" id="@($"MenuItem.{label.PropertyName}")" checked="@label.Get(Input)"
                                                   @onchange="e => label.Set(Input, e.Value is true)"
                                                   class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" />
                                            <span class="text-sm text-gray-700">@label.BackOfficeText</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                        <p class="text-xs text-gray-500 mb-0">Shown as badges on the guest menu. Vegan items do not show “Vegetarian” as well.</p>
                    </div>
                </fieldset>

                <!-- Price Field -->
                <div class="space-y-2">
                    <label for="MenuItem.Price" class="block text-sm font-medium text-gray-700">Price (€) *</label>
                    <InputNumber @bind-Value="Input.Price" id="MenuItem.Price" readonly="@HasVariants" aria-describedby="@(HasVariants ? "MenuItem.PriceHint" : null)"
                                class="@($"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors {(HasVariants ? "bg-gray-100 text-gray-600 cursor-not-allowed" : "")}")" />
                    @if (HasVariants)
                    {
                        <p id="MenuItem.PriceHint" class="text-xs text-gray-500 mb-0" data-testid="price-follows-variants">
                            Set by the lowest variant price. Guests see “from <span class="whitespace-nowrap">@PriceFormat.Euro(Input.Price)</span>”.
                        </p>
                    }
                    <ValidationMessage For="() => Input.Price" class="text-red-600 text-sm" />
                </div>

                <!-- Price variants and extras -->
                @OptionSection(PriceOptionKind.Variant)
                @OptionSection(PriceOptionKind.Extra)

                <!-- Category Field -->
                <div class="space-y-2">
                    <label for="MenuItem.CategoryId" class="block text-sm font-medium text-gray-700">Category *</label>
                    <InputSelect @bind-Value="Input.CategoryId"
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
                        <option value="">-- Select Category --</option>
                        @foreach (var cat in Categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Input.CategoryId" class="text-red-600 text-sm" />
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="flex-shrink-0 flex justify-between items-center px-6 py-[1rem] border-t border-gray-200 bg-gray-50">
                    <button type="button" @onclick="Cancel"
                            class="px-4 py-2 text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors">
                        Cancel
                    </button>
                    <button type="submit" disabled="@isUploading"
                            class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center">
                        @if (isUploading)
                        {
                            <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <span>Saving</span>
                        }
                        else
                        {
                            <span>Save Menu Item</span>
                        }
                    </button>
            </div>
        </EditForm>
    </div>
</div>


@code {
    [Parameter] public MenuItem Input { get; set; } = new();
    [Parameter] public EventCallback<MenuItem> OnOk { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public List<Category> Categories { get; set; } = new();
    [Parameter] public Category SelectedCategory { get; set; }
    [Parameter] public List<Allergen> AvailableAllergens { get; set; } = new();
    [Inject] private ApplicationDbContext Context { get; set; }

    private EditContext editContext = new(new MenuItem());
    private EditForm editForm;
    private bool isVisible = false;
    private bool isUploading = false;
    private string? imageUploadError = null;
    private string? oldImagePath = null;

    protected override async Task OnInitializedAsync()
    {
        if (SelectedCategory != null)
        {
            Input.CategoryId = SelectedCategory.Id;
        }
    }

    private sealed record LabelGroup(string Title, IReadOnlyList<ItemLabel> Labels);

    private static readonly IReadOnlyList<LabelGroup> LabelGroups = new[]
    {
        new LabelGroup("Dietary", ItemLabels.OfKind(ItemLabelKind.Dietary)),
        new LabelGroup("Highlights", ItemLabels.OfKind(ItemLabelKind.Highlight))
    };

    private bool HasVariants => Input.HasVariants();

    /// <summary>Name inputs of the option rows, to focus a freshly added row.</summary>
    private readonly Dictionary<MenuItemPriceOption, InputText> optionNameInputs = new();
    private MenuItemPriceOption? focusOption;

    private static string KindText(PriceOptionKind kind) => kind == PriceOptionKind.Variant ? "variant" : "extra";

    /// <summary>"Price variants" or "Extras": rows with name, price, reorder arrows and remove; an add button below.</summary>
    private RenderFragment OptionSection(PriceOptionKind kind) => __builder =>
    {
        var options = Input.OfKind(kind);
        var isVariant = kind == PriceOptionKind.Variant;
        var noun = KindText(kind);
        <section class="space-y-2" data-testid="@(isVariant ? "price-variants" : "price-extras")" aria-labelledby="@($"options-{noun}-heading")">
            <div>
                <h4 id="@($"options-{noun}-heading")" class="text-sm font-medium text-gray-700 mb-0">
                    @(isVariant ? "Price variants" : "Extras") <span class="font-normal text-gray-400">(optional)</span>
                </h4>
                <p class="mt-0.5 mb-0 text-xs text-gray-500">
                    @if (isVariant)
                    {
                        <text>Sizes or versions with their own price, e.g. “0,25 l” and “0,5 l” or “Standard” and “Vegan”. The price above then follows the lowest variant.</text>
                    }
                    else
                    {
                        <text>Add-ons guests can order with this item, e.g. “+ Halloumi”.</text>
                    }
                </p>
            </div>
            @if (options.Count > 0)
            {
                <ul class="list-none m-0 p-0 space-y-2">
                    @for (var i = 0; i < options.Count; i++)
                    {
                        var index = i;
                        var option = options[index];
                        var position = index + 1;
                        var title = string.IsNullOrWhiteSpace(option.Name) ? $"{noun} {position}" : $"{noun} {option.Name.Trim()}";
                        <li @key="option" class="flex flex-wrap items-start gap-x-2 gap-y-1.5 rounded-lg border border-gray-200 bg-gray-50 px-2.5 py-2"
                            data-testid="@(isVariant ? "variant-row" : "extra-row")">
                            <div class="min-w-0 basis-full sm:basis-0 sm:flex-1">
                                <InputText @ref="optionNameInputs[option]" @bind-Value="option.Name" maxlength="@MenuItemPriceOption.NameMaxLength"
                                           placeholder="@(isVariant ? "e.g. 0,5 l" : "e.g. + Halloumi")" aria-label="@($"Name of {noun} {position}")"
                                           class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                                <ValidationMessage For="() => option.Name" class="text-red-600 text-xs mt-1" />
                            </div>
                            <div class="w-32 flex-shrink-0">
                                <div class="relative">
                                    <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-sm text-gray-500" aria-hidden="true">€</span>
                                    <InputNumber @bind-Value="option.Price" @bind-Value:after="OptionsChanged" step="0.01" min="0"
                                                 aria-label="@($"Price of {noun} {position}")"
                                                 class="w-full pl-7 pr-2 py-2 text-sm text-right tabular-nums border border-gray-300 rounded-lg bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                                </div>
                                <ValidationMessage For="() => option.Price" class="text-red-600 text-xs mt-1" />
                            </div>
                            <div class="ml-auto flex flex-shrink-0 items-center gap-0.5">
                                <button type="button" title="Move up" aria-label="@($"Move {title} up")" disabled="@(index == 0)"
                                        class="p-2 rounded-md text-gray-500 hover:bg-gray-200 hover:text-gray-900 disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent transition-colors"
                                        @onclick="() => MoveOption(option, -1)">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                                    </svg>
                                </button>
                                <button type="button" title="Move down" aria-label="@($"Move {title} down")" disabled="@(index == options.Count - 1)"
                                        class="p-2 rounded-md text-gray-500 hover:bg-gray-200 hover:text-gray-900 disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent transition-colors"
                                        @onclick="() => MoveOption(option, 1)">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                </button>
                                <button type="button" title="Remove" aria-label="@($"Remove {title}")"
                                        class="p-2 rounded-md text-gray-500 hover:text-red-700 hover:bg-red-50 transition-colors"
                                        @onclick="() => RemoveOption(option)">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </button>
                            </div>
                        </li>
                    }
                </ul>
            }
            <button type="button" @onclick="() => AddOption(kind)"
                    class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 rounded-md py-1">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                @(isVariant ? "Add variant" : "Add extra")
            </button>
        </section>
    };

    private void AddOption(PriceOptionKind kind)
    {
        var existing = Input.OfKind(kind);
        var option = new MenuItemPriceOption
        {
            // Id stays empty: EF generates it and tracks the option as new
            MenuItemId = Input.Id,
            Kind = kind,
            SortOrder = existing.Count == 0 ? 0 : existing.Max(o => o.SortOrder) + 1,
            // A first variant starts at the current price, the next ones at the last variant's price
            Price = kind == PriceOptionKind.Variant ? (existing.Count == 0 ? Input.Price : existing[^1].Price) : 0m
        };
        Input.PriceOptions.Add(option);
        focusOption = option;
        OptionsChanged();
    }

    private void RemoveOption(MenuItemPriceOption option)
    {
        Input.PriceOptions.Remove(option);
        optionNameInputs.Remove(option);
        Input.Renumber(option.Kind);
        OptionsChanged();
    }

    private void MoveOption(MenuItemPriceOption option, int offset)
    {
        var siblings = Input.OfKind(option.Kind).ToList();
        DisplayOrder.Move(siblings, siblings.IndexOf(option), offset, (o, i) => o.SortOrder = i);
    }

    /// <summary>Keeps the (read-only) base price equal to the lowest variant while the variants are edited.</summary>
    private void OptionsChanged() => Input.ApplyLowestVariantPrice();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusOption is { } option && optionNameInputs.TryGetValue(option, out var input) && input.Element is { } element)
        {
            focusOption = null;
            await element.FocusAsync();
        }
    }

    /// <summary>
    /// The price options are not validated by the DataAnnotationsValidator (it only looks at the item itself):
    /// check each one with its own attributes and show the messages next to the row.
    /// </summary>
    private bool ValidatePriceOptions()
    {
        optionMessages ??= new ValidationMessageStore(editContext);
        optionMessages.Clear();
        var valid = true;
        foreach (var option in Input.PriceOptions)
        {
            option.Name = option.Name?.Trim() ?? string.Empty;
            var results = new List<System.ComponentModel.DataAnnotations.ValidationResult>();
            if (System.ComponentModel.DataAnnotations.Validator.TryValidateObject(
                    option, new System.ComponentModel.DataAnnotations.ValidationContext(option), results, validateAllProperties: true))
                continue;
            valid = false;
            foreach (var result in results)
                foreach (var member in result.MemberNames)
                    optionMessages.Add(new FieldIdentifier(option, member), result.ErrorMessage ?? "Invalid value.");
        }
        editContext.NotifyValidationStateChanged();
        return valid;
    }

    private ValidationMessageStore? optionMessages;

    private async Task OnSubmit()
    {
        if (isUploading) return;

        editContext = new EditContext(Input);
        editForm.EditContext = editContext;
        optionMessages = null;

        var itemValid = editContext.Validate();
        if (!ValidatePriceOptions() || !itemValid)
            return;

        Input.Renumber(PriceOptionKind.Variant);
        Input.Renumber(PriceOptionKind.Extra);
        Input.ApplyLowestVariantPrice();

        isUploading = true;
        StateHasChanged();

        try
        {
            await OnOk.InvokeAsync(Input);
            await CloseModal();
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    public async Task ShowModal()
    {
        editContext = new EditContext(Input);
        optionMessages = null;
        optionNameInputs.Clear();
        focusOption = null;
        oldImagePath = Input.ImagePath; // Store original image path
        imageUploadError = null;
        isVisible = true;
        StateHasChanged();
    }

    private async Task CloseModal()
    {
        isVisible = false;
        StateHasChanged();
    }

    private async Task Cancel()
    {
        // Restore original image path if it was changed
        if (oldImagePath != Input.ImagePath && !string.IsNullOrEmpty(Input.ImagePath))
        {
            await ImageUploadService.DeleteImageAsync(Input.ImagePath);
            Input.ImagePath = oldImagePath;
        }

        await OnCancel.InvokeAsync();
        await CloseModal();
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        imageUploadError = null;
        var file = e.File;

        if (file == null) return;

        if (!ImageUploadService.IsValidImageFile(file))
        {
            imageUploadError = "Please select a valid image file (JPG, PNG, GIF, WEBP) under 5MB.";
            StateHasChanged();
            return;
        }

        isUploading = true;
        StateHasChanged();

        try
        {
            // Delete old image if exists and it's different from the original
            if (!string.IsNullOrEmpty(Input.ImagePath) && Input.ImagePath != oldImagePath)
            {
                await ImageUploadService.DeleteImageAsync(Input.ImagePath);
            }

            var imagePath = await ImageUploadService.UploadImageAsync(file);
            if (imagePath != null)
            {
                Input.ImagePath = imagePath;
            }
            else
            {
                imageUploadError = "Failed to upload image. Please try again.";
            }
        }
        catch (Exception ex)
        {
            imageUploadError = $"Upload failed: {ex.Message}";
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private async Task RemoveImage()
    {
        if (!string.IsNullOrEmpty(Input.ImagePath) && Input.ImagePath != oldImagePath)
        {
            await ImageUploadService.DeleteImageAsync(Input.ImagePath);
        }
        Input.ImagePath = null;
        StateHasChanged();
    }

    private void ToggleAllergen(Allergen allergen, bool isChecked)
    {
        if (isChecked)
        {
            if (!Input.Allergens.Any(a => a.Id == allergen.Id))
                Input.Allergens.Add(allergen);
        }
        else
        {
            var existing = Input.Allergens.FirstOrDefault(a => a.Id == allergen.Id);
            if (existing != null)
                Input.Allergens.Remove(existing);
        }
    }
}
