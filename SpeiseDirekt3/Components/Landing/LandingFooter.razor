@inject IConfiguration Configuration
@inject TimeProvider Clock
@inject IStringLocalizer<LandingText> T
@* The footer: brand, the section links (also the target of the header's menu link without JS), the account links,
   and — only when the operator configured them (LandingSettings) — imprint, privacy and a contact e-mail. *@
@{
    var settings = LandingSettings.From(Configuration);
}
<footer class="lp-footer" data-testid="landing-footer">
    <div class="lp-container lp-footer-grid">
        <div class="lp-footer-brand">
            <BrandLogo Inverse="true" Height="32" Alt="Speise-Direkt" TestId="landing-footer-logo" />
            <p>@T["Footer_Text"]</p>
            @if (settings.ContactEmail is { } email)
            {
                <a class="lp-footer-mail" href="mailto:@email" data-testid="footer-contact">
                    <LandingIcon Name="mail" />
                    <span>@email</span>
                </a>
            }
        </div>
        <nav id="lp-footer-nav" class="lp-footer-col" aria-labelledby="lp-footer-site" tabindex="-1" data-testid="footer-nav">
            <h2 id="lp-footer-site" class="lp-footer-title">Speise-Direkt</h2>
            <ul role="list">
                @foreach (var (id, labelKey) in LandingPage.Sections)
                {
                    <li><a href="#@id">@T[labelKey]</a></li>
                }
            </ul>
        </nav>
        <nav class="lp-footer-col" aria-labelledby="lp-footer-account">
            <h2 id="lp-footer-account" class="lp-footer-title">@T["Footer_Account"]</h2>
            <ul role="list">
                <li><a href="/Account/Login" data-testid="footer-login">@T["LogIn"]</a></li>
                <li><a href="/Account/Register" data-testid="footer-register">@T["RegisterFree"]</a></li>
            </ul>
        </nav>
        @if (settings.HasLegalLinks)
        {
            <nav class="lp-footer-col" aria-labelledby="lp-footer-legal" data-testid="footer-legal">
                <h2 id="lp-footer-legal" class="lp-footer-title">@T["Footer_Legal"]</h2>
                <ul role="list">
                    @if (settings.ImprintUrl is { } imprint)
                    {
                        <li><a href="@imprint" data-testid="footer-imprint">@T["Footer_Imprint"]</a></li>
                    }
                    @if (settings.PrivacyUrl is { } privacy)
                    {
                        <li><a href="@privacy" data-testid="footer-privacy">@T["Footer_Privacy"]</a></li>
                    }
                </ul>
            </nav>
        }
    </div>
    <div class="lp-container lp-footer-bottom-wrap">
        <div class="lp-footer-bottom">
            <p>© @Clock.GetLocalNow().Year Speise-Direkt</p>
            <p data-testid="footer-demo-note">@T["Footer_DemoNote"]</p>
        </div>
    </div>
</footer>
