@* A phone mockup (CSS only: bezel, screen, camera island) around a screenshot of the guest menu, or around
   ChildContent (the theme switcher's stack of screenshots). *@
<div class="lp-phone @Class" data-testid="@TestId">
    <div class="lp-phone-screen">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else if (Image is not null)
        {
            <LandingShot Image="Image" Alt="@Alt" Eager="Eager" />
        }
    </div>
    <span class="lp-phone-island" aria-hidden="true"></span>
</div>

@code {
    [Parameter] public LandingImage? Image { get; set; }
    [Parameter] public string? Alt { get; set; }
    [Parameter] public bool Eager { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? TestId { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
