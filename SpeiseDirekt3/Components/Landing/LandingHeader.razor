@* The landing page's header: sticky, condensed once the page is scrolled (data-scrolled, js/landing.js). From 1024 px
   logo, the section anchors, "Anmelden" and the CTA; narrower the CTA and a menu button. Without JS the menu button
   is a link to the footer's navigation (#lp-footer-nav); with JS it opens the menu sheet (LandingMenu, <dialog>). *@
<header class="lp-header" data-lp-header data-testid="landing-header">
    <div class="lp-container lp-header-inner">
        <a class="lp-brand" href="/" aria-label="Speise-Direkt, Startseite" data-testid="landing-brand">
            <BrandLogo Height="32" Alt="" Class="lp-brand-logo" TestId="landing-logo" />
        </a>
        <nav class="lp-nav" aria-label="Hauptnavigation" data-testid="landing-nav">
            <ul role="list">
                @foreach (var (id, label) in LandingPage.Sections)
                {
                    <li><a class="lp-nav-link" href="#@id">@label</a></li>
                }
            </ul>
        </nav>
        <div class="lp-header-actions">
            <a class="lp-text-link lp-header-login" href="/Account/Login" data-testid="landing-login">Anmelden</a>
            <a class="lp-button lp-button--primary lp-header-cta" href="/Account/Register" data-testid="landing-register">
                <span class="lp-cta-long">Kostenlos registrieren</span><span class="lp-cta-short" aria-hidden="true">Registrieren</span>
            </a>
            <a class="lp-icon-button lp-menu-button" href="#lp-footer-nav" aria-label="Menü" data-lp-menu-open
               data-testid="landing-menu-button">
                <LandingIcon Name="menu" StrokeWidth="2" />
            </a>
        </div>
    </div>
</header>

@* The menu sheet below 1024 px: a native modal <dialog>, opened by the menu button (js/landing.js). Escape, the
   backdrop, the close button and a followed link close it; it closes as well when the window widens to 1024 px. *@
<dialog class="lp-menu" id="lp-menu" aria-label="Menü" data-lp-menu data-testid="landing-menu">
    <div class="lp-menu-panel">
        <div class="lp-menu-head">
            <a class="lp-brand" href="/" aria-label="Speise-Direkt, Startseite">
                <BrandLogo Height="30" Alt="" TestId="landing-menu-logo" />
            </a>
            <button type="button" class="lp-icon-button" aria-label="Menü schließen" data-lp-menu-close data-testid="landing-menu-close">
                <LandingIcon Name="close" StrokeWidth="2" />
            </button>
        </div>
        <nav aria-label="Abschnitte">
            <ul role="list" class="lp-menu-links">
                @foreach (var (id, label) in LandingPage.Sections)
                {
                    <li>
                        <a class="lp-menu-link" href="#@id" data-lp-menu-link>
                            <span>@label</span>
                            <LandingIcon Name="arrow-right" />
                        </a>
                    </li>
                }
            </ul>
        </nav>
        <div class="lp-menu-actions">
            <a class="lp-button lp-button--secondary lp-button--lg" href="/Account/Login" data-lp-menu-link>Anmelden</a>
            <a class="lp-button lp-button--primary lp-button--lg" href="/Account/Register" data-lp-menu-link>Kostenlos registrieren</a>
        </div>
    </div>
</dialog>
