@inject IStringLocalizer<LandingText> T
@* The landing page's header: sticky, condensed once the page is scrolled (data-scrolled, js/landing.js). From 1024 px
   logo, the section anchors, "Anmelden" and the CTA; narrower the CTA and a menu button. Without JS the menu button
   is a link to the footer's navigation (#lp-footer-nav); with JS it opens the menu sheet (LandingMenu, <dialog>). *@
<header class="lp-header" data-lp-header data-testid="landing-header">
    <div class="lp-container lp-header-inner">
        <a class="lp-brand" href="/" aria-label="@T["BrandHome"]" data-testid="landing-brand">
            <BrandLogo Height="32" Alt="" Class="lp-brand-logo" TestId="landing-logo" />
        </a>
        <nav class="lp-nav" aria-label="@T["NavLabel"]" data-testid="landing-nav">
            <ul role="list">
                @foreach (var (id, labelKey) in LandingPage.Sections)
                {
                    <li><a class="lp-nav-link" href="@(SectionBase)#@id">@T[labelKey]</a></li>
                }
            </ul>
        </nav>
        <div class="lp-header-actions">
            <a class="lp-text-link lp-header-login" href="/Account/Login" data-testid="landing-login">@T["LogIn"]</a>
            <a class="lp-button lp-button--primary lp-header-cta" href="/Account/Register" data-lp-cta="header" data-testid="landing-register">
                <span class="lp-cta-long">@T["RegisterFree"]</span><span class="lp-cta-short" aria-hidden="true">@T["RegisterShort"]</span>
            </a>
            <a class="lp-icon-button lp-menu-button" href="#lp-footer-nav" aria-label="@T["MenuButton"]" data-lp-menu-open
               data-testid="landing-menu-button">
                <LandingIcon Name="menu" StrokeWidth="2" />
            </a>
        </div>
    </div>
</header>

@* The menu sheet below 1024 px: a native modal <dialog>, opened by the menu button (js/landing.js). Escape, the
   backdrop, the close button and a followed link close it; it closes as well when the window widens to 1024 px. *@
<dialog class="lp-menu" id="lp-menu" aria-label="@T["MenuButton"]" data-lp-menu data-testid="landing-menu">
    <div class="lp-menu-panel">
        <div class="lp-menu-head">
            <a class="lp-brand" href="/" aria-label="@T["BrandHome"]">
                <BrandLogo Height="30" Alt="" TestId="landing-menu-logo" />
            </a>
            <button type="button" class="lp-icon-button" aria-label="@T["MenuClose"]" data-lp-menu-close data-testid="landing-menu-close">
                <LandingIcon Name="close" StrokeWidth="2" />
            </button>
        </div>
        <nav aria-label="@T["SectionsLabel"]">
            <ul role="list" class="lp-menu-links">
                @foreach (var (id, labelKey) in LandingPage.Sections)
                {
                    <li>
                        <a class="lp-menu-link" href="@(SectionBase)#@id" data-lp-menu-link>
                            <span>@T[labelKey]</span>
                            <LandingIcon Name="arrow-right" />
                        </a>
                    </li>
                }
            </ul>
        </nav>
        <div class="lp-menu-actions">
            <a class="lp-button lp-button--secondary lp-button--lg" href="/Account/Login" data-lp-menu-link>@T["LogIn"]</a>
            <a class="lp-button lp-button--primary lp-button--lg" href="/Account/Register" data-lp-menu-link data-lp-cta="menu" data-testid="menu-register">@T["RegisterFree"]</a>
        </div>
    </div>
</dialog>

@code {
    /// <summary>
    /// Prefix of the section links (<c>#funktionen</c>, …): empty on the landing page itself, <c>/</c> on the other
    /// pages of the landing document (the imprint), so the links lead back to the landing page's sections.
    /// </summary>
    [Parameter] public string SectionBase { get; set; } = "";
}
