@using SpeiseDirekt.ServiceInterface
@implements IAsyncDisposable
@inject INotificationService NotificationService
@inject IJSRuntime JS

@* The one confirmation of the back office (INotificationService.ShowConfirmation((title, message))), rendered once by
   MainLayout. A quiet native <dialog> (js/modal-dialog.js): white, neutral title, the message, "Cancel" (focused first)
   and a button named after the action — red for destructive actions (Delete…, Deactivate, Discard…, Remove…, Unlink…).
   Escape, a backdrop click and "Cancel" answer false. Test ids/ids: #confirmationModal, #confirmBtn, #cancelBtn,
   confirmation-message. *@
<dialog @ref="dialog" id="confirmationModal" class="sd-dialog" aria-labelledby="confirmation-title" aria-describedby="confirmation-message" data-testid="confirmation">
    <div class="sd-dialog-head">
        <h2 id="confirmation-title" class="sd-dialog-title">@title</h2>
    </div>
    <div class="sd-dialog-body" id="confirmation-message" data-testid="confirmation-message">@message</div>
    <div class="sd-dialog-actions">
        <button id="cancelBtn" type="button" class="sd-btn sd-btn--secondary" autofocus @onclick="() => CloseAsync(false)">Cancel</button>
        <button id="confirmBtn" type="button" class="@(IsDestructive ? "sd-btn sd-btn--danger" : "sd-btn sd-btn--primary")" @onclick="() => CloseAsync(true)">@ConfirmText</button>
    </div>
</dialog>

@code {
    private string title = "";
    private string message = "";
    private bool isModalVisible;
    private bool openPending;
    private TaskCompletionSource<bool> tcs = new();
    private ElementReference dialog;
    private IJSObjectReference? module;
    private IJSObjectReference? handle;
    private DotNetObjectReference<ConfirmationModal>? selfRef;

    private static readonly string[] DestructiveVerbs = ["Delete", "Deactivate", "Discard", "Remove", "Unlink"];

    private bool IsDestructive => DestructiveVerbs.Any(v => title.StartsWith(v, StringComparison.OrdinalIgnoreCase));

    /// <summary>The confirm button names the action ("Delete menu", "Discard changes"); "OK" for a plain question.</summary>
    private string ConfirmText =>
        IsDestructive || title.StartsWith("Activate", StringComparison.OrdinalIgnoreCase) ? title : "OK";

    protected override void OnInitialized()
    {
        NotificationService.OnConfirmationRequested += ShowModal;
    }

    private Task<bool> ShowModal((string title, string message) tuple)
    {
        title = tuple.title;
        message = tuple.message;
        if (isModalVisible)
        {
            _ = InvokeAsync(StateHasChanged);
            return tcs.Task;
        }
        isModalVisible = true;
        openPending = true;
        tcs = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        _ = InvokeAsync(StateHasChanged);
        return tcs.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!openPending)
            return;
        openPending = false;
        try
        {
            if (handle is null)
            {
                selfRef ??= DotNetObjectReference.Create(this);
                module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/modal-dialog.js");
                handle = await module.InvokeAsync<IJSObjectReference>("attach", dialog, selfRef, null);
            }
            await handle.InvokeVoidAsync("open");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            // No dialog: answer "no" rather than leaving the caller waiting
            isModalVisible = false;
            tcs.TrySetResult(false);
        }
    }

    private async Task CloseAsync(bool result)
    {
        if (!isModalVisible)
            return;
        isModalVisible = false;
        tcs.TrySetResult(result);
        try
        {
            if (handle is not null)
                await handle.InvokeVoidAsync("close");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
        }
    }

    /// <summary>Escape, a backdrop click or close(): the browser closed the dialog.</summary>
    [JSInvokable]
    public void OnDialogClosedJs()
    {
        if (!isModalVisible)
            return;
        isModalVisible = false;
        tcs.TrySetResult(false);
    }

    public async ValueTask DisposeAsync()
    {
        NotificationService.OnConfirmationRequested -= ShowModal;
        isModalVisible = false;
        tcs.TrySetResult(false);
        try
        {
            if (handle is not null)
            {
                await handle.InvokeVoidAsync("dispose");
                await handle.DisposeAsync();
            }
            if (module is not null)
                await module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
        }
        selfRef?.Dispose();
    }
}
