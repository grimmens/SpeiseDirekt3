@* Notice for the public (guest) pages: loading, "no menu right now", not found. Same look as the menu display. *@
<div class="min-h-[60vh] flex items-center justify-center px-6 py-16" data-testid="guest-notice" data-kind="@Kind.ToString().ToLowerInvariant()">
    <div class="max-w-md w-full bg-white rounded-xl shadow-sm p-8 text-center">
        @if (Kind == GuestNoticeKind.Loading)
        {
            <div class="mx-auto mb-4 h-10 w-10 rounded-full border-4 border-teal-100 border-t-teal-600 animate-spin"></div>
        }
        else
        {
            <div class="mx-auto mb-4 w-16 h-16 rounded-full flex items-center justify-center text-3xl @IconBackground">@Icon</div>
        }
        <h1 class="text-xl font-bold text-gray-900 mb-2">@Title</h1>
        @if (!string.IsNullOrEmpty(Message))
        {
            <p class="text-gray-600 leading-relaxed">@Message</p>
        }
        @if (ShowHomeLink)
        {
            <a href="/" class="inline-block mt-6 px-5 py-2 rounded-full bg-teal-600 hover:bg-teal-700 text-white text-sm font-medium transition-colors">
                Zur Startseite
            </a>
        }
    </div>
</div>

@code {
    public enum GuestNoticeKind { Loading, Info, NotFound }

    [Parameter] public GuestNoticeKind Kind { get; set; } = GuestNoticeKind.Info;
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool ShowHomeLink { get; set; }

    private string Icon => Kind == GuestNoticeKind.NotFound ? "🔍" : "🕒";
    private string IconBackground => Kind == GuestNoticeKind.NotFound ? "bg-orange-100" : "bg-teal-100";
}
