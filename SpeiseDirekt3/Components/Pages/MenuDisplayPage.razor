@page "/menu/{MenuId:guid}"


@using Microsoft.EntityFrameworkCore
@using SpeiseDirekt.Model
@rendermode @(InteractiveServer)
@layout MenuLayout

@if (MenuLoading)
{
    <GuestNotice Kind="GuestNotice.GuestNoticeKind.Loading" Title="Menü wird geladen…" />
}
else if (Menu == null)
{
    <GuestNotice Kind="GuestNotice.GuestNoticeKind.NotFound" Title="Menü nicht gefunden"
                 Message="Dieses Menü existiert nicht oder wurde gelöscht." ShowHomeLink="true" />
}
else
{
   <SpeiseDirekt3.Components.Menu.MenuDisplayComponent Menu="Menu" />
}

@code {
    [Parameter] public Guid MenuId { get; set; }
    [Inject] private ApplicationDbContext Context { get; set; }

    private Menu? Menu { get; set; }
    private bool MenuLoading { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        Menu = await Context.Menus
        .IgnoreQueryFilters()
            .Include(m => m.Categories)!
                .ThenInclude(c => c.MenuItems)
                .ThenInclude(i => i.Allergens)
            .FirstOrDefaultAsync(m => m.Id == MenuId);

        MenuLoading = false;
    }
}
