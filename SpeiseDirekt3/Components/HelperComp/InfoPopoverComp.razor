@inject IJSRuntime JS

<span @ref="_iconRef"
      class="text-muted ms-1 d-inline-flex align-middle"
      role="button"
      tabindex="0"
      @onclick="ShowPopover"
      @onclick:preventDefault
      data-bs-toggle="popover"
      data-bs-trigger="focus"
      data-bs-html="true"
      data-bs-placement="right"
      title=""
      data-bs-content="">
    @* Bootstrap Icons "info-circle" (MIT), inline: no icon font from a CDN needed *@
    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
        <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 .943-.252 1.12-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0" />
    </svg>
</span>

<div style="display:none;" @ref="_contentRef">
    @Content
</div>

@code {
    private ElementReference _iconRef;
    private ElementReference _contentRef;
    private IJSObjectReference? _module;

    [Parameter]
    public RenderFragment? Content { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            
                await JS.InvokeVoidAsync("initPopover", _iconRef, _contentRef);
            
        }
    }

    private async Task ShowPopover()
    {
        
            await JS.InvokeVoidAsync("showPopover", _iconRef);
        
    }
}
