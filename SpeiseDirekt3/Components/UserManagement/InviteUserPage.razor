@page "/users/invite"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using SpeiseDirekt.Model
@using SpeiseDirekt.ServiceInterface
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject IUserIdProvider UserIdProvider
@inject IPermissionService PermissionService
@inject NavigationManager NavManager
@attribute [Authorize]
@inject IStringLocalizer<TeamText> T
@inject IStringLocalizer<CommonText> C
@inject IStringLocalizer<ShellText> S

@* Invites a team member: always a manager (AP14, no role picker). Only the owner (UsersCreate); the free tier's member
   limit (TenantSubscription.MaxUsers, active members) still applies. *@
<PageTitle>@C["PageTitle", T["Invite"]]</PageTitle>

<div class="max-w-2xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-600 mb-6" aria-label="@S["Context_BreadcrumbLabel"]">
        <ol class="flex space-x-2">
            <li>
                <a href="/users" class="text-brand-600 hover:underline">@S["Nav_Team"]</a>
                <span class="mx-2" aria-hidden="true">/</span>
            </li>
            <li class="text-gray-800" aria-current="page">@T["Invite"]</li>
        </ol>
    </nav>

    <PageHeader Title="@T["Invite_Title"]" Icon="PageIcons.Team" Tone="TileTone.Accent" Class="mb-6" />

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-[1rem] sm:p-6">

        @if (errorMessage != null)
        {
            <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
                @errorMessage
            </div>
        }

        <EditForm Model="model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="space-y-4">
                <div>
                    <label for="Invite.Email" class="block text-sm font-medium text-gray-700 mb-1">@T["Invite_Email"]</label>
                    <InputText @bind-Value="model.Email" id="Invite.Email" inputmode="email" autocomplete="off" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500" placeholder="@T["Invite_EmailPlaceholder"]" />
                    <ValidationMessage For="@(() => model.Email)" class="text-red-500 text-sm mt-1" />
                </div>

                <div>
                    <label for="Invite.DisplayName" class="block text-sm font-medium text-gray-700 mb-1">@T["Invite_DisplayName"]</label>
                    <InputText @bind-Value="model.DisplayName" id="Invite.DisplayName" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500" placeholder="@T["Invite_DisplayNamePlaceholder"]" />
                    <ValidationMessage For="@(() => model.DisplayName)" class="text-red-500 text-sm mt-1" />
                </div>

                <div>
                    <label for="Invite.Password" class="block text-sm font-medium text-gray-700 mb-1">@T["Invite_Password"]</label>
                    <InputText @bind-Value="model.Password" id="Invite.Password" type="password" autocomplete="new-password" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500" placeholder="@T["Invite_PasswordPlaceholder"]" />
                    <ValidationMessage For="@(() => model.Password)" class="text-red-500 text-sm mt-1" />
                </div>

                <div class="sd-notice sd-notice--info" data-testid="invite-role">
                    <p><strong>@T["Invite_RoleIs", C["Role_Manager"]]</strong></p>
                    <p>@T["RolesNote"]</p>
                </div>

                <div class="flex justify-end gap-3 pt-4">
                    <button type="button" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg transition-colors"
                            @onclick="Cancel">@C["Cancel"]</button>
                    <button type="submit" class="px-6 py-2 bg-brand-600 hover:bg-brand-700 text-white font-medium rounded-lg transition-colors"
                            disabled="@isSubmitting">
                        @(isSubmitting ? T["Invite_Creating"] : T["Invite_Create"])
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private InviteModel model = new();
    private string? errorMessage;
    private bool isSubmitting;

    private class InviteModel
    {
        [Required(ErrorMessageResourceType = typeof(TeamText), ErrorMessageResourceName = nameof(TeamText.Valid_EmailRequired))]
        [EmailAddress(ErrorMessageResourceType = typeof(TeamText), ErrorMessageResourceName = nameof(TeamText.Valid_EmailInvalid))]
        public string Email { get; set; } = "";

        [Required(ErrorMessageResourceType = typeof(TeamText), ErrorMessageResourceName = nameof(TeamText.Valid_DisplayNameRequired))]
        [StringLength(100, ErrorMessageResourceType = typeof(TeamText), ErrorMessageResourceName = nameof(TeamText.Valid_DisplayNameTooLong))]
        public string DisplayName { get; set; } = "";

        [Required(ErrorMessageResourceType = typeof(TeamText), ErrorMessageResourceName = nameof(TeamText.Valid_PasswordRequired))]
        [MinLength(8, ErrorMessageResourceType = typeof(TeamText), ErrorMessageResourceName = nameof(TeamText.Valid_PasswordTooShort))]
        public string Password { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        // Only the owner invites: a manager gets the access-denied page
        await PermissionService.RequireAsync(Permission.UsersCreate, NavManager);
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var tenantOwnerId = UserIdProvider.GetUserId();

            // Check user limit
            var sub = await DbContext.TenantSubscriptions
                .AsNoTracking()
                .FirstOrDefaultAsync(s => s.TenantId == tenantOwnerId);

            var currentCount = await DbContext.TenantUsers.CountAsync(tu => tu.TenantOwnerId == tenantOwnerId && tu.IsActive);

            if (sub != null && currentCount >= sub.MaxUsers)
            {
                errorMessage = T["Invite_LimitReached", sub.MaxUsers];
                return;
            }

            // Create Identity user
            var appUser = new ApplicationUser
            {
                UserName = model.Email,
                Email = model.Email,
                TenantOwnerId = tenantOwnerId
            };

            var result = await UserManager.CreateAsync(appUser, model.Password);
            if (!result.Succeeded)
            {
                errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
                return;
            }

            // Create TenantUser record: every member is a manager
            var tenantUser = new TenantUser
            {
                Id = Guid.NewGuid(),
                ApplicationUserId = appUser.Id,
                TenantOwnerId = tenantOwnerId,
                Role = TenantRole.Manager,
                DisplayName = model.DisplayName.Trim(),
                IsActive = true
            };

            DbContext.TenantUsers.Add(tenantUser);
            await DbContext.SaveChangesAsync();

            NavManager.NavigateTo("/users");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel() => NavManager.NavigateTo("/users");
}
