@page "/users"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SpeiseDirekt.Infrastructure
@using SpeiseDirekt.Model
@using SpeiseDirekt.ServiceInterface
@inject ApplicationDbContext DbContext
@inject IUserIdProvider UserIdProvider
@inject IPermissionService PermissionService
@inject NavigationManager NavManager
@attribute [Authorize]
@inject IStringLocalizer<TeamText> T
@inject IStringLocalizer<CommonText> C

<PageTitle>@C["PageTitle", T["Title"]]</PageTitle>

<!-- Header -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-8">
    <div class="p-[1rem] sm:p-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 font-display">@T["Title"]</h1>
                <p class="mt-2 text-gray-600">@T["Description"]</p>
            </div>
            @if (canCreate)
            {
                <div class="mt-4 sm:mt-0">
                    <button class="inline-flex items-center px-6 py-3 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-lg shadow-md transition-all duration-200"
                            @onclick="InviteUser">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                        </svg>
                        @T["Invite"]
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Content -->
<div>
    @if (users == null)
    {
        <div class="flex items-center justify-center py-12">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-brand-600" aria-hidden="true"></div>
            <span class="ml-3 text-gray-600">@T["Loading"]</span>
        </div>
    }
    else if (!users.Any())
    {
        <div class="text-center py-12">
            <h3 class="text-xl font-semibold text-gray-900 mb-2">@T["EmptyTitle"]</h3>
            <p class="text-gray-600 mb-6">@T["EmptyText"]</p>
        </div>
    }
    else
    {
        <!-- Role Legend -->
        <div class="flex flex-wrap gap-2 mb-6" data-testid="role-legend" role="list" aria-label="@T["RoleLegend"]">
            @foreach (var role in Enum.GetValues<TenantRole>())
            {
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium cursor-help @GetRoleBadgeClass(role)"
                      title="@PermissionCatalog.RoleSummary(T, RoleName(role), role)" data-role="@role" role="listitem">
                    @RoleName(role)
                </span>
            }
        </div>

        <!-- Users Table (scrolls sideways on phones instead of cutting off the Edit column) -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">@T["Column_Name"]</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">@T["Column_Email"]</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">@T["Column_Role"]</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">@T["Column_Status"]</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">@T["Column_Joined"]</th>
                        @if (canEdit)
                        {
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">@T["Column_Actions"]</th>
                        }
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var user in users)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                @(user.DisplayName ?? "—")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @(user.ApplicationUser?.Email ?? "—")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @GetRoleBadgeClass(user.Role)">
                                    @RoleName(user.Role)
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (user.IsActive)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">@T["Status_Active"]</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">@T["Status_Inactive"]</span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @UiFormat.Date(DateOnly.FromDateTime(user.CreatedAt))
                            </td>
                            @if (canEdit)
                            {
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                                    <button class="text-brand-600 hover:text-brand-900 font-medium mr-3"
                                            aria-label="@T["EditLabel", user.DisplayName ?? user.ApplicationUser?.Email ?? ""]"
                                            @onclick="() => EditUser(user.Id)">
                                        @C["Edit"]
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<TenantUser>? users;
    private bool canCreate;
    private bool canEdit;

    protected override async Task OnInitializedAsync()
    {
        canCreate = await PermissionService.HasPermissionAsync(Permission.UsersCreate);
        canEdit = await PermissionService.HasPermissionAsync(Permission.UsersEdit);

        var tenantOwnerId = UserIdProvider.GetUserId();
        users = await DbContext.TenantUsers
            .Include(tu => tu.ApplicationUser)
            .Where(tu => tu.TenantOwnerId == tenantOwnerId)
            .OrderBy(tu => tu.DisplayName)
            .ToListAsync();
    }

    private void InviteUser() => NavManager.NavigateTo("/users/invite");
    private void EditUser(Guid id) => NavManager.NavigateTo($"/users/edit/{id}");

    private string RoleName(TenantRole role) => C[$"Role_{role}"];

    private static string GetRoleBadgeClass(TenantRole role) => role switch
    {
        TenantRole.GeneralManager => "bg-purple-100 text-purple-800",
        TenantRole.Manager => "bg-brand-100 text-brand-800",
        TenantRole.Cashier => "bg-green-100 text-green-800",
        TenantRole.Employee => "bg-gray-100 text-gray-800",
        TenantRole.Driver => "bg-amber-100 text-amber-800",
        _ => "bg-gray-100 text-gray-800"
    };
}
