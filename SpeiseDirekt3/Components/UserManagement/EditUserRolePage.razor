@page "/users/edit/{UserId:guid}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SpeiseDirekt.Infrastructure
@using SpeiseDirekt.Model
@using SpeiseDirekt.ServiceInterface
@inject ApplicationDbContext DbContext
@inject IUserIdProvider UserIdProvider
@inject IPermissionService PermissionService
@inject INotificationService NotificationService
@inject NavigationManager NavManager
@attribute [Authorize]
@inject IStringLocalizer<TeamText> T
@inject IStringLocalizer<CommonText> C
@inject IStringLocalizer<ShellText> S

<PageTitle>@C["PageTitle", T["Edit_PageTitle"]]</PageTitle>

<div class="max-w-3xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-600 mb-6" aria-label="@S["Context_BreadcrumbLabel"]">
        <ol class="flex space-x-2">
            <li>
                <a href="/users" class="text-brand-600 hover:underline">@S["Nav_Team"]</a>
                <span class="mx-2" aria-hidden="true">/</span>
            </li>
            <li class="text-gray-800" aria-current="page">@(tenantUser?.DisplayName is { Length: > 0 } name ? T["Edit_Crumb", name] : T["Edit_CrumbUnnamed"])</li>
        </ol>
    </nav>

    @if (tenantUser == null)
    {
        <div class="flex items-center justify-center py-12" role="status">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-brand-600" aria-hidden="true"></div>
            <span class="sr-only">@C["Loading"]</span>
        </div>
    }
    else
    {
        <div class="space-y-6">
            <!-- User Info Card -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-[1rem] sm:p-6">
                <h1 class="text-xl font-bold text-gray-900 mb-4">@T["Edit_Details"]</h1>
                <div class="grid grid-cols-2 gap-4 text-sm">
                    <div>
                        <span class="text-gray-500">@T["Column_Name"]</span>
                        <p class="font-medium text-gray-900 break-words">@tenantUser.DisplayName</p>
                    </div>
                    <div>
                        <span class="text-gray-500">@T["Column_Email"]</span>
                        <p class="font-medium text-gray-900 break-all">@(tenantUser.ApplicationUser?.Email ?? "—")</p>
                    </div>
                    <div>
                        <span class="text-gray-500">@T["Column_Joined"]</span>
                        <p class="font-medium text-gray-900">@UiFormat.Date(DateOnly.FromDateTime(tenantUser.CreatedAt))</p>
                    </div>
                    <div>
                        <span class="text-gray-500">@T["Column_Status"]</span>
                        <p>
                            @if (tenantUser.IsActive)
                            {
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">@T["Status_Active"]</span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">@T["Status_Inactive"]</span>
                            }
                        </p>
                    </div>
                </div>
            </div>

            <!-- Role Selection -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-[1rem] sm:p-6">
                <h2 class="text-lg font-bold text-gray-900 mb-4">@T["Edit_Role"]</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                    @foreach (var role in Enum.GetValues<TenantRole>())
                    {
                        <button type="button"
                                class="p-4 rounded-lg border-2 text-left transition-all @(tenantUser.Role == role ? "border-brand-500 bg-brand-50" : "border-gray-200 hover:border-gray-300")"
                                aria-pressed="@(tenantUser.Role == role ? "true" : "false")"
                                @onclick="() => SetRole(role)">
                            <div class="font-medium text-gray-900">@C[$"Role_{role}"]</div>
                            <div class="text-xs text-gray-500 mt-1">@T[$"RoleDesc_{role}"]</div>
                        </button>
                    }
                </div>
            </div>

            <!-- Permission Overrides -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-[1rem] sm:p-6">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-lg font-bold text-gray-900">@T["Edit_Overrides"]</h2>
                    <button type="button" class="text-sm text-brand-600 hover:underline" @onclick="ResetToDefaults">
                        @T["Edit_Reset"]
                    </button>
                </div>
                <p class="text-sm text-gray-500 mb-4">@T["Edit_OverridesText"]</p>

                <div class="space-y-4">
                    @foreach (var area in PermissionCatalog.Areas)
                    {
                        <fieldset class="m-0 p-0 border-0 min-w-0">
                            <legend class="float-none w-auto p-0 text-sm font-semibold text-gray-700 mb-2">@T[area.NameKey]</legend>
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                                @foreach (var entry in area.Entries)
                                {
                                    <label class="flex items-center gap-2 text-sm cursor-pointer">
                                        <input type="checkbox" checked="@HasPerm(entry.Value)"
                                               @onchange="e => TogglePerm(entry.Value, (bool)(e.Value ?? false))"
                                               class="rounded border-gray-300 text-brand-600 focus:ring-brand-500" />
                                        @T[entry.LabelKey]
                                    </label>
                                }
                            </div>
                        </fieldset>
                    }
                </div>
            </div>

            <!-- Actions -->
            <div class="flex justify-between">
                <button type="button" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors"
                        @onclick="ToggleActive">
                    @(tenantUser.IsActive ? T["Edit_Deactivate"] : T["Edit_Activate"])
                </button>
                <div class="flex gap-3">
                    <button type="button" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg transition-colors"
                            @onclick="Cancel">@C["Cancel"]</button>
                    <button type="button" class="px-6 py-2 bg-brand-600 hover:bg-brand-700 text-white font-medium rounded-lg transition-colors"
                            @onclick="Save">@T["Edit_SaveChanges"]</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid UserId { get; set; }

    private TenantUser? tenantUser;
    private Permission currentPermissions;


    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionService.HasPermissionAsync(Permission.UsersEdit))
        {
            NavManager.NavigateTo("/users");
            return;
        }

        var tenantOwnerId = UserIdProvider.GetUserId();
        tenantUser = await DbContext.TenantUsers
            .Include(tu => tu.ApplicationUser)
            .FirstOrDefaultAsync(tu => tu.Id == UserId && tu.TenantOwnerId == tenantOwnerId);

        if (tenantUser != null)
        {
            currentPermissions = tenantUser.Permissions != Permission.None
                ? tenantUser.Permissions
                : PermissionDefaults.GetDefaultPermissions(tenantUser.Role);
        }
    }

    private void SetRole(TenantRole role)
    {
        if (tenantUser == null) return;
        tenantUser.Role = role;
        currentPermissions = PermissionDefaults.GetDefaultPermissions(role);
    }

    private void ResetToDefaults()
    {
        if (tenantUser == null) return;
        currentPermissions = PermissionDefaults.GetDefaultPermissions(tenantUser.Role);
    }

    private bool HasPerm(Permission perm) => (currentPermissions & perm) == perm;

    private void TogglePerm(Permission perm, bool enabled)
    {
        if (enabled)
            currentPermissions |= perm;
        else
            currentPermissions &= ~perm;
    }

    private async Task Save()
    {
        if (tenantUser == null) return;

        var roleDefaults = PermissionDefaults.GetDefaultPermissions(tenantUser.Role);
        tenantUser.Permissions = currentPermissions == roleDefaults ? Permission.None : currentPermissions;

        await DbContext.SaveChangesAsync();
        NavManager.NavigateTo("/users");
    }

    private async Task ToggleActive()
    {
        if (tenantUser == null) return;

        var deactivate = tenantUser.IsActive;
        var confirm = await NotificationService.ShowConfirmation(deactivate
            ? new ConfirmationRequest(T["Deactivate_Title"], T["Deactivate_Message", tenantUser.DisplayName ?? ""])
            {
                ConfirmText = T["Edit_Deactivate"],
                Destructive = true
            }
            : new ConfirmationRequest(T["Activate_Title"], T["Activate_Message", tenantUser.DisplayName ?? ""])
            {
                ConfirmText = T["Edit_Activate"],
                Destructive = false
            });
        if (confirm)
        {
            tenantUser.IsActive = !tenantUser.IsActive;
            await DbContext.SaveChangesAsync();
            StateHasChanged();
        }
    }

    private void Cancel() => NavManager.NavigateTo("/users");
}
