@page "/restaurant"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using SpeiseDirekt.ServiceInterface
@attribute [Authorize]
@inject IRestaurantProfileService Profiles
@inject IImageUploadService ImageUploadService
@inject IPermissionService PermissionService
@inject NavigationManager NavManager
@inject ILogger<RestaurantProfilePage> Logger
@inject IStringLocalizer<RestaurantText> T
@inject IStringLocalizer<CommonText> C

<PageTitle>@C["PageTitle", T["Title"]]</PageTitle>

<div class="max-w-4xl mx-auto space-y-6">
    <PageHeader Title="@T["Title"]" Icon="PageIcons.Restaurant" Tone="TileTone.Accent">
        <Description>
            <p class="m-0">@T["Intro"]</p>
            @if (loaded && !canEdit)
            {
                <p class="mt-3 mb-0 rounded-lg border border-brand-200 bg-brand-50 px-[0.75rem] py-2 text-sm text-brand-800" data-testid="profile-read-only">
                    @T["ReadOnly"]
                </p>
            }
        </Description>
        <Actions>
            @if (loaded && !hasProfile)
            {
                <span class="inline-flex items-center rounded-full bg-amber-50 border border-amber-200 px-2.5 py-0.5 text-xs font-medium text-amber-800" data-testid="profile-not-saved">@T["NotSaved"]</span>
            }
        </Actions>
    </PageHeader>

    @if (!loaded)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 px-[1rem] sm:px-6 py-10 text-center text-sm text-gray-500">@C["Loading"]</div>
    }
    else
    {
        <EditForm EditContext="editContext" OnSubmit="SaveAsync" class="space-y-6" data-testid="restaurant-profile-form">
            <DataAnnotationsValidator />
            <fieldset disabled="@(!canEdit)" class="space-y-6 min-w-0">

                <!-- Restaurant -->
                <section class="bg-white rounded-xl shadow-sm border border-gray-200" aria-labelledby="restaurant-basics">
                    <div class="px-[1rem] sm:px-6 py-[1rem] border-b border-gray-200">
                        <h2 id="restaurant-basics" class="text-lg font-semibold text-gray-900 mb-0">@T["Section_Restaurant"]</h2>
                    </div>
                    <div class="p-[1rem] sm:p-6 space-y-5">
                        <div class="space-y-1.5">
                            <label for="Restaurant.Name" class="block text-sm font-medium text-gray-700">@T["Field_Name"]</label>
                            <InputText @bind-Value="Input.Name" id="Restaurant.Name" maxlength="@RestaurantProfile.NameMaxLength" autocomplete="organization"
                                       placeholder="@T["Field_NamePlaceholder"]" class="@InputClass" />
                            <ValidationMessage For="() => Input.Name" class="text-red-600 text-sm" />
                        </div>
                        <div class="space-y-1.5">
                            <label for="Restaurant.Description" class="block text-sm font-medium text-gray-700">@T["Field_Description"] <span class="font-normal text-gray-400">@C["OptionalSuffix"]</span></label>
                            <InputTextArea @bind-Value="Input.Description" id="Restaurant.Description" rows="4" maxlength="@RestaurantProfile.DescriptionMaxLength"
                                           placeholder="@T["Field_DescriptionPlaceholder"]" class="@($"{InputClass} resize-y")" />
                            <p class="text-xs text-gray-500 mb-0">@T["Field_DescriptionHint"]</p>
                            <ValidationMessage For="() => Input.Description" class="text-red-600 text-sm" />
                        </div>
                    </div>
                </section>

                <!-- Pictures -->
                <section class="bg-white rounded-xl shadow-sm border border-gray-200" aria-labelledby="restaurant-pictures">
                    <div class="px-[1rem] sm:px-6 py-[1rem] border-b border-gray-200">
                        <h2 id="restaurant-pictures" class="text-lg font-semibold text-gray-900 mb-0">@T["Section_Pictures"]</h2>
                        <p class="mt-0.5 mb-0 text-sm text-gray-500">@T["Pictures_Formats"]</p>
                    </div>
                    <div class="p-[1rem] sm:p-6 space-y-6">
                        <!-- Cover -->
                        <div class="space-y-2">
                            <label for="Restaurant.Cover" class="block text-sm font-medium text-gray-700">@T["Cover"]</label>
                            <div class="relative w-full aspect-[3/1] overflow-hidden rounded-lg border border-gray-200 bg-gray-100" data-testid="cover-preview">
                                @if (!string.IsNullOrEmpty(Input.CoverImagePath))
                                {
                                    <img src="@ImageUploadService.GetImageUrl(Input.CoverImagePath)" alt="@T["Cover"]" class="absolute inset-0 h-full w-full object-cover" />
                                }
                                else
                                {
                                    <span class="absolute inset-0 flex items-center justify-center px-[1rem] text-center text-sm text-gray-400">@T["Cover_None"]</span>
                                }
                            </div>
                            <p class="text-xs text-gray-500 mb-0">@T["Cover_Hint"]</p>
                            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                                <InputFile id="Restaurant.Cover" OnChange="e => UploadAsync(e, ImageSlot.Cover)" accept="image/*" class="@FileInputClass" />
                                @if (!string.IsNullOrEmpty(Input.CoverImagePath))
                                {
                                    <button type="button" class="@RemoveButtonClass" @onclick="() => RemoveImageAsync(ImageSlot.Cover)">@T["Cover_Remove"]</button>
                                }
                            </div>
                            @if (uploadErrors.TryGetValue(ImageSlot.Cover, out var coverError))
                            {
                                <p class="text-sm text-red-600 mb-0" role="alert">@coverError</p>
                            }
                        </div>

                        <!-- Logo -->
                        <div class="space-y-2">
                            <label for="Restaurant.Logo" class="block text-sm font-medium text-gray-700">@T["Logo"]</label>
                            <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
                                <div class="relative h-24 w-24 flex-shrink-0 overflow-hidden rounded-lg border border-gray-200 bg-gray-100" data-testid="logo-preview">
                                    @if (!string.IsNullOrEmpty(Input.LogoImagePath))
                                    {
                                        <img src="@ImageUploadService.GetImageUrl(Input.LogoImagePath)" alt="@T["Logo"]" class="absolute inset-0 h-full w-full object-contain bg-white" />
                                    }
                                    else
                                    {
                                        <span class="absolute inset-0 flex items-center justify-center text-xs text-gray-400">@T["Logo_None"]</span>
                                    }
                                </div>
                                <div class="min-w-0 flex-1 space-y-2">
                                    <p class="text-xs text-gray-500 mb-0">@T["Logo_Hint"]</p>
                                    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                                        <InputFile id="Restaurant.Logo" OnChange="e => UploadAsync(e, ImageSlot.Logo)" accept="image/*" class="@FileInputClass" />
                                        @if (!string.IsNullOrEmpty(Input.LogoImagePath))
                                        {
                                            <button type="button" class="@RemoveButtonClass" @onclick="() => RemoveImageAsync(ImageSlot.Logo)">@T["Logo_Remove"]</button>
                                        }
                                    </div>
                                </div>
                            </div>
                            @if (uploadErrors.TryGetValue(ImageSlot.Logo, out var logoError))
                            {
                                <p class="text-sm text-red-600 mb-0" role="alert">@logoError</p>
                            }
                        </div>
                    </div>
                </section>

                <!-- Contact -->
                <section class="bg-white rounded-xl shadow-sm border border-gray-200" aria-labelledby="restaurant-contact">
                    <div class="px-[1rem] sm:px-6 py-[1rem] border-b border-gray-200">
                        <h2 id="restaurant-contact" class="text-lg font-semibold text-gray-900 mb-0">@T["Section_Contact"]</h2>
                    </div>
                    <div class="p-[1rem] sm:p-6 space-y-5">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-5">
                            <div class="space-y-1.5">
                                <label for="Restaurant.Phone" class="block text-sm font-medium text-gray-700">@T["Field_Phone"]</label>
                                <InputText @bind-Value="Input.Phone" id="Restaurant.Phone" inputmode="tel" autocomplete="tel" maxlength="40"
                                           placeholder="+43 1 234 56 78" class="@InputClass" />
                                <ValidationMessage For="() => Input.Phone" class="text-red-600 text-sm" />
                            </div>
                            <div class="space-y-1.5">
                                <label for="Restaurant.Email" class="block text-sm font-medium text-gray-700">@T["Field_Email"]</label>
                                <InputText @bind-Value="Input.Email" id="Restaurant.Email" inputmode="email" autocomplete="email" maxlength="200"
                                           placeholder="info@example.com" class="@InputClass" />
                                <ValidationMessage For="() => Input.Email" class="text-red-600 text-sm" />
                            </div>
                        </div>
                        <div class="space-y-1.5">
                            <label for="Restaurant.Website" class="block text-sm font-medium text-gray-700">@T["Field_Website"]</label>
                            <InputText @bind-Value="Input.Website" id="Restaurant.Website" inputmode="url" autocomplete="url" maxlength="@RestaurantProfile.UrlMaxLength"
                                       placeholder="https://www.example.com" class="@InputClass" />
                            <ValidationMessage For="() => Input.Website" class="text-red-600 text-sm" />
                        </div>
                        <div class="space-y-1.5">
                            <label for="Restaurant.Address" class="block text-sm font-medium text-gray-700">@T["Field_Address"]</label>
                            <InputTextArea @bind-Value="Input.Address" id="Restaurant.Address" rows="3" maxlength="500" autocomplete="street-address"
                                           placeholder="@("Hauptplatz 1\n1010 Wien")" class="@($"{InputClass} resize-y")" />
                            <ValidationMessage For="() => Input.Address" class="text-red-600 text-sm" />
                        </div>
                    </div>
                </section>

                <!-- Opening hours -->
                <section class="bg-white rounded-xl shadow-sm border border-gray-200" aria-labelledby="restaurant-hours">
                    <div class="px-[1rem] sm:px-6 py-[1rem] border-b border-gray-200">
                        <h2 id="restaurant-hours" class="text-lg font-semibold text-gray-900 mb-0">@T["Section_Hours"]</h2>
                    </div>
                    <div class="p-[1rem] sm:p-6 space-y-1.5">
                        <label for="Restaurant.OpeningHours" class="sr-only">@T["Section_Hours"]</label>
                        <InputTextArea @bind-Value="Input.OpeningHours" id="Restaurant.OpeningHours" rows="4" maxlength="1000"
                                       placeholder="@HoursPlaceholder" class="@($"{InputClass} resize-y")" />
                        <p class="text-xs text-gray-500 mb-0">@T["Hours_Hint"]</p>
                        <ValidationMessage For="() => Input.OpeningHours" class="text-red-600 text-sm" />
                    </div>
                </section>

                <!-- Links -->
                <section class="bg-white rounded-xl shadow-sm border border-gray-200" aria-labelledby="restaurant-links">
                    <div class="px-[1rem] sm:px-6 py-[1rem] border-b border-gray-200">
                        <h2 id="restaurant-links" class="text-lg font-semibold text-gray-900 mb-0">@T["Section_Links"]</h2>
                        <p class="mt-0.5 mb-0 text-sm text-gray-500">@T["Links_Hint"]</p>
                    </div>
                    <div class="p-[1rem] sm:p-6 space-y-5">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-5">
                            <div class="space-y-1.5">
                                <label for="Restaurant.InstagramUrl" class="block text-sm font-medium text-gray-700">@T["Field_Instagram"]</label>
                                <InputText @bind-Value="Input.InstagramUrl" id="Restaurant.InstagramUrl" inputmode="url" maxlength="@RestaurantProfile.UrlMaxLength"
                                           placeholder="https://www.instagram.com/…" class="@InputClass" />
                                <ValidationMessage For="() => Input.InstagramUrl" class="text-red-600 text-sm" />
                            </div>
                            <div class="space-y-1.5">
                                <label for="Restaurant.FacebookUrl" class="block text-sm font-medium text-gray-700">@T["Field_Facebook"]</label>
                                <InputText @bind-Value="Input.FacebookUrl" id="Restaurant.FacebookUrl" inputmode="url" maxlength="@RestaurantProfile.UrlMaxLength"
                                           placeholder="https://www.facebook.com/…" class="@InputClass" />
                                <ValidationMessage For="() => Input.FacebookUrl" class="text-red-600 text-sm" />
                            </div>
                        </div>
                        <div class="space-y-1.5">
                            <label for="Restaurant.GoogleReviewUrl" class="block text-sm font-medium text-gray-700">@T["Field_Review"]</label>
                            <InputText @bind-Value="Input.GoogleReviewUrl" id="Restaurant.GoogleReviewUrl" inputmode="url" maxlength="@RestaurantProfile.UrlMaxLength"
                                       placeholder="https://g.page/r/…/review" class="@InputClass" />
                            <p class="text-xs text-gray-500 mb-0">@T["Field_ReviewHint"]</p>
                            <ValidationMessage For="() => Input.GoogleReviewUrl" class="text-red-600 text-sm" />
                        </div>
                    </div>
                </section>
            </fieldset>

            @if (canEdit)
            {
                <!-- Save bar -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 px-[1rem] sm:px-6 py-[1rem] flex flex-wrap items-center justify-end gap-x-4 gap-y-2">
                    @if (saved)
                    {
                        <p class="mr-auto mb-0 flex items-center text-sm font-medium text-green-700" role="status" data-testid="profile-saved">
                            <svg class="mr-1.5 h-5 w-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            @T["Saved"]
                        </p>
                    }
                    else if (hasValidationErrors)
                    {
                        <p class="mr-auto mb-0 text-sm text-red-600" role="alert" data-testid="profile-invalid">@T["Invalid"]</p>
                    }
                    else if (saveError is not null)
                    {
                        <p class="mr-auto mb-0 text-sm text-red-600" role="alert">@saveError</p>
                    }
                    <button type="submit" disabled="@(isSaving || isUploading)"
                            class="inline-flex items-center px-6 py-2 bg-brand-600 hover:bg-brand-700 text-white font-medium rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                        @(isSaving ? C["Saving"] : isUploading ? T["Uploading"] : T["Save"])
                    </button>
                </div>
            }
        </EditForm>
    }
</div>

@code {
    private const string InputClass =
        "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors disabled:bg-gray-100 disabled:text-gray-600";
    private const string FileInputClass =
        "block w-full sm:w-auto text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100";
    private const string RemoveButtonClass =
        "px-3 py-1 text-sm text-red-600 hover:text-red-800 border border-red-300 rounded-md hover:bg-red-50 transition-colors";

    private enum ImageSlot { Logo, Cover }

    /// <summary>The opening hours' example, one line per resource key.</summary>
    private string HoursPlaceholder => string.Join("\n", T["Hours_Placeholder1"], T["Hours_Placeholder2"], T["Hours_Placeholder3"]);

    private RestaurantProfile Input = new();
    private EditContext editContext = new(new RestaurantProfile());
    private bool loaded, hasProfile, canEdit;
    private bool isSaving, isUploading, saved, hasValidationErrors;
    private string? saveError;
    private readonly Dictionary<ImageSlot, string> uploadErrors = new();

    /// <summary>Image paths as stored: replaced or removed ones are deleted after a successful save.</summary>
    private string? storedLogo, storedCover;

    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionService.HasPermissionAsync(Permission.MenusView))
        {
            NavManager.NavigateTo("/Account/AccessDenied", forceLoad: true);
            return;
        }
        canEdit = await PermissionService.HasPermissionAsync(Permission.MenusEdit);

        var profile = await Profiles.GetOwnAsync();
        hasProfile = profile is not null;
        SetInput(profile ?? new RestaurantProfile());
        loaded = true;
    }

    private void SetInput(RestaurantProfile profile)
    {
        Input = profile;
        storedLogo = profile.LogoImagePath;
        storedCover = profile.CoverImagePath;
        editContext = new EditContext(Input);
        editContext.OnFieldChanged += (_, _) =>
        {
            saved = false;
            hasValidationErrors = false;
        };
    }

    private async Task SaveAsync()
    {
        if (!canEdit || isSaving || isUploading) return;
        saved = false;
        saveError = null;

        hasValidationErrors = !editContext.Validate();
        if (hasValidationErrors)
            return;

        isSaving = true;
        try
        {
            var result = await Profiles.SaveOwnAsync(Input);

            // Pictures replaced or removed with this save are no longer used anywhere
            foreach (var old in new[] { storedLogo, storedCover })
            {
                if (!string.IsNullOrEmpty(old) && old != result.Profile.LogoImagePath && old != result.Profile.CoverImagePath)
                    await ImageUploadService.DeleteImageAsync(old);
            }

            hasProfile = true;
            SetInput(result.Profile);
            saved = true;
        }
        catch (ValidationException ex)
        {
            saveError = ex.ValidationResult.ErrorMessage ?? T["Error_CheckFields"];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving the restaurant profile failed");
            saveError = T["Error_Save"];
        }
        finally
        {
            isSaving = false;
        }
    }

    private string? GetPath(ImageSlot slot) => slot == ImageSlot.Logo ? Input.LogoImagePath : Input.CoverImagePath;
    private string? StoredPath(ImageSlot slot) => slot == ImageSlot.Logo ? storedLogo : storedCover;

    private void SetPath(ImageSlot slot, string? path)
    {
        if (slot == ImageSlot.Logo)
            Input.LogoImagePath = path;
        else
            Input.CoverImagePath = path;
        saved = false;
    }

    private async Task UploadAsync(InputFileChangeEventArgs e, ImageSlot slot)
    {
        uploadErrors.Remove(slot);
        var file = e.File;
        if (file is null) return;

        if (!ImageUploadService.IsValidImageFile(file))
        {
            uploadErrors[slot] = T["Error_InvalidImage"];
            return;
        }

        isUploading = true;
        try
        {
            var path = await ImageUploadService.UploadImageAsync(file);
            if (path is null)
            {
                uploadErrors[slot] = T["Error_Upload"];
                return;
            }

            // A picture uploaded before in this visit but never saved is not needed any more
            await DeleteUnsavedAsync(slot);
            SetPath(slot, path);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Uploading a restaurant picture failed");
            uploadErrors[slot] = T["Error_Upload"];
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task RemoveImageAsync(ImageSlot slot)
    {
        uploadErrors.Remove(slot);
        // The stored picture is only deleted when the profile is saved without it
        await DeleteUnsavedAsync(slot);
        SetPath(slot, null);
    }

    private async Task DeleteUnsavedAsync(ImageSlot slot)
    {
        var current = GetPath(slot);
        if (!string.IsNullOrEmpty(current) && current != StoredPath(slot))
            await ImageUploadService.DeleteImageAsync(current);
    }
}
