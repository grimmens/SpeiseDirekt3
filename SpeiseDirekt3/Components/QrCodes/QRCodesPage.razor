@page "/qrcodes"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SpeiseDirekt.Model
@using SpeiseDirekt.ServiceInterface
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager
@inject INotificationService NotificationService
@inject IMenuItemGenerator MenuItemGenerator
@inject IPermissionService PermissionService
@inject IJSRuntime JS
@inherits PaidTenantComponentBase
@attribute [Authorize]

<PageTitle>QR Codes - Speise-Direkt</PageTitle>

<!-- Header Section -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-8">
    <div class="p-[1rem] sm:p-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 font-display">QR Codes</h1>
                <p class="mt-2 text-gray-600">Generate and manage QR codes for your digital menus</p>
            </div>
            <div class="mt-4 sm:mt-0">
                @if (CanCreateQrCode)
                {
                    <button class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200"
                            @onclick="CreateNew">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
                        </svg>
                        Create New QR Code
                    </button>
                }
                else
                {
                    <div class="text-center">
                        <button class="inline-flex items-center px-6 py-3 bg-gray-400 text-white font-semibold rounded-lg cursor-not-allowed" disabled>
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                            </svg>
                            Create New QR Code
                        </button>
                        <p class="mt-2 text-sm text-gray-500">Cannot create a new QR code at this time</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Content Section -->
    @if (codes == null)
    {
        <!-- Loading State -->
        <div class="flex items-center justify-center py-12">
            <div class="flex items-center space-x-3">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
                <span class="text-lg text-gray-600">Loading QR codes...</span>
            </div>
        </div>
    }
    else if (!codes.Any())
    {
        <!-- Empty State -->
        <div class="text-center py-12">
            <div class="mx-auto h-24 w-24 text-gray-400 mb-6">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
                </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">No QR codes yet</h3>
            <p class="text-gray-600 mb-6">Create your first QR code to start sharing your digital menus</p>
            @if (CanCreateQrCode)
            {
                <button class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200"
                        @onclick="CreateNew">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
                    </svg>
                    Create Your First QR Code
                </button>
            }
        </div>
    }
    else
    {
        <!-- QR Codes Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 2xl:grid-cols-3 gap-x-4 gap-y-4">
            @foreach (var qrCode in codes)
            {
                var mode = ModeOf(qrCode);
                <div @key="qrCode.Id" class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow duration-200 border border-gray-200 p-3.5 sm:p-5" data-testid="qr-card">
                    <div class="flex items-start gap-x-3.5 sm:gap-x-4">
                        <!-- QR Code Preview (click to enlarge) -->
                        <div class="flex-shrink-0 p-1.5 bg-gray-50 rounded-lg border border-gray-100">
                            <QrCodePreview QrId="@qrCode.Id" ThumbnailSize="112" Title="@qrCode.Title" ImageClass="w-24 h-24 sm:w-28 sm:h-28" />
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                <h3 class="text-base sm:text-lg font-bold text-gray-900 min-w-0 break-words">
                                    <a href="@QrCodeLinks.GuestPath(qrCode.Id)" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 hover:underline">
                                        @qrCode.Title&#8288;<svg class="inline w-4 h-4 ml-1 -mt-0.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                                        </svg>
                                    </a>
                                </h3>
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium @BadgeClass(mode)" data-testid="qr-mode">@mode</span>
                            </div>
                            <p class="mt-1.5 text-sm text-gray-700 break-words" data-testid="qr-target">@TargetText(qrCode)</p>
                            <p class="mt-1 text-xs text-gray-500 truncate" title="@GuestUrl(qrCode.Id)" data-testid="qr-url">@GuestUrl(qrCode.Id)</p>
                        </div>
                    </div>

                    <!-- Actions -->
                    <QrCodeShareActions QrId="@qrCode.Id" Title="@qrCode.Title" Class="mt-3.5">
                        @if (canEditQr)
                        {
                            <button class="inline-flex items-center px-3.5 py-2 border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg transition-colors duration-200"
                                    @onclick="() => Edit(qrCode.Id)">
                                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                </svg>
                                Edit
                            </button>
                        }
                        @if (canDeleteQr)
                        {
                            <button class="inline-flex items-center px-2.5 py-2 border border-red-200 bg-white hover:bg-red-50 text-red-600 text-sm font-medium rounded-lg transition-colors duration-200"
                                    title="Delete" aria-label="@($"Delete {qrCode.Title}")"
                                    @onclick="() => Delete(qrCode.Id)">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                            </button>
                        }
                    </QrCodeShareActions>
                </div>
            }
        </div>
    }

@code {
    private List<QRCode>? codes;
    private bool canEditQr, canDeleteQr;

    private enum QrMode { Direct, Schedule, Calendar }

    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionService.HasPermissionAsync(Permission.QrCodesView))
        {
            NavManager.NavigateTo("/Account/AccessDenied", forceLoad: true);
            return;
        }

        canEditQr = await PermissionService.HasPermissionAsync(Permission.QrCodesEdit);
        canDeleteQr = await PermissionService.HasPermissionAsync(Permission.QrCodesDelete);
        codes = await DbContext.QRCodes
            .Include(q => q.Menu)
            .Include(q => q.TimeTableEntries!).ThenInclude(e => e.Menu)
            .Include(q => q.CalendarEntries)
            .OrderByDescending(q => q.CreatedAt)
            .ToListAsync();
        await base.OnInitializedAsync();
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("import", "./js/qr-codes.js"); // "Copy link"
    }

    Task Create100Menus() => MenuItemGenerator.CreateMenus(async () => await OnInitializedAsync(), 10);

    void CreateNew() => NavManager.NavigateTo("/qrcode/edit");

    void Edit(Guid id) => NavManager.NavigateTo($"/qrcode/edit/{id}");

    async Task Delete(Guid id)
    {
        if (!canDeleteQr) return;
        var code = await DbContext.QRCodes.FindAsync(id);
        if (code == null) return;

        if (await NotificationService.ShowConfirmation(("Delete QR Code",
                $"Are you sure you want to delete the QR code “{code.Title}”?")))
        {
            // Views keep their menu but lose the code: MenuView.QRCodeId is a NoAction foreign key
            await DbContext.MenuViews.Where(v => v.QRCodeId == id)
                .ExecuteUpdateAsync(s => s.SetProperty(v => v.QRCodeId, (Guid?)null));
            DbContext.QRCodes.Remove(code);
            await DbContext.SaveChangesAsync();
            codes!.RemoveAll(q => q.Id == id);
            StateHasChanged();
        }
        await base.ReloadAuthState();
    }

    // Calendar wins over the schedule, as in MenuService
    private static QrMode ModeOf(QRCode q) =>
        q.IsCalendarBased ? QrMode.Calendar : q.IsTimeTableBased ? QrMode.Schedule : QrMode.Direct;

    private static string BadgeClass(QrMode mode) => mode switch
    {
        QrMode.Schedule => "bg-amber-100 text-amber-800",
        QrMode.Calendar => "bg-violet-100 text-violet-800",
        _ => "bg-blue-100 text-blue-800"
    };

    /// <summary>What a guest gets: the menu, the time windows, or the number of calendar entries and the fallback.</summary>
    private static string TargetText(QRCode q)
    {
        switch (ModeOf(q))
        {
            case QrMode.Calendar:
                var count = q.CalendarEntries?.Count ?? 0;
                var otherwise = q.IsTimeTableBased ? $"otherwise the schedule: {ScheduleText(q)}"
                    : q.Menu is { } fallback ? $"otherwise {fallback.Name}"
                    : "otherwise no menu";
                return $"{count} {(count == 1 ? "entry" : "entries")}, {otherwise}";
            case QrMode.Schedule:
                return ScheduleText(q);
            default:
                return q.Menu?.Name ?? "No menu selected";
        }
    }

    /// <summary>Time windows as "11:00–14:00 Mittagskarte · 17:00–22:00 Gasthaus Zur Post".</summary>
    private static string ScheduleText(QRCode q)
    {
        var entries = (q.TimeTableEntries ?? new()).OrderBy(e => e.StartTime).ToList();
        if (entries.Count == 0)
            return "No time windows yet";
        return string.Join(" · ", entries.Select(e =>
            $"{e.StartTime?.ToString("HH:mm", CultureInfo.InvariantCulture)}–{e.EndTime?.ToString("HH:mm", CultureInfo.InvariantCulture)} {e.Menu?.Name ?? "(no menu)"}"));
    }

    // The absolute URL the QR code encodes (shown and copied)
    string GuestUrl(Guid qrId) => NavManager.BaseUri + QrCodeLinks.GuestPath(qrId);
}
