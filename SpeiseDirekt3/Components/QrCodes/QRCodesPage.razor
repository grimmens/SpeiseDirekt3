@page "/qrcodes"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SpeiseDirekt.Model
@using SpeiseDirekt.ServiceInterface
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager
@inject INotificationService NotificationService
@inject IMenuItemGenerator MenuItemGenerator
@inject IPermissionService PermissionService
@inject ITenantPlanService Plans
@inject IUserIdProvider UserIdProvider
@inject IJSRuntime JS
@inject IStringLocalizer<QrCodesText> T
@inject IStringLocalizer<CommonText> C
@attribute [Authorize]

<PageTitle>@C["PageTitle", T["List_Title"]]</PageTitle>

<PageHeader Title="@T["List_Title"]" Icon="PageIcons.QrCodes" Tone="TileTone.Violet">
    <Description>@T["List_Description"]</Description>
    <Actions>
        @if (createKnown && canCreateQr && !qrLimitReached)
        {
            <button type="button" class="sd-btn sd-btn--primary" @onclick="CreateNew" data-testid="qr-create-button">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
                </svg>
                @T["List_Create"]
            </button>
        }
        else if (createKnown && canCreateQr)
        {
            @* Free plan at its QR code limit: the action stays visible (disabled) with the reason next to it *@
            <div class="sd-plan-limit sd-plan-limit--end">
                <button type="button" class="sd-btn sd-btn--primary" disabled aria-describedby="qr-limit-hint" data-testid="qr-create-button">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
                    </svg>
                    @T["List_Create"]
                </button>
                <PlanLimitHint Text="@T["Plan_QrCodeLimit"]" Id="qr-limit-hint" TestId="qr-limit-hint" />
            </div>
        }
    </Actions>
</PageHeader>

<!-- Content Section -->
    @if (codes == null)
    {
        <!-- Loading State -->
        <div class="flex items-center justify-center py-12">
            <div class="flex items-center space-x-3">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-brand-600"></div>
                <span class="text-lg text-gray-600">@T["List_Loading"]</span>
            </div>
        </div>
    }
    else if (!codes.Any())
    {
        <!-- Empty State -->
        <div class="text-center py-12">
            <div class="mx-auto h-24 w-24 text-gray-400 mb-6">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
                </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">@T["List_EmptyTitle"]</h3>
            <p class="text-gray-600 mb-6">@T["List_EmptyText"]</p>
            @if (canCreateQr && !qrLimitReached)
            {
                <button class="inline-flex items-center px-6 py-3 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-lg shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200"
                        @onclick="CreateNew" data-testid="qr-create-first-button">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
                    </svg>
                    @T["List_EmptyCreate"]
                </button>
            }
            else if (canCreateQr)
            {
                @* Only with a free limit of 0 QR codes (Plans:Free:MaxQrCodes), kept like the header's action *@
                <div class="sd-plan-limit sd-plan-limit--center">
                    <button type="button" disabled aria-describedby="qr-limit-hint-empty" data-testid="qr-create-first-button"
                            class="inline-flex items-center px-6 py-3 bg-brand-600 text-white font-semibold rounded-lg opacity-50 cursor-not-allowed">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
                        </svg>
                        @T["List_EmptyCreate"]
                    </button>
                    <PlanLimitHint Text="@T["Plan_QrCodeLimit"]" Id="qr-limit-hint-empty" TestId="qr-limit-hint-empty" />
                </div>
            }
        </div>
    }
    else
    {
        <!-- QR Codes Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 2xl:grid-cols-3 gap-x-4 gap-y-4">
            @foreach (var qrCode in codes)
            {
                var mode = ModeOf(qrCode);
                <div @key="qrCode.Id" class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow duration-200 border border-gray-200 p-3.5 sm:p-5" data-testid="qr-card">
                    <div class="flex items-start gap-x-3.5 sm:gap-x-4">
                        <!-- QR Code Preview (click to enlarge) -->
                        <div class="flex-shrink-0 p-1.5 bg-gray-50 rounded-lg border border-gray-100">
                            <QrCodePreview QrId="@qrCode.Id" ThumbnailSize="112" Title="@qrCode.Title" ImageClass="w-24 h-24 sm:w-28 sm:h-28" />
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                <h3 class="text-base sm:text-lg font-bold text-gray-900 min-w-0 break-words">
                                    <a href="@QrCodeLinks.GuestPath(qrCode.Id)" target="_blank" rel="noopener noreferrer" class="hover:text-brand-600 hover:underline">
                                        @qrCode.Title&#8288;<svg class="inline w-4 h-4 ml-1 -mt-0.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                                        </svg>
                                    </a>
                                </h3>
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium @BadgeClass(mode)" data-testid="qr-mode">@T[$"Mode_{mode}"]</span>
                            </div>
                            <p class="mt-1.5 text-sm text-gray-700 break-words" data-testid="qr-target">@TargetText(qrCode)</p>
                            <p class="mt-1 text-xs text-gray-500 truncate" title="@GuestUrl(qrCode.Id)" data-testid="qr-url">@GuestUrl(qrCode.Id)</p>
                        </div>
                    </div>

                    <!-- Actions -->
                    <QrCodeShareActions QrId="@qrCode.Id" Title="@qrCode.Title" Class="mt-3.5">
                        @if (canEditQr)
                        {
                            <button class="inline-flex items-center px-3.5 py-2 border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg transition-colors duration-200"
                                    @onclick="() => Edit(qrCode.Id)">
                                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                </svg>
                                @C["Edit"]
                            </button>
                        }
                        else
                        {
                            @* Without QrCodesEdit (but with QrCodesView, checked above) the editor opens read-only (the calendar shows which menu guests get when) *@
                            <button class="inline-flex items-center px-3.5 py-2 border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg transition-colors duration-200"
                                    @onclick="() => Edit(qrCode.Id)">
                                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                </svg>
                                @T["List_View"]
                            </button>
                        }
                        @if (canDeleteQr)
                        {
                            <button class="inline-flex items-center px-2.5 py-2 border border-red-200 bg-white hover:bg-red-50 text-red-600 text-sm font-medium rounded-lg transition-colors duration-200"
                                    title="@C["Delete"]" aria-label="@T["List_DeleteLabel", qrCode.Title]"
                                    @onclick="() => Delete(qrCode.Id)">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                            </button>
                        }
                    </QrCodeShareActions>
                </div>
            }
        </div>
    }

@code {
    private List<QRCode>? codes;
    private bool canCreateQr, canEditQr, canDeleteQr;
    /// <summary>Free plan at its QR code limit (ITenantPlanService, read from the database): "Create New QR Code" is
    /// disabled with the hint.</summary>
    private bool qrLimitReached;
    /// <summary>The limit is loaded: the create action appears together with its state, never enabled first and disabled
    /// a moment later.</summary>
    private bool createKnown;

    private enum QrMode { Direct, Schedule, Calendar }

    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionService.HasPermissionAsync(Permission.QrCodesView))
        {
            NavManager.NavigateTo("/Account/AccessDenied", forceLoad: true);
            return;
        }

        canCreateQr = await PermissionService.HasPermissionAsync(Permission.QrCodesCreate);
        canEditQr = await PermissionService.HasPermissionAsync(Permission.QrCodesEdit);
        canDeleteQr = await PermissionService.HasPermissionAsync(Permission.QrCodesDelete);
        await RefreshQrLimitAsync();
        createKnown = true;
        codes = await DbContext.QRCodes
            .Include(q => q.Menu)
            .Include(q => q.TimeTableEntries!).ThenInclude(e => e.Menu)
            .Include(q => q.CalendarEntries)
            .OrderByDescending(q => q.CreatedAt)
            .ToListAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("import", "./js/qr-codes.js"); // "Copy link"
    }

    Task Create100Menus() => MenuItemGenerator.CreateMenus(async () => await OnInitializedAsync(), 10);

    void CreateNew() => NavManager.NavigateTo("/qrcode/edit");

    void Edit(Guid id) => NavManager.NavigateTo($"/qrcode/edit/{id}");

    async Task Delete(Guid id)
    {
        if (!canDeleteQr) return;
        var code = await DbContext.QRCodes.FindAsync(id);
        if (code == null) return;

        if (await NotificationService.ShowConfirmation(new ConfirmationRequest(T["Delete_Title"], T["Delete_Message", code.Title])
            {
                ConfirmText = T["Delete_Title"],
                Destructive = true
            }))
        {
            // Views keep their menu but lose the code: MenuView.QRCodeId is a NoAction foreign key
            await DbContext.MenuViews.Where(v => v.QRCodeId == id)
                .ExecuteUpdateAsync(s => s.SetProperty(v => v.QRCodeId, (Guid?)null));
            DbContext.QRCodes.Remove(code);
            await DbContext.SaveChangesAsync();
            codes!.RemoveAll(q => q.Id == id);
        }
        // One code fewer may lift the free limit
        await RefreshQrLimitAsync();
        StateHasChanged();
    }

    /// <summary>The tenant may not create one more QR code (free, at its limit); read from the database at every call.</summary>
    private async Task RefreshQrLimitAsync() =>
        qrLimitReached = canCreateQr && !await Plans.CanCreateQrCodeAsync(UserIdProvider.GetUserId());

    // Calendar wins over the schedule, as in MenuService
    private static QrMode ModeOf(QRCode q) =>
        q.IsCalendarBased ? QrMode.Calendar : q.IsTimeTableBased ? QrMode.Schedule : QrMode.Direct;

    private static string BadgeClass(QrMode mode) => mode switch
    {
        QrMode.Schedule => "bg-amber-100 text-amber-800",
        QrMode.Calendar => "bg-violet-100 text-violet-800",
        _ => "bg-brand-100 text-brand-800"
    };

    /// <summary>What a guest gets: the menu, the time windows, or the number of calendar entries and the fallback.</summary>
    private string TargetText(QRCode q)
    {
        switch (ModeOf(q))
        {
            case QrMode.Calendar:
                var count = q.CalendarEntries?.Count ?? 0;
                return q.IsTimeTableBased ? T.Plural(count, "Target_CalendarSchedule", ScheduleText(q))
                    : q.Menu is { } fallback ? T.Plural(count, "Target_CalendarMenu", fallback.Name)
                    : T.Plural(count, "Target_CalendarNone");
            case QrMode.Schedule:
                return ScheduleText(q);
            default:
                return q.Menu?.Name ?? T["Target_NoMenu"];
        }
    }

    /// <summary>Time windows as "11:00–14:00 Mittagskarte · 17:00–22:00 Gasthaus Zur Post".</summary>
    private string ScheduleText(QRCode q)
    {
        var entries = (q.TimeTableEntries ?? new()).OrderBy(e => e.StartTime).ToList();
        if (entries.Count == 0)
            return T["Schedule_None"];
        return string.Join(" · ", entries.Select(e => T["Schedule_Window",
            e.StartTime?.ToString("HH:mm", CultureInfo.InvariantCulture) ?? "", e.EndTime?.ToString("HH:mm", CultureInfo.InvariantCulture) ?? "",
            e.Menu?.Name ?? T["NoMenu"]].Value));
    }

    // The absolute URL the QR code encodes (shown and copied)
    string GuestUrl(Guid qrId) => NavManager.BaseUri + QrCodeLinks.GuestPath(qrId);
}
