@page "/qrcode/edit/{Id:guid?}"
@using Microsoft.EntityFrameworkCore
@using SpeiseDirekt.Model
@using SpeiseDirekt.ServiceInterface
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SpeiseDirekt.Infrastructure
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager
@inject IPermissionService PermissionService
@inject TimeProvider Clock
@inject IJSRuntime JS
@inject SpeiseDirekt3.Components.Plausible.PlausibleEvents Events
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<QrCodesText> T
@inject IStringLocalizer<CommonText> C
@inject IStringLocalizer<ShellText> S

<PageTitle>@C["PageTitle", HeadingText]</PageTitle>

<!-- QR Code Edit Page -->
<!-- Header Section -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-8">
    <div class="p-[1rem] sm:p-6">
            <!-- Breadcrumb -->
            <nav class="flex mb-4" aria-label="@S["Context_BreadcrumbLabel"]">
                <ol class="inline-flex items-center space-x-1 md:space-x-3">
                    <li class="inline-flex items-center">
                        <a href="/qrcodes" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-brand-600">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
                            </svg>
                            @T["List_Title"]
                        </a>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                            </svg>
                            <span class="ml-1 text-sm font-medium text-gray-500">@(IsNew ? T["Edit_CrumbNew"] : readOnly ? T["Edit_CrumbView"] : T["Edit_CrumbEdit"])</span>
                        </div>
                    </li>
                </ol>
            </nav>

            <!-- Page Header -->
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    <div class="h-12 w-12 bg-brand-100 rounded-lg flex items-center justify-center">
                        <svg class="h-6 w-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
                        </svg>
                    </div>
                </div>
                <div class="ml-4">
                    <h1 class="text-3xl font-bold text-gray-900 font-display">@HeadingText</h1>
                    <p class="mt-1 text-gray-600">@(IsNew ? T["Edit_TextNew"] : readOnly ? T["Edit_TextView"] : T["Edit_TextEdit"])</p>
                </div>
            </div>
        </div>
    </div>

<!-- Content Section -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="px-3.5 py-6 sm:p-8">
        @if (editContext is null)
        {
            @* Interactive render before the QR code is loaded: no form yet, so nothing typed or clicked in a
               throw-away form is lost when the real one replaces it *@
            <div class="flex items-center justify-center py-12">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-brand-600"></div>
                <span class="ml-3 text-gray-600">@T["Edit_Loading"]</span>
            </div>
        }
        else
        {
        <EditForm EditContext="editContext" OnValidSubmit="HandleValidSubmit" class="space-y-8">
            <DataAnnotationsValidator />
            <ValidationSummary class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm" />

            @if (readOnly)
            {
                <div class="bg-brand-50 border border-brand-200 text-brand-800 rounded-lg px-3.5 py-2.5 text-sm" role="status" data-testid="qr-readonly-notice">
                    @T["Edit_ReadOnly"]
                </div>
            }

            @* Read-only: every field of title, mode and the mode's settings is disabled (the calendar has its own read-only mode,
               its month buttons must stay usable) *@
            <fieldset disabled="@readOnly" class="space-y-8">
            <!-- QR Code Title -->
            <div>
                <label for="qrTitle" class="block text-sm font-medium text-gray-700 mb-2">@T["Edit_Title"]</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                        </svg>
                    </div>
                    <InputText @bind-Value="Item.Title"
                               id="qrTitle"
                               class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors duration-200"
                               placeholder="@T["Edit_TitlePlaceholder"]" />
                </div>
                <ValidationMessage For="@(() => Item.Title)" class="mt-1 text-sm text-red-600" />
                <p class="mt-1 text-xs text-gray-500">@T["Edit_TitleHint"]</p>
            </div>

            <!-- Display Mode Selection -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-4">@T["Edit_Mode"]</label>
                <div class="bg-gray-50 rounded-lg p-[1rem] sm:p-6">
                    <InputRadioGroup Name="displayMode" TValue="DisplayMode" Value="mode" ValueChanged="OnModeChanged" ValueExpression="() => mode" class="space-y-4">
                        <div class="flex items-start">
                            <div class="flex items-center h-5">
                                <InputRadio id="simple" name="displayMode" Value="DisplayMode.Direct" class="focus:ring-brand-500 h-4 w-4 text-brand-600 border-gray-300" />
                            </div>
                            <div class="ml-3">
                                <label for="simple" class="font-medium text-gray-900 cursor-pointer">@T["Edit_ModeDirect"]</label>
                                <p class="text-gray-500 text-sm">@T["Edit_ModeDirectText"]</p>
                            </div>
                        </div>
                        <div class="flex items-start">
                            <div class="flex items-center h-5">
                                <InputRadio id="timetable" name="displayMode" Value="DisplayMode.Schedule" class="focus:ring-brand-500 h-4 w-4 text-brand-600 border-gray-300" />
                            </div>
                            <div class="ml-3">
                                <label for="timetable" class="font-medium text-gray-900 cursor-pointer">@T["Edit_ModeSchedule"]</label>
                                <p class="text-gray-500 text-sm">@T["Edit_ModeScheduleText"]</p>
                            </div>
                        </div>
                        <div class="flex items-start">
                            <div class="flex items-center h-5">
                                <InputRadio id="calendar" name="displayMode" Value="DisplayMode.Calendar" class="focus:ring-brand-500 h-4 w-4 text-brand-600 border-gray-300" />
                            </div>
                            <div class="ml-3">
                                <label for="calendar" class="font-medium text-gray-900 cursor-pointer">@T["Edit_ModeCalendar"]</label>
                                <p class="text-gray-500 text-sm">@T["Edit_ModeCalendarText"]</p>
                            </div>
                        </div>
                    </InputRadioGroup>
                </div>
            </div>
            </fieldset>

            @if (mode == DisplayMode.Direct)
            {
                <!-- Simple Menu Selection -->
                <div>
                    <label for="menuSelect" class="block text-sm font-medium text-gray-700 mb-2">@T["Edit_SelectMenu"]</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                            </svg>
                        </div>
                        <InputSelect @bind-Value="Item.MenuId" id="menuSelect" disabled="@readOnly"
                                     class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors duration-200">
                            <option value="">@T["Edit_SelectMenuEmpty"]</option>
                            @foreach (var m in menus)
                            {
                                <option value="@m.Id">@m.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <ValidationMessage For="@(() => Item.MenuId)" class="mt-1 text-sm text-red-600" />
                    <p class="mt-1 text-xs text-gray-500">@T["Edit_SelectMenuHint"]</p>
                </div>
            }
            else if (mode == DisplayMode.Schedule)
            {
                <!-- Schedule-based Menu Configuration -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-4">@T["Edit_Schedule"]</label>
                    <fieldset disabled="@readOnly" class="bg-gray-50 rounded-lg p-2.5 sm:p-6">
                        <QrCodeTimeTableEntries QRCodeId="@Item.Id" TimeTableEntries="@Item.TimeTableEntries" Menus="@menus">
                            <ValidationMessage For="@(() => Item.TimeTableEntries)" class="mt-1 text-sm text-red-600" />
                        </QrCodeTimeTableEntries>
                    </fieldset>
                </div>
            }
            else
            {
                <!-- Calendar-based Menu Configuration -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-4">@T["Edit_Calendar"]</label>
                    <QrCodeCalendarEntries QRCodeId="@Item.Id" CalendarEntries="@Item.CalendarEntries" Menus="@menus" Today="@Today"
                                           FallbackMenuId="@Item.MenuId" FallbackIsSchedule="@Item.IsTimeTableBased" ReadOnly="@readOnly">
                        <ValidationMessage For="@(() => Item.CalendarEntries)" class="text-sm text-red-600" />
                    </QrCodeCalendarEntries>
                    <p class="mt-2 text-xs text-gray-500">@T["Edit_CalendarPrecedence"]</p>
                </div>

                @if (Item.IsTimeTableBased)
                {
                    @* Only possible via the API: calendar plus time schedule. Without a matching entry the schedule applies. *@
                    <div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-lg px-3.5 py-2.5 text-sm" data-testid="calendar-schedule-fallback">
                        @T["Edit_CalendarFollowsSchedule", ScheduleText()] @T["Edit_CalendarSwitchToSchedule", T["Edit_ModeSchedule"]]
                    </div>
                }
                else
                {
                    <div>
                        <label for="fallbackMenuSelect" class="block text-sm font-medium text-gray-700 mb-2">@T["Edit_Fallback"]</label>
                        <InputSelect @bind-Value="Item.MenuId" id="fallbackMenuSelect" disabled="@readOnly"
                                     class="block w-full px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors duration-200">
                            <option value="">@T["Edit_FallbackEmpty"]</option>
                            @foreach (var m in menus)
                            {
                                <option value="@m.Id">@m.Name</option>
                            }
                        </InputSelect>
                        <p class="mt-1 text-xs text-gray-500">@T["Edit_FallbackHint"]</p>
                    </div>
                }
            }

            <!-- QR Code Preview -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-4">@T["Edit_Preview"]</label>
                <div class="bg-gray-50 rounded-lg p-3.5 sm:p-6">
                    <div class="flex flex-col sm:flex-row items-center gap-x-6 gap-y-4">
                        <div class="flex-shrink-0 p-2.5 bg-white rounded-lg shadow-sm">
                            <QrCodePreview QrId="@Item.Id" ThumbnailSize="150" Title="@Item.Title" />
                        </div>
                        <div class="min-w-0 w-full sm:flex-1 max-sm:text-center">
                            <p class="text-sm text-gray-600">@T["Edit_PreviewOpens"]</p>
                            <p class="mt-1 text-sm font-medium text-gray-900 break-all" data-testid="qr-url">@GuestUrl</p>
                            @if (IsNew)
                            {
                                <p class="mt-1 text-xs text-gray-500">@T["Edit_PreviewNotYet"]</p>
                            }
                            <QrCodeShareActions QrId="@Item.Id" Title="@Item.Title" Class="mt-3.5 justify-center sm:justify-start" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-x-4 gap-y-3 pt-6 border-t border-gray-200">
                <button type="button"
                        class="inline-flex items-center justify-center px-6 py-3 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500 transition-colors duration-200"
                        @onclick="Cancel">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    @(readOnly ? C["Back"] : C["Cancel"])
                </button>
                @if (!readOnly)
                {
                <button type="submit"
                        class="inline-flex items-center justify-center px-6 py-3 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-brand-600 hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500 transition-colors duration-200">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    @(IsNew ? T["Edit_Create"] : T["Edit_SaveChanges"])
                </button>
                }
            </div>
        </EditForm>
        }
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    /// <summary>
    /// What the editor shows. Derived from the QR code's flags on load; changing it sets the flags
    /// (<see cref="OnModeChanged"/>). Entries of the other modes stay stored but inactive.
    /// </summary>
    private enum DisplayMode { Direct, Schedule, Calendar }

    private QRCode Item = new();
    private EditContext? editContext;
    private List<Menu> menus = new();
    private DisplayMode mode;
    private bool readOnly; // an existing code opened without QrCodesEdit but with QrCodesView: shown, never saved
    private bool IsNew => !Id.HasValue;
    private DateOnly Today => DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
    private string GuestUrl => NavManager.BaseUri + QrCodeLinks.GuestPath(Item.Id);
    private string HeadingText => IsNew ? T["Edit_TitleNew"] : readOnly ? T["Edit_TitleView"] : T["Edit_TitleEdit"];

    protected override async Task OnInitializedAsync()
    {
        var requiredPerm = IsNew ? Permission.QrCodesCreate : Permission.QrCodesEdit;
        if (!await PermissionService.HasPermissionAsync(requiredPerm))
        {
            // An existing code can still be viewed with QrCodesView (read-only; no role has that since AP14 — owner and
            // manager may edit); creating needs QrCodesCreate
            if (IsNew || !await PermissionService.HasPermissionAsync(Permission.QrCodesView))
            {
                NavManager.NavigateTo("/qrcodes");
                return;
            }
            readOnly = true;
        }

        // Free tier: creating a QR code is limited (PaidTenant policy), also when the URL is opened directly
        if (IsNew && !await CanCreateQrCodeAsync())
        {
            NavManager.NavigateTo("/qrcodes");
            return;
        }

        menus = await DbContext.Menus.OrderBy(m => m.Name).ToListAsync();

        if (IsNew)
        {
            // The id is fixed right away, so the preview (and a PNG downloaded before saving) matches the saved code
            Item.Id = Guid.NewGuid();
        }
        else
        {
            var existing = await DbContext.QRCodes
                .Include(e => e.TimeTableEntries)
                .Include(e => e.CalendarEntries)
                .SingleOrDefaultAsync(e => e.Id == Id.Value);
            if (existing != null)
                Item = existing;
        }

        Item.TimeTableEntries = (Item.TimeTableEntries ?? new())
            .OrderBy(e => e.StartTime)
            .ToList();
        Item.CalendarEntries = (Item.CalendarEntries ?? new())
            .OrderBy(e => e.Date)
            .ThenBy(e => e.RecurringDayOfWeek.HasValue)
            .ToList();

        // Calendar wins over the schedule, as in MenuService
        mode = Item.IsCalendarBased ? DisplayMode.Calendar
            : Item.IsTimeTableBased ? DisplayMode.Schedule
            : DisplayMode.Direct;

        editContext = new EditContext(Item);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("import", "./js/qr-codes.js"); // "Copy link"
    }

    private void OnModeChanged(DisplayMode value)
    {
        if (readOnly)
            return;
        mode = value;
        Item.IsTimeTableBased = value == DisplayMode.Schedule;
        Item.IsCalendarBased = value == DisplayMode.Calendar;
    }

    private string MenuName(Guid menuId) => menus.FirstOrDefault(m => m.Id == menuId)?.Name ?? T["NoMenu"];

    private string ScheduleText() =>
        string.Join(" · ", (Item.TimeTableEntries ?? new()).Select(e => $"{e.StartTime:HH\\:mm}–{e.EndTime:HH\\:mm} {MenuName(e.MenuId)}"));

    private async Task<bool> CanCreateQrCodeAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        return (await AuthorizationService.AuthorizeAsync(user, PolicyNames.PaidTenant)).Succeeded;
    }

    private async Task HandleValidSubmit()
    {
        if (readOnly)
            return;

        // Check again on save: the limit may have been reached meanwhile (e.g. in another tab)
        if (IsNew && !await CanCreateQrCodeAsync())
        {
            NavManager.NavigateTo("/qrcodes");
            return;
        }

        if (IsNew)
        {
            Item.CreatedAt = DateTime.UtcNow;
            DbContext.QRCodes.Add(Item);
        }
        else
        {
            // Entries removed in the editor are no longer in the collections and are deleted as orphans
            DbContext.QRCodes.Update(Item);
        }

        await DbContext.SaveChangesAsync();
        // "Erster QR-Code" (AP16) when the tenant has exactly this one QR code now
        if (IsNew)
            await Events.QrCodeCreatedAsync(DbContext);
        NavManager.NavigateTo("/qrcodes");
    }

    private void Cancel() => NavManager.NavigateTo("/qrcodes");
}
