@using System.Globalization
@using SpeiseDirekt.Model
@using Microsoft.AspNetCore.Components.Forms

@* Calendar entries of a calendar-based QR code: a menu on a single date, over a date range or weekly on
   one weekday. Rendered inside the editor's EditForm; the parent saves the collection with the QR code. *@
<div class="space-y-3">
    @if (CalendarEntries.Count == 0)
    {
        <p class="text-sm text-gray-500">No calendar entries yet. Add one for a holiday, a festival week or a weekly special.</p>
    }
    @{ var index = 0; }
    @foreach (var entry in CalendarEntries)
    {
        var i = index++;
        <div @key="entry" class="bg-white rounded-lg border border-gray-200 p-3.5" data-testid="calendar-entry">
            <div class="flex items-start justify-between gap-x-3 mb-2.5">
                <p class="text-sm font-medium text-gray-800 min-w-0" data-testid="calendar-entry-summary">@Describe(entry)</p>
                <button type="button"
                        class="flex-shrink-0 inline-flex items-center px-2.5 py-1 text-sm font-medium text-red-700 bg-white border border-red-200 hover:bg-red-50 rounded-lg transition-colors duration-200"
                        @onclick="() => RemoveEntry(entry)">
                    Remove
                </button>
            </div>
            <div class="grid grid-cols-2 xl:grid-cols-4 gap-x-3 gap-y-3">
                <div class="col-span-2 sm:col-span-1">
                    <label for="@($"cal-{i}-menu")" class="block text-xs font-medium text-gray-600 mb-1">Menu</label>
                    <InputSelect @bind-Value="entry.MenuId" id="@($"cal-{i}-menu")" class="@FieldClass">
                        <option value="@Guid.Empty">-- Select Menu --</option>
                        @foreach (var m in Menus)
                        {
                            <option value="@m.Id">@m.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-span-2 sm:col-span-1">
                    <label for="@($"cal-{i}-weekly")" class="block text-xs font-medium text-gray-600 mb-1">Repeats weekly on</label>
                    <InputSelect @bind-Value="entry.RecurringDayOfWeek" id="@($"cal-{i}-weekly")" class="@FieldClass">
                        <option value="">Does not repeat</option>
                        @foreach (var day in Weekdays)
                        {
                            <option value="@day">@day</option>
                        }
                    </InputSelect>
                </div>
                <div>
                    <label for="@($"cal-{i}-date")" class="block text-xs font-medium text-gray-600 mb-1">Date</label>
                    <InputDate @bind-Value="entry.Date" id="@($"cal-{i}-date")" class="@FieldClass" />
                </div>
                <div>
                    <label for="@($"cal-{i}-until")" class="block text-xs font-medium text-gray-600 mb-1">Until (optional)</label>
                    <InputDate @bind-Value="entry.EndDate" id="@($"cal-{i}-until")" class="@FieldClass" />
                </div>
            </div>
        </div>
    }
    @ChildContent
    <button type="button"
            class="inline-flex items-center px-3.5 py-2 border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg transition-colors duration-200"
            @onclick="AddEntry">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        Add Calendar Entry
    </button>
</div>

@code {
    [Parameter, EditorRequired] public Guid QRCodeId { get; set; }
    [Parameter, EditorRequired] public List<CalendarEntry> CalendarEntries { get; set; } = new();
    [Parameter, EditorRequired] public List<Menu> Menus { get; set; } = new();

    /// <summary>Local date used as the default for new entries (from the app's TimeProvider).</summary>
    [Parameter] public DateOnly Today { get; set; } = DateOnly.FromDateTime(DateTime.Today);

    /// <summary>Validation messages, rendered below the entries.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private const string FieldClass =
        "block w-full px-2.5 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500";

    private static readonly DayOfWeek[] Weekdays =
    {
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday,
        DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday
    };

    private static readonly CultureInfo English = CultureInfo.GetCultureInfo("en-US");

    private void AddEntry() =>
        CalendarEntries.Add(new CalendarEntry { Date = Today, MenuId = Guid.Empty, QRCodeId = QRCodeId });

    private void RemoveEntry(CalendarEntry entry) => CalendarEntries.Remove(entry);

    private static string Format(DateOnly date) => date.ToString("ddd, MMM d, yyyy", English);

    /// <summary>The entry in words, e.g. "Every Friday from Fri, Nov 6, 2026 until Thu, Dec 31, 2026".</summary>
    public static string Describe(CalendarEntry entry)
    {
        if (entry.EndDate is { } until && until < entry.Date)
            return "\"Until\" is before the date";

        if (entry.RecurringDayOfWeek is { } day)
            return entry.EndDate is { } end
                ? $"Every {day} from {Format(entry.Date)} until {Format(end)}"
                : $"Every {day} from {Format(entry.Date)}";

        return entry.EndDate is { } last && last != entry.Date
            ? $"Every day from {Format(entry.Date)} to {Format(last)}"
            : $"Only on {Format(entry.Date)}";
    }
}
