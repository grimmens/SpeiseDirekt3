@inject NavigationManager NavManager


<div class="qr-preview">
    @if (QrId != Guid.Empty)
    {
        <button type="button"
                class="block p-0 border-0 bg-transparent"
                title="Click to enlarge"
                data-bs-toggle="modal"
                data-bs-target="#@ModalId">
            <img src="@_imageUrl"
                 alt="@(string.IsNullOrEmpty(Title) ? "QR Code" : $"QR code {Title}")"
                 width="@ThumbnailSize"
                 height="@ThumbnailSize"
                 style="cursor:pointer;" />
        </button>
    }
    else
    {
        <p class="text-muted">Loading QR…</p>
    }
</div>

<div class="modal fade" id="@ModalId" tabindex="-1" aria-labelledby="@($"{ModalId}Label")" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="@($"{ModalId}Label")">@(string.IsNullOrEmpty(Title) ? "QR Code Preview" : Title)</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img src="@_imageUrl"
                     alt="QR Code Large"
                     loading="lazy"
                     class="img-fluid" />
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// The QRCode record's Id.  Used to build the redirect URL: /qr/{QrId}.
    /// </summary>
    [Parameter, EditorRequired] public Guid QrId { get; set; }

    /// <summary>
    /// The HTML id for the modal.  Defaults to a random GUID-based id.
    /// </summary>
    public string ModalId { get; set; } = $"qrModal_{Guid.NewGuid():N}";

    /// <summary>
    /// Width in pixels for the thumbnail image.
    /// </summary>
    [Parameter] public int ThumbnailSize { get; set; } = 80;

    /// <summary>QR code title for the alt text and the enlarged view's heading (optional).</summary>
    [Parameter] public string? Title { get; set; }

    private string _imageUrl => $"{NavManager.BaseUri}Image/qr/{QrId}";
}
