@inject NavigationManager NavManager
@inject IStringLocalizer<QrCodesText> T
@inject IStringLocalizer<CommonText> C
@* A QR code thumbnail; a click opens it enlarged in a quiet native <dialog> (css/back-office.css .sd-dialog). Opening and
   closing are plain JS (js/shell.js, [data-sd-dialog-open] / [data-sd-dialog]): Escape, the backdrop and the close button
   close it, the focus returns to the thumbnail. No Blazor state, no Bootstrap modal. *@

<div class="qr-preview">
    @if (QrId != Guid.Empty)
    {
        <button type="button"
                class="block p-0 border-0 bg-transparent cursor-zoom-in rounded-lg"
                title="@T["Preview_Enlarge"]"
                aria-haspopup="dialog"
                aria-controls="@ModalId"
                data-sd-dialog-open
                data-testid="qr-preview-button">
            <img src="@_imageUrl"
                 alt="@(string.IsNullOrEmpty(Title) ? T["Preview_AltUntitled"] : T["Preview_Alt", Title])"
                 width="@ThumbnailSize"
                 height="@ThumbnailSize"
                 class="@ImageClass" />
        </button>
    }
    else
    {
        <p class="text-muted">@T["Preview_Loading"]</p>
    }
</div>

<dialog class="sd-dialog" id="@ModalId" aria-labelledby="@($"{ModalId}Label")" data-sd-dialog data-testid="qr-preview-dialog">
    <div class="sd-dialog-head">
        <h2 class="sd-dialog-title" id="@($"{ModalId}Label")">@(string.IsNullOrEmpty(Title) ? T["Preview_Title"] : Title)</h2>
        <button type="button" class="sd-row-action sd-dialog-close" aria-label="@C["Close"]" data-sd-dialog-close>
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>
    <div class="sd-dialog-body text-center">
        <img src="@_imageUrl" alt="@T["Preview_LargeAlt"]" width="320" height="320" loading="lazy" class="mx-auto block h-auto w-full max-w-xs" />
    </div>
</dialog>

@code {
    /// <summary>
    /// The QRCode record's Id.  Used to build the redirect URL: /qr/{QrId}.
    /// </summary>
    [Parameter, EditorRequired] public Guid QrId { get; set; }

    /// <summary>
    /// The HTML id of the dialog.  Defaults to a random GUID-based id.
    /// </summary>
    public string ModalId { get; set; } = $"qrModal_{Guid.NewGuid():N}";

    /// <summary>
    /// Width in pixels for the thumbnail image.
    /// </summary>
    [Parameter] public int ThumbnailSize { get; set; } = 80;

    /// <summary>QR code title for the alt text and the enlarged view's heading (optional).</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>CSS classes for the thumbnail, e.g. responsive sizes (override <see cref="ThumbnailSize"/>).</summary>
    [Parameter] public string? ImageClass { get; set; }

    private string _imageUrl => $"{NavManager.BaseUri}Image/qr/{QrId}";
}
