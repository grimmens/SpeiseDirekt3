@page "/qr/{QrId:guid}"
@* Target of every QR code (anonymous): resolves the active menu (IMenuService) and shows it as the static SSR
   guest menu. Records one MenuView per page request; a request with ?item= (an item opened without JS) records
   the item click instead. *@
@attribute [ExcludeFromInteractiveRouting]
@attribute [GuestPage]
@layout GuestLayout
@using Microsoft.EntityFrameworkCore
@using SpeiseDirekt.ServiceInterface
@inject ApplicationDbContext Db
@inject IMenuService MenuService
@inject ITrackingService Tracking

@if (!qrExists)
{
    <GuestNotice Kind="GuestNotice.GuestNoticeKind.NotFound" Title="Ungültiger QR-Code"
                 Message="Dieser QR-Code existiert nicht oder wurde gelöscht." ShowHomeLink="true" />
}
else if (model is not null)
{
    <GuestMenuView Model="model" />
}
else
{
    @* The QR code exists, but no menu is active right now (e.g. outside every time-table window) *@
    <GuestNotice Kind="GuestNotice.GuestNoticeKind.Info" Title="Gerade ist kein Menü verfügbar"
                 Message="Zu dieser Uhrzeit ist für diesen QR-Code kein Menü hinterlegt. Bitte versuchen Sie es später noch einmal." />
}

@code {
    [Parameter] public Guid QrId { get; set; }
    /// <summary>?item=&lt;id&gt;: render that item's sheet open (deep link, card click without JS).</summary>
    [SupplyParameterFromQuery(Name = "item")] public string? Item { get; set; }

    private bool qrExists;
    private GuestMenuModel? model;

    protected override async Task OnInitializedAsync()
    {
        qrExists = await Db.QRCodes.IgnoreQueryFilters().AnyAsync(q => q.Id == QrId);
        if (!qrExists)
            return;

        var menu = await MenuService.GetMenuForQRCodeAsync(QrId);
        if (menu is null)
            return;

        model = await GuestMenuLoader.BuildAsync(Db, menu, $"/qr/{QrId}", Item);

        var sessionId = Tracking.GetOrCreateSessionId();
        if (model.SelectedItem is { } item)
            await Tracking.RecordMenuItemClickAsync(sessionId, item.Id, menu.Id);
        else
            await Tracking.RecordMenuViewAsync(sessionId, menu.Id, QrId);
    }
}
